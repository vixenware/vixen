// cargo.vix — step one of "reimplement cargo in vix": read a real Cargo.toml
// AND its Cargo.lock, discover the crate's targets the way cargo does, order
// the locked packages into a build sequence, and plan the rustc invocation each
// one needs.
//
// Run it: `vx cargo-vix/cargo.vix`, or let the suite do it —
// `vixen-runtime/tests/cargo_vix.rs` runs THIS file and asserts all 29 checks,
// so an edit here that breaks decode or the walk fails the build.
//
// The lock is the load-bearing input, not the manifest: the 0.1 north star is
// "an existing Cargo.lock → a built binary", so nothing here resolves a version
// or visits an index. The manifest names the root package and its targets; the
// lock supplies the resolved graph, and its `checksum` is the sha256 that pins
// every fetch.
//
// WHAT IS AND IS NOT HERE. Everything up to and including the argv plan is real
// and runs; the invocations are still PLANS, asserted as data. The bound that
// used to stop them being run is gone — an origin-backed tree mounts now
// (`exec_tree_mounts.rs` compiles `trees/small-crate` with real rustc off the
// fixture root) — so what remains is artifact LAYOUT: every unit here plans
// `--out-dir .` and derives its rlib name from the package name alone, which
// two versions of one name collide in. See cargo-vix/README.md.

// ---------------------------------------------------------------- the manifest

struct CargoPackage {
    name: String,
    version: String,
    edition: Option<String>,
}

struct CargoManifest {
    package: CargoPackage,
}

// A crate name is the package name with dashes turned into underscores — the
// rule rustc enforces and cargo applies silently.
fn crate_ident(name: String) -> String {
    name.replace("-", "_")
}

// Cargo's own default: a manifest with no `edition` key is a 2015 crate.
fn edition(package: CargoPackage) -> String {
    package.edition.unwrap_or("2015")
}

fn manifest(source: Tree) -> CargoManifest {
    toml_decode((source / "Cargo.toml").text())
}

// -------------------------------------------------------------------- the lock

struct LockPackage {
    name: String,
    version: String,
    source: Option<String>,
    checksum: Option<String>,
    dependencies: Option<[String]>,
}

struct Lockfile {
    version: Int,
    package: [LockPackage],
}

fn lockfile(source: Tree) -> Lockfile {
    toml_decode((source / "Cargo.lock").text())
}

fn dependencies_of(pkg: LockPackage) -> [String] {
    let none: [String] = [];
    pkg.dependencies.unwrap_or(none)
}

// A package with a `source` came from a registry and must be fetched; one
// without is the local crate the lock was generated for. The checksum is the
// fetch pin, and its absence on a local package is the same fact stated twice.
fn is_vendored(pkg: LockPackage) -> Bool {
    pkg.source.is_some()
}

// The self-describing pin `fetch` wants. Cargo.lock records the SHA-256 of the
// published .crate, which `machine.primitive.fetch-is-pinned` admits as a pin
// (the 2026-07-26 amendment) precisely so 0.1 needs no second lockfile.
fn fetch_pin(pkg: LockPackage) -> Option<String> {
    match pkg.checksum {
        Some(digest) => Some("sha256:" + digest),
        None => None,
    }
}

// --------------------------------------------------------------- the build order

// A package's identity in the lock. The NAME ALONE IS NOT ONE: a real lock may
// hold one name at two versions, and cargo then writes that package's
// `dependencies` entries as `"name version"` rather than bare `"name"`. A walk
// keyed on the name collapses the duplicates in its done-set AND stops matching
// the disambiguated entries, so nothing ever becomes ready and the walk returns
// a short order — indistinguishable from a genuine cycle.
struct PackageId {
    name: String,
    version: String,
}

fn package_id(pkg: LockPackage) -> PackageId {
    PackageId { name: pkg.name, version: pkg.version }
}

// A bare dependency entry naming zero packages, or several. Cargo writes the
// bare form ONLY when the name is unique in the lock, so either count is a
// malformed lock. It fails rather than yielding an id that matches nothing,
// because an unmatchable id would truncate the walk and put us straight back to
// a short order that reads as a cycle.
struct UnresolvableDependency {
    entry: String,
    matches: Int,
}

// Resolve one `dependencies` entry to the package it names. The disambiguated
// form is parsed — the space is cargo's own separator and a semver carries none,
// so the FIRST space splits it — and the bare form is RESOLVED AGAINST THE LOCK
// rather than parsed, because "the name is unique here" is exactly what writing
// it bare asserts.
//
// Two fields, never three: lock v1/v2 wrote a third `"(source)"` component, and
// v3 dropped it. Nothing here reads those older locks anyway — a v1 lock has no
// top-level `version` key at all, so `Lockfile` refuses it before this runs.
fn dependency_id(entry: String) where { packages: [LockPackage] } -> PackageId {
    if entry.contains(" ") {
        let (name, version) = entry.split_once(" ");
        PackageId { name: name, version: version }
    } else {
        let none: [PackageId] = [];
        let named = packages.fold(none, |acc, pkg| if pkg.name == entry {
            acc + package_id(pkg)
        } else {
            acc
        });
        if named.len() == 1 {
            named[0]
        } else {
            fail UnresolvableDependency { entry: entry, matches: named.len() }
        }
    }
}

fn dependency_ids(pkg: LockPackage) where { packages: [LockPackage] } -> [PackageId] {
    dependencies_of(pkg).map(|dep| dependency_id(dep) where { packages: packages })
}

// One package with its dependency entries already resolved to identities.
// Resolution is a whole-lock question — a bare entry is answered by scanning the
// packages — and the walk asks it once per package here rather than once per
// package PER ROUND.
struct LockNode {
    id: PackageId,
    deps: [PackageId],
}

fn lock_graph(packages: [LockPackage]) -> [LockNode] {
    packages.map(|pkg| LockNode {
        id: package_id(pkg),
        deps: dependency_ids(pkg) where { packages: packages }
    })
}

// The packages whose dependencies are all already ordered, and which are not
// ordered themselves. One Kahn round.
fn ready_after(nodes: [LockNode]) where { done: [PackageId] } -> [PackageId] {
    let none: [PackageId] = [];
    nodes.fold(none, |ready, node| if done.contains(node.id) {
        ready
    } else {
        if node.deps.all(|dep| done.contains(dep)) {
            ready + node.id
        } else {
            ready
        }
    })
}

// Rounds until nothing new becomes ready. A round that adds nothing terminates
// the walk, so a SHORT order comes back rather than a loop, and the caller sees
// the truncation by comparing lengths.
//
// With the walk keyed on `PackageId`, a short order now has ONE cause — a
// genuine cycle. The other one, duplicate package names, is gone; a malformed
// lock fails loudly in `dependency_id` instead of quietly shortening the order.
fn order_after(done: [PackageId]) where { nodes: [LockNode] } -> [PackageId] {
    let ready = ready_after(nodes) where { done: done };
    if ready.len() == 0 {
        done
    } else {
        order_after(done ++ ready) where { nodes: nodes }
    }
}

fn build_order(packages: [LockPackage]) -> [PackageId] {
    let none: [PackageId] = [];
    order_after(none) where { nodes: lock_graph(packages) }
}

// ------------------------------------------------------------------ the targets

enum TargetKind {
    Lib,
    Bin,
}

struct Unit {
    name: String,
    kind: TargetKind,
    root: Path,
    edition: String,
}

// Cargo's default target discovery, faithfully: `src/lib.rs` is the library and
// is named after the package; `src/main.rs` is a binary, also named after the
// package. (Cargo also auto-discovers `src/bin/*.rs`; that is a second glob and
// waits for the multi-binary case to be worth its test.)
fn units(source: Tree) -> [Unit] {
    let package = manifest(source).package;
    let none: [Unit] = [];
    let roots = source.glob("src/*.rs").collect().values().sorted();
    roots.fold(none, |found, root| match unit_for(root) where { package: package } {
        Some(unit) => found + unit,
        None => found,
    })
}

fn unit_for(root: Path) where { package: CargoPackage } -> Option<Unit> {
    let leaf = root.file_name().unwrap_or("");
    if leaf == "lib.rs" {
        Some(Unit {
            name: crate_ident(package.name),
            kind: TargetKind::Lib,
            root: root,
            edition: edition(package),
        })
    } else {
        if leaf == "main.rs" {
            Some(Unit {
                name: crate_ident(package.name),
                kind: TargetKind::Bin,
                root: root,
                edition: edition(package),
            })
        } else {
            None
        }
    }
}

fn crate_type_flag(kind: TargetKind) -> String {
    match kind {
        TargetKind::Lib => "lib",
        TargetKind::Bin => "bin",
    }
}

// ------------------------------------------------------------------- the argv

fn rlib_name(name: String) -> String {
    "lib" + crate_ident(name) + ".rlib"
}

// One `--extern name=libname.rlib` pair per dependency, in lock order. Two argv
// elements each, the way cargo spells it.
//
// KNOWN AND BOUNDED: the rlib name is derived from the package NAME, so a lock
// holding one name at two versions plans the same `--extern` twice. Cargo
// disambiguates with a `-C metadata` hash in the filename, which is an artifact
// LAYOUT decision this file does not make yet — there is no out-dir scheme here
// at all (`--out-dir .`). Naming it here rather than inventing a scheme: the
// identity to key it on now exists (`PackageId`), so this is a naming question,
// not a graph one.
fn extern_argv(deps: [PackageId]) -> [String] {
    let none: [String] = [];
    deps.fold(none, |argv, dep| argv + "--extern" + (crate_ident(dep.name) + "=" + rlib_name(dep.name)))
}

// The argv rustc wants for one unit. This is the value that would be handed
// straight to `exec rustc`; it is rendered as data instead so the plan can be
// asserted without the process existing.
fn rustc_argv(unit: Unit) where { deps: [PackageId] } -> [String] {
    ["--crate-name", unit.name]
        + "--edition"
        + unit.edition
        + "--crate-type"
        + crate_type_flag(unit.kind)
        + unit.root.to_string()
        + "--out-dir"
        + "."
        ++ extern_argv(deps)
}

// --------------------------------------------------------------------- checks

#[test]
fn reads_the_manifest() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let package = manifest(source).package;

    yield expect_eq(package.name, "small-crate");
    yield expect_eq(package.version, "0.1.0");
    yield expect_eq(edition(package), "2021");
    // The dash is not legal in a crate name; cargo rewrites it and so do we.
    yield expect_eq(crate_ident(package.name), "small_crate");
}

#[test]
fn reads_the_lock() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let lock = lockfile(source);

    yield expect_eq(lock.version, 4);
    yield expect_eq(lock.package.len(), 3);
    // `[[package]]` is an array-of-tables: one array written across three
    // headers, in document order.
    yield expect_eq(lock.package[0].name, "libc");
    yield expect_eq(lock.package[2].name, "small-crate");
    // The root package is the one with no registry source and no checksum.
    yield expect(is_vendored(lock.package[0]));
    yield expect(!is_vendored(lock.package[2]));
    yield expect_eq(dependencies_of(lock.package[2]), ["libc", "log"]);
    yield expect_eq(dependencies_of(lock.package[0]).len(), 0);
}

#[test]
fn the_checksum_is_the_fetch_pin() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let lock = lockfile(source);
    let none: Option<String> = None;

    yield expect_eq(
        fetch_pin(lock.package[0]),
        Some("sha256:97b3888a4aecf77e811145cadf6eef5901f4782c53886191b2f693f24761847c")
    );
    // The local package is not fetched, so it carries no pin.
    yield expect_eq(fetch_pin(lock.package[2]), none);
}

#[test]
fn orders_the_locked_packages() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let lock = lockfile(source);
    let order = build_order(lock.package);

    // Every package is ordered — a short order would mean a cycle.
    yield expect_eq(order.len(), lock.package.len());
    // Dependencies before the dependent that names them.
    yield expect_eq(order, [
        PackageId { name: "libc", version: "0.2.155" },
        PackageId { name: "log", version: "0.4.22" },
        PackageId { name: "small-crate", version: "0.1.0" }
    ]);
    // This lock has no duplicated name, so cargo wrote every dependency bare —
    // and the bare form still resolves.
    yield expect_eq(
        dependency_ids(lock.package[2]) where { packages: lock.package },
        [
            PackageId { name: "libc", version: "0.2.155" },
            PackageId { name: "log", version: "0.4.22" }
        ]
    );
}

// The case the name-keyed walk could not do: one name at two versions. Cargo
// then writes the root's dependencies as `"bitflags 1.3.2"` / `"bitflags
// 2.13.1"`, which is the whole reason the identity carries a version.
#[test]
fn orders_a_lock_holding_one_name_at_two_versions() -> Stream<Check> {
    let source = fixture_tree("dup-name-crate");
    let lock = lockfile(source);
    let order = build_order(lock.package);

    // Load-bearing: keyed on the name this came back with two of three, and the
    // truncation was indistinguishable from a cycle.
    yield expect_eq(order.len(), lock.package.len());
    yield expect_eq(order, [
        PackageId { name: "bitflags", version: "1.3.2" },
        PackageId { name: "bitflags", version: "2.13.1" },
        PackageId { name: "dup-name-crate", version: "0.1.0" }
    ]);
    // The disambiguated spelling is what the entries actually are.
    yield expect_eq(dependencies_of(lock.package[2]), ["bitflags 1.3.2", "bitflags 2.13.1"]);
}

// The refusal, pinned in the file that declares it. `trees/ambiguous-lock` is
// the dup-name lock with its bare dependency entry put back, so `"bitflags"`
// names two packages and nothing chooses between them. The old shape of this
// bug is why it matters: an unmatchable id truncates the Kahn walk, and a short
// order is indistinguishable from a cycle — the failure has to be loud HERE, at
// the entry that cannot be resolved, or it arrives later wearing a lie.
//
// The payload TYPE is what the check names. A machine failure — a missing
// fixture, a lock that is not UTF-8 — carries no authored payload and can never
// satisfy this, so the check cannot go green on a broken fixture.
#[test]
fn a_bare_entry_naming_two_packages_is_refused() -> Stream<Check> {
    let source = fixture_tree("ambiguous-lock");
    let lock = lockfile(source);

    yield expect_fail(build_order(lock.package), UnresolvableDependency);
}

#[test]
fn discovers_the_default_targets() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let found = units(source);

    yield expect_eq(found.len(), 2);
    // Sorted by path, so the library sorts before the binary.
    yield expect_eq(found[0].root.to_string(), "src/lib.rs");
    yield expect_eq(found[0].kind, TargetKind::Lib);
    yield expect_eq(found[1].root.to_string(), "src/main.rs");
    yield expect_eq(found[1].kind, TargetKind::Bin);
    yield expect_eq(found[0].name, "small_crate");
}

#[test]
fn plans_the_rustc_invocations() -> Stream<Check> {
    let source = fixture_tree("small-crate");
    let lock = lockfile(source);
    let found = units(source);
    let deps = dependency_ids(lock.package[2]) where { packages: lock.package };
    let none: [PackageId] = [];

    // A dependency compiles with no externs of its own.
    yield expect_eq(
        (rustc_argv(found[0]) where { deps: none }).join(" "),
        "--crate-name small_crate --edition 2021 --crate-type lib src/lib.rs --out-dir ."
    );
    // The root binary links every locked dependency by rlib name.
    yield expect_eq(
        (rustc_argv(found[1]) where { deps: deps }).join(" "),
        "--crate-name small_crate --edition 2021 --crate-type bin src/main.rs --out-dir . --extern libc=liblibc.rlib --extern log=liblog.rlib"
    );
}
