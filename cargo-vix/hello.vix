// Rung one: compile a hello world and run the binary it produces.
//
// RUNNING IT. This needs a `Rustc` capability, and the default machine manifest
// offers only Echo/Sh/ProgressiveSh — so plain `vx cargo-vix/hello.vix` refuses
// before anything runs (loudly, naming the type it wanted). Declare a machine
// that has one:
//
//   cat > /tmp/machine.toml <<EOF
//   host = "x86_64-unknown-linux-gnu"
//   [[capability]]
//   ty = "Sh"
//   program = "sh"
//   [[capability]]
//   ty = "Rustc"
//   program = "$(rustup which rustc)"
//   toolchain = "$(rustc --version | cut -d' ' -f2)"
//   targets = ["x86_64-unknown-linux-gnu"]
//   EOF
//   VIX_MACHINE_MANIFEST=/tmp/machine.toml vx cargo-vix/hello.vix
//
// The `toolchain` line is what the `where { toolchain_range: … }` pin below is held
// against. Asking `rustc --version` HERE is fine — the answer is being written
// into a statement, once, by a human running a command. The build never asks;
// it compares the program's demand against what the machine already said, and
// refuses on a mismatch. That is attribution, not verification: the strongest
// honest claim is "we asked for this, the machine said that, they agree".
// Delete the line and this file refuses — a machine that states no toolchain
// has nothing to attribute the pin against.
//
// The test `vixen-runtime/tests/exec_tree_mounts.rs` runs THIS FILE with such a
// manifest built in Rust, so the example and the proof are the same source.
//
// The source is written by a shell exec so this file stands alone — it needs no
// fixture root to exist. Mounting an ORIGIN-backed tree (a `fixture_tree`, a
// workspace read off disk) works too now that the effect authority has a
// directory verb; see `an_origin_backed_mount_compiles_through_rustc` in
// `vixen-runtime/tests/exec_tree_mounts.rs` for that shape. The braces are octal
// escapes (\173 \175) because an exec template reads a literal `{` as an
// interpolation.
//
// `--edition 2021` is the demand on the toolchain that the argv cannot express:
// a rustc older than 1.56 does not know the edition, and would fail deep in the
// compile rather than at binding. The pin says it out loud instead.
//
// On a NIGHTLY the manifest above states something like `1.99.0-nightly`, and
// this pin refuses it — Cargo's prerelease rule, kept on purpose: a nightly is
// a different tool from the stable release whose number it carries. Say you
// mean it (`toolchain_range: ">=1.99.0-nightly"`) or drop the pin.
//
// Two spellings, because they ask different questions. `toolchain_range` asks
// an ORDERING question and needs both sides to be numbers. `toolchain` asks for
// one exact string and parses nothing — which is the only honest question about
// a tool like Quartus, whose version is `22.1std`.
//
// Note `toolchain` compares TEXT: `toolchain: "1.56"` would NOT match a machine
// stating `1.56.0`. To mean one exact version that has an ordering, write
// `toolchain_range: "=1.56"`.
#[test { budget_wall: 120s, budget_rss: 4096MB }]
fn hello_world(sh: Sh, rustc: Rustc where { toolchain_range: ">=1.56, <2" }) -> Stream<Check> {
    let sources = exec sh`-c "mkdir -p src; printf 'fn main() \173 println!(\042hello from vix\042); \175\n' > src/main.rs"`;

    // A template splices BARE NAMES, so each tree is bound before it is used.
    let src = sources.tree;
    let built = exec rustc`--crate-name hello --edition 2021 {src}/src/main.rs --out-dir .`;

    let out = built.tree;
    let ran = exec sh`-c "{out}/hello"`;
    yield expect_eq(ran.stdout.text().trim(), "hello from vix");
}
