# Use a separate VX_HOME for testing to avoid polluting ~/.vx
# This prevents accidentally nuking the CAS with downloaded registry crates
export VX_HOME=/tmp/.vx-for-tests

# Sparkle Ed25519 public key for macOS app auto-updates
export VX_MAC_SPARKLE_PUBLIC_ED_KEY="R79dwpKxRuDjsYB9JzoQ1BGlh2pyZWtaxpKLvC33dw8="
