main <<VX,vx
fn build() {
  11
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }
}

runs (
  {
    expect {
      result @u64"11"
    }
  }

  {
    invoke {
      slot {
        id "mixed-slot"
        domain @pure{
          witness @string"w1"
          value @u64"41"
        }
        action @current
      }
    }

    expect {
      result @u64"41"
    }
  }

  {
    invoke {
      slot {
        id "mixed-slot"
        domain @pure{
          witness @string"w1"
          value @u64"999"
        }
        action @current
      }
    }

    expect {
      result @u64"41"
    }
  }

  {
    invoke {
      slot {
        id "mixed-slot"
        domain @pure{
          witness @string"w1"
          value @u64"43"
        }
        action @refresh{
          intent @string"rpc_refresh"
        }
      }
    }

    expect {
      result @u64"43"
    }
  }

  {
    invoke {
      slot {
        id "mixed-slot"
        domain @pure{
          witness @string"w1"
          value @u64"999"
        }
        action @current
      }
    }

    expect {
      result @u64"43"
    }
  }

  {
    expect {
      result @u64"11"
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
