main <<VX,vx
fn resolve_constraints(ctx) {
  ctx.joined
}

fn build() {
  let first = [keyed("logger", ["1.0.0"], resolve_constraints)];
  let second = keyed("logger", ["1.1.0"], resolve_constraints);
  [first, second]
}
VX

invoke {
  entry build
}

expect {
  result @array(
    @array(
      @array(
        @string"1.0.0"
        @string"1.1.0"
      )
    )
    @array(
      @string"1.0.0"
      @string"1.1.0"
    )
  )

  engines {
    eval1 @skip
    eval2 @pass
  }
}
