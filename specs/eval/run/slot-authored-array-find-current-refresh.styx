main <<VX,vx
struct Candidate {
  version: String,
  default: Bool,
}

fn registry_packages() {
  %{
    "logger" => [
      Candidate {
        version: "1.0.0",
        default: true,
      },
    ],
    "codec" => [
      Candidate {
        version: "1.0.0",
        default: true,
      },
      Candidate {
        version: "1.1.0",
        default: false,
      },
    ],
  }
}

fn default_version(candidates) {
  array_find(candidates, ((candidate) => candidate.default)).version
}

fn resolve_solution(ctx) {
  let registry = registry_packages();
  if ctx.is_refresh (
    let current = ctx.current;
    let name = ctx.intent.name;
    let current_version = map_get(current, name);
    let next = array_find(
      map_get(registry, name),
      ((candidate) => candidate.version != current_version),
    );
    map_put(current, name, next.version)
  ) else (
    %{
      "logger" => default_version(map_get(registry, "logger")),
      "codec" => default_version(map_get(registry, "codec")),
    }
  )
}

fn build_current() {
  slot_current("authored-array-find-slot", "manifest-v1", resolve_solution)
}

fn build_refresh(name: String) {
  slot_refresh(
    "authored-array-find-slot",
    "manifest-v1",
    UpdatePackage { name: name },
    resolve_solution,
  )
}
VX

invoke {
  entry build_current
}

runs (
  {
    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.0.0"
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-array-find-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec")
    }

    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-find-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
    }

    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_reuse{slot "authored-array-find-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
