main <<VX,vx
fn build() {
  host_which("cl.exe")
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe"}
          )
        }
      }
    }
  }
}

expect {
  result @string"C:/VS/cl.exe"
  provenance @host_probe{
    host win
    description host_which
    source {
      source_id "specs/eval/run/remote-rpc-host-which.styx#main"
      start {
        byte 15
        line 1
        column 2
      }
      end {
        byte 35
        line 1
        column 22
      }
    }
  }
  obligations (
    @which{name "cl.exe", expected_path "C:/VS/cl.exe"}
  )

  engines {
    eval1 @skip
    eval2 @pass
  }
}
