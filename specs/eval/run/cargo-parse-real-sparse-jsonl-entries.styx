main <<VX,vx
struct IndexEntry {
  name: String,
  #[rename = "vers"]
  version: String,
  yanked: Bool,
}

fn parse_sparse_entries(blob: Blob) {
  blob
    .utf8()
    .lines()
    .filter((line) => !line.is_empty())
    .map((line) => Json.parse[IndexEntry](line))
    .to_array()
}

fn build() {
  parse_sparse_entries(read_file("registry_real/flate2-two-entries.jsonl"))
}
VX

invoke {
  entry build
}

expect {
  result @array(
    @struct{
      type IndexEntry
      fields {
        name @string"flate2"
        version @string"1.1.8"
        yanked @bool"false"
      }
    }
    @struct{
      type IndexEntry
      fields {
        name @string"flate2"
        version @string"1.1.9"
        yanked @bool"false"
      }
    }
  )

  engines {
    eval1 @skip
    eval2 @pass
  }
}
