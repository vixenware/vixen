main <<VX,vx
fn build() {
  host_which("cl.exe")
}
VX

invoke {
  entry build

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe", bundle msvc}
          )
        }

        opaque_bundles {
          msvc {
            identity "msvc-14.3"
            files {
              "C:/VS/cl.exe" <<TXT
stub cl
TXT
              "C:/VS/include/vcruntime.h" <<TXT
// runtime 14.3
TXT
            }
          }
        }
      }

      win_changed {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe", bundle msvc}
          )
        }

        opaque_bundles {
          msvc {
            identity "msvc-14.4"
            files {
              "C:/VS/cl.exe" <<TXT
stub cl
TXT
              "C:/VS/include/vcruntime.h" <<TXT
// runtime 14.4
TXT
            }
          }
        }
      }
    }
  }
}

runs (
  {
    invoke {
      place win
    }

    expect {
      result @string"C:/VS/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/cl.exe"
        }
        @bundle{
          name msvc
          identity "msvc-14.3"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
      )
    }
  }

  {
    invoke {
      place win_changed
    }

    expect {
      result @string"C:/VS/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/cl.exe"
        }
        @bundle{
          name msvc
          identity "msvc-14.4"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@verify_claims_fail
        @must_emit/@stabilize_miss
        @must_not_emit/@stabilize_hit
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
