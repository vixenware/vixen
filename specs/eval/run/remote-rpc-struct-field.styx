main <<VX,vx
struct Toolchain {
  cc: String,
}

fn build() {
  let tc = Toolchain {
    cc: "cl.exe",
  };
  tc.cc
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe"}
          )
        }
      }
    }
  }
}

expect {
  result @string"cl.exe"
  provenance @literal{
    path (
      @field"cc"
    )
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
