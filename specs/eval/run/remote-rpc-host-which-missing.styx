main <<VX,vx
fn build() {
  host_which("missing.exe")
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe"}
          )
        }
      }
    }
  }
}

expect {
  poison {
    kind UserFail
    message_contains "host.which could not find missing.exe"
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
