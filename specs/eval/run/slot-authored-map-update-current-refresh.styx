main <<VX,vx
struct Package {
  stable: String,
  latest: String,
}

fn registry_packages() {
  %{
    "logger" => Package {
      stable: "1.0.0",
      latest: "1.0.0",
    },
    "codec" => Package {
      stable: "1.0.0",
      latest: "1.1.0",
    },
  }
}

fn stable_solution(registry) {
  %{
    "logger" => map_get(registry, "logger").stable,
    "codec" => map_get(registry, "codec").stable,
  }
}

fn resolve_solution(ctx) {
  let registry = registry_packages();
  if ctx.is_refresh (
    let current = ctx.current;
    let name = ctx.intent.name;
    let selected = map_get(current, name);
    let latest = map_get(registry, name).latest;
    if selected == latest (
      current
    ) else (
      map_put(current, name, latest)
    )
  ) else (
    stable_solution(registry)
  )
}

fn build_current() {
  slot_current("authored-map-update-slot", "manifest-v1", resolve_solution)
}

fn build_refresh(name: String) {
  slot_refresh(
    "authored-map-update-slot",
    "manifest-v1",
    UpdatePackage { name: name },
    resolve_solution,
  )
}
VX

invoke {
  entry build_current
}

runs (
  {
    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.0.0"
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-map-update-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec")
    }

    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-map-update-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
    }

    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_reuse{slot "authored-map-update-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
