main <<VX,vx
fn build() {
  ((value) => value)
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }
}

expect {
  poison {
    kind TypeError
    message_contains "function values cannot cross the daemon boundary yet"
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
