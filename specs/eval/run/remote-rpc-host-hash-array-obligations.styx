main <<VX,vx
fn build() {
  [host_hash("tool.txt")]
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          hashes (
            {
              path "tool.txt"
              content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          )
        }
      }
    }
  }
}

expect {
  result @array(
    @string"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  )
  obligations (
    @hash{
      path "tool.txt"
      content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  )
  reuse @observed
  crossing @by_value

  engines {
    eval1 @skip
    eval2 @pass
  }
}
