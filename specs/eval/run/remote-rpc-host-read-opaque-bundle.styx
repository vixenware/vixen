main <<VX,vx
fn build() {
  host_read("C:/VS/cl.exe")
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }

        opaque_bundles {
          msvc {
            identity "msvc-14.4"
            files {
              "C:/VS/cl.exe" <<TXT
stub cl
TXT
              "C:/VS/include/vcruntime.h" <<TXT
// stub runtime
TXT
            }
          }
        }
      }
    }
  }
}

expect {
  result @external{
    kind host_file
    descriptor "C:/VS/cl.exe"
  }
  provenance @host_probe{
    host win
    description host_read
  }
  obligations (
    @bundle{
      name msvc
      identity "msvc-14.4"
    }
  )
  reuse @observed
  crossing @by_proxy

  engines {
    eval1 @skip
    eval2 @pass
  }
}
