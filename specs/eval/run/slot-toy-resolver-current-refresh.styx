  runtime {
    package_registry {
      packages {
        serde {
          versions (
            {
              version "1.0.0"
              deps {
                itoa "1.0.0"
              }
            }
          )
        }

        log {
          versions (
            {version "1.0.0"}
          )
        }

        itoa {
          versions (
            {version "1.0.0"}
          )
        }
      }
    }
  }
}

