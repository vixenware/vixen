main <<VX,vx
struct Package {
  stable: String,
  latest: String,
}

struct Selection {
  name: String,
  version: String,
}

fn registry_packages() {
  %{
    "logger" => Package {
      stable: "1.0.0",
      latest: "1.0.0",
    },
    "codec" => Package {
      stable: "1.0.0",
      latest: "1.1.0",
    },
  }
}

fn resolve_selected(ctx) {
  let pkg = map_get(registry_packages(), ctx.witness);
  if ctx.is_refresh (
    if ctx.intent.name == ctx.witness (
      Selection {
        name: ctx.witness,
        version: pkg.latest,
      }
    ) else (
      ctx.current
    )
  ) else (
    Selection {
      name: ctx.witness,
      version: pkg.stable,
    }
  )
}

fn build_current(name: String) {
  slot_current("authored-map-lookup-slot", name, resolve_selected)
}

fn build_refresh(name: String, update: String) {
  slot_refresh(
    "authored-map-lookup-slot",
    name,
    UpdatePackage { name: update },
    resolve_selected,
  )
}
VX

invoke {
  entry build_current
  args (@string"codec")
}

runs (
  {
    expect {
      result @struct{
        type Selection
        fields {
          name @string"codec"
          version @string"1.0.0"
        }
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-map-lookup-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec" @string"logger")
    }

    expect {
      result @struct{
        type Selection
        fields {
          name @string"codec"
          version @string"1.0.0"
        }
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-map-lookup-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"logger"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec" @string"codec")
    }

    expect {
      result @struct{
        type Selection
        fields {
          name @string"codec"
          version @string"1.1.0"
        }
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-map-lookup-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
      args (@string"codec")
    }

    expect {
      result @struct{
        type Selection
        fields {
          name @string"codec"
          version @string"1.1.0"
        }
      }
      events (
        @must_emit/@slot_reuse{slot "authored-map-lookup-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
