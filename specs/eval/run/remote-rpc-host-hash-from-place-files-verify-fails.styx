main <<VX,vx
fn build() {
  host_hash("tool.txt")
}
VX

invoke {
  entry build
  place win
  verify_place win_changed

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }

        files {
          "tool.txt" <<TXT
hash me
TXT
        }
      }

      win_changed {
        host {
          os windows
          arch x86_64
        }

        files {
          "tool.txt" <<TXT
hash me changed
TXT
        }
      }
    }
  }
}

expect {
  poison {
    kind VerificationFailure
    message_contains "host.hash(\"tool.txt\") changed"
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
