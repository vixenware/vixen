main <<VX,vx
fn build() {
  host_os()
}
VX

invoke {
  entry build

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }

      win_same {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }

}

runs (
  {
    invoke {
      place win
    }

    expect {
      result @string"windows"
      obligations (
        @os{value windows}
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
      )
    }
  }

  {
    invoke {
      place win_same
    }

    expect {
      result @string"windows"
      obligations (
        @os{value windows}
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@verify_claims_ok
        @must_emit/@stabilize_hit
        @before{
          first @verify_claims_ok
          then @stabilize_hit
        }
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
