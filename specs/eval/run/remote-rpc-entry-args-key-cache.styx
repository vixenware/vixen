main <<VX,vx
fn build(name: String) {
  host_which(name)
}
VX

invoke {
  entry build

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe"}
            {name "link.exe", path "C:/VS/link.exe"}
          )
        }
      }
    }
  }
}

runs (
  {
    invoke {
      place win
      args ("cl.exe")
    }

    expect {
      result @string"C:/VS/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
      )
    }
  }

  {
    invoke {
      place win
      args ("link.exe")
    }

    expect {
      result @string"C:/VS/link.exe"
      obligations (
        @which{
          name "link.exe"
          expected_path "C:/VS/link.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
        @must_not_emit/@stabilize_hit
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
