main <<VX,vx
fn build() {
  host_hash("tool.txt")
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          hashes (
            {
              path "tool.txt"
              content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          )
        }
      }
    }
  }
}

expect {
  result @string"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  provenance @host_probe{
    host win
    description host_hash
    source {
      source_id "specs/eval/run/remote-rpc-host-hash.styx#main"
      start {
        byte 15
        line 1
        column 2
      }
      end {
        byte 36
        line 1
        column 23
      }
    }
  }
  obligations (
    @hash{
      path "tool.txt"
      content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  )
  reuse @observed
  crossing @by_value

  engines {
    eval1 @skip
    eval2 @pass
  }
}
