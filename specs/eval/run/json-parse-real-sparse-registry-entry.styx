main <<VX,vx
struct RegistryDep {
  name: String,
  req: String,
  features: Array[String],
  optional: Bool,
  default_features: Bool,
  target: String?,
  kind: DepKind?,
}

#[rename_all = "snake_case"]
enum DepKind {
  struct Normal,
  struct Build,
  struct Dev,
}

struct RegistryRelease {
  name: String,
  #[rename = "vers"]
  version: String,
  deps: Array[RegistryDep],
  cksum: String,
  features: Map[String, Array[String]],
  yanked: Bool,
  rust_version: String?,
  pubtime: String?,
}

struct ReleaseSummary {
  name: String,
  version: String,
  first_dep: String,
  first_dep_kind: DepKind?,
  derive_feature: Array[String],
  rust_version: String?,
}

fn build() {
  let release = Json.parse[RegistryRelease](read_file("registry_real/serde-1.0.228.json"));
  let first_dep = array_first(release.deps);
  ReleaseSummary {
    name: release.name,
    version: release.version,
    first_dep: first_dep.name,
    first_dep_kind: first_dep.kind,
    derive_feature: map_get(release.features, "derive"),
    rust_version: release.rust_version,
  }
}
VX

invoke {
  entry build
}

expect {
  result @struct{
    type ReleaseSummary
    fields {
      name @string"serde"
      version @string"1.0.228"
      first_dep @string"serde_core"
      first_dep_kind @struct{
        type Some
        fields {
          value @struct{
            type Normal
          }
        }
      }
      derive_feature @array(
        @string"serde_derive"
      )
      rust_version @struct{
        type Some
        fields {
          value @string"1.56"
        }
      }
    }
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
