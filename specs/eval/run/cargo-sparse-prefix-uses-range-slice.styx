main <<VX,vx
fn sparse_prefix_parts(name: String) (
  let len = name.len();
  if len == 1 (
    ["1"]
  ) else (
    if len == 2 (
      ["2"]
    ) else (
      if len == 3 (
        ["3", name.slice(0..1)]
      ) else (
        [name.slice(0..2), name.slice(2..4)]
      )
    )
  )
)

fn build() {
  sparse_prefix_parts("flate2")
}
VX

invoke {
  entry build
}

expect {
  result @array(
    @string"fl"
    @string"at"
  )

  engines {
    eval1 @skip
    eval2 @pass
  }
}
