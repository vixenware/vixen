main <<VX,vx
fn build() {
  fail "remote boom"
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }
}

expect {
  poison {
    kind UserFail
    message_contains "remote boom"
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
