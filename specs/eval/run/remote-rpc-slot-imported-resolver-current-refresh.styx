main <<VX,vx
fn build_current(witness: String) {
  slot_current("rpc-imported-slot", witness, imported_resolve)
}

fn build_refresh(witness: String, intent: String) {
  slot_refresh("rpc-imported-slot", witness, intent, imported_resolve)
}
VX

files {
  "helpers.vx" <<VX,vx
fn imported_resolve(ctx) {
  ctx.witness
}
VX
}

invoke {
  entry build_current
  place win
  args (@string"v1")

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }
}

runs (
  {
    expect {
      result @string"v1"
    }
  }

  {
    invoke {
      args (@string"v2")
    }

    expect {
      result @string"v2"
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"v2" @string"force")
    }

    expect {
      result @string"v2"
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
