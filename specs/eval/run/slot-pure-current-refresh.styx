main <<VX,vx
fn build_current(witness: String, desired: U64) {
  slot_current("pure-slot", witness, ((ctx) => desired))
}

fn build_refresh(witness: String, desired: U64, intent: String) {
  slot_refresh("pure-slot", witness, intent, ((ctx) => desired))
}
VX

invoke {
  entry build_current
  args (@string"w1" @u64"1")
}

runs (
  {
    expect {
      result @u64"1"
      events (
        @must_emit/@slot_populate{
          slot "pure-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      args (@string"w1" @u64"999")
    }

    expect {
      result @u64"1"
      events (
        @must_emit/@slot_reuse{slot "pure-slot"}
      )
    }
  }

  {
    invoke {
      args (@string"w2" @u64"2")
    }

    expect {
      result @u64"2"
      events (
        @must_emit/@slot_rewrite{
          slot "pure-slot"
          reason @witness_changed
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"w2" @u64"3" @string"refresh")
    }

    expect {
      result @u64"3"
      events (
        @must_emit/@slot_rewrite{
          slot "pure-slot"
          reason @refresh{
            intent @string"refresh"
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
      args (@string"w2" @u64"999")
    }

    expect {
      result @u64"3"
      events (
        @must_emit/@slot_reuse{slot "pure-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
