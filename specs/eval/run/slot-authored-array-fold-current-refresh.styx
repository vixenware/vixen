main <<VX,vx
fn registry_packages() {
  %{
    "core" => [
      %{
        "version" => "1.0.0",
        "default" => true,
        "deps" => [],
      },
    ],
    "logger" => [
      %{
        "version" => "1.0.0",
        "default" => true,
        "deps" => [
          %{ "name" => "logger", "version" => "1.0.0" },
        ],
      },
      %{
        "version" => "1.1.0",
        "default" => false,
        "deps" => [],
      },
    ],
    "codec" => [
      %{
        "version" => "1.0.0",
        "default" => true,
        "deps" => [
          %{ "name" => "logger", "version" => "1.0.0" },
        ],
      },
      %{
        "version" => "1.1.0",
        "default" => false,
        "deps" => [
          %{ "name" => "logger", "version" => "1.1.0" },
        ],
      },
    ],
  }
}

fn default_candidate(candidates) {
  array_find(candidates, ((candidate) => map_get(candidate, "default")))
}

fn build_default_solution(solution, entry) {
  let name = map_get(entry, "key");
  let candidates = map_get(entry, "value");
  map_put(solution, name, map_get(default_candidate(candidates), "version"))
}

fn candidate_task(name, candidate) {
  %{
    "name" => name,
    "candidate" => candidate,
  }
}

fn apply_dep(solution, dep) {
  map_put(solution, map_get(dep, "name"), map_get(dep, "version"))
}

fn apply_candidate(solution, name, candidate) {
  let rewritten = map_put(solution, name, map_get(candidate, "version"));
  array_fold(map_get(candidate, "deps"), rewritten, apply_dep)
}

fn enqueue_dep(queue, registry, dep) {
  let name = map_get(dep, "name");
  let version = map_get(dep, "version");
  let candidate = array_find(
    map_get(registry, name),
    ((candidate) => map_get(candidate, "version") == version),
  );
  array_push(queue, candidate_task(name, candidate))
}

fn enqueue_candidate_deps(queue, registry, candidate) {
  array_fold(
    map_get(candidate, "deps"),
    queue,
    ((acc, dep) => enqueue_dep(acc, registry, dep)),
  )
}

fn enqueue_alternative_candidate(queue, current_version, name, candidate) {
  if queue == [] (
    if map_get(candidate, "version") != current_version (
      array_push(queue, candidate_task(name, candidate))
    ) else (
      queue
    )
  ) else (
    queue
  )
}

fn refresh_queue(registry, current, name) {
  let current_version = map_get(current, name);
  array_fold(
    map_get(registry, name),
    [],
    ((queue, candidate) => enqueue_alternative_candidate(queue, current_version, name, candidate)),
  )
}

fn process_refresh_queue(registry, solution, queue) {
  if queue == [] (
    solution
  ) else (
    let task = array_first(queue);
    let rest = array_rest(queue);
    let name = map_get(task, "name");
    let candidate = map_get(task, "candidate");
    let version = map_get(candidate, "version");
    if map_get(solution, name) == version (
      process_refresh_queue(registry, solution, rest)
    ) else (
      let rewritten = apply_candidate(solution, name, candidate);
      let extended = enqueue_candidate_deps(rest, registry, candidate);
      process_refresh_queue(registry, rewritten, extended)
    )
  )
}

fn resolve_solution(ctx) {
  let registry = registry_packages();
  if ctx.is_refresh (
    let current = ctx.current;
    let queue = refresh_queue(registry, current, ctx.intent.name);
    process_refresh_queue(registry, current, queue)
  ) else (
    array_fold(map_entries(registry), %{}, build_default_solution)
  )
}

fn build_current() {
  slot_current("authored-array-fold-slot", "manifest-v1", resolve_solution)
}

fn build_refresh(name: String) {
  slot_refresh(
    "authored-array-fold-slot",
    "manifest-v1",
    UpdatePackage { name: name },
    resolve_solution,
  )
}
VX

invoke {
  entry build_current
}

runs (
  {
    expect {
      result @map{
        core @string"1.0.0"
        logger @string"1.0.0"
        codec @string"1.0.0"
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-array-fold-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"core")
    }

    expect {
      result @map{
        core @string"1.0.0"
        logger @string"1.0.0"
        codec @string"1.0.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-fold-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"core"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec")
    }

    expect {
      result @map{
        core @string"1.0.0"
        logger @string"1.1.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-fold-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
    }

    expect {
      result @map{
        core @string"1.0.0"
        logger @string"1.1.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_reuse{slot "authored-array-fold-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
