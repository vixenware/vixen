main <<VX,vx
struct Requirement {
  version: String,
}

type Solution = Map[String, String]

fn requirement(version: String) -> Requirement {
  Requirement {
    version: version,
  }
}

fn requirements_allow(requirements: Array[Requirement], version: String) -> Bool {
  array_fold(
    requirements,
    true,
    ((ok, requirement) => if ok (requirement.version == version) else (false)),
  )
}

fn merge_solution_entry(solution: Solution, entry) -> Solution {
  map_put(solution, map_get(entry, "key"), map_get(entry, "value"))
}

fn merge_solution(left: Solution, right: Solution) -> Solution {
  array_fold(map_entries(right), left, merge_solution_entry)
}

fn resolve_logger(ctx) -> Solution {
  let requirements = ctx.joined;
  search_assumption(
    "logger",
    ["1.1.0", "1.0.0"],
    (() => {
      let version = branch_assumption("logger");
      if requirements_allow(requirements, version) (
        %{
          "logger" => version,
        }
      ) else (
        fail Conflict {
          package: "logger",
          version: version,
          joined: requirements,
        }
      )
    }),
  )
}

fn util_candidates(ctx) -> Array[String] {
  if ctx.is_refresh (
    if ctx.intent.name == "util" (
      ["1.1.0", "1.0.0"]
    ) else (
      [map_get(ctx.current, "util")]
    )
  ) else (
    if ctx.has_current (
      [map_get(ctx.current, "util")]
    ) else (
      ["1.0.0"]
    )
  )
}

fn resolve_util(ctx) -> Solution {
  search_assumption(
    "util",
    util_candidates(ctx),
    (() => %{
      "util" => branch_assumption("util"),
    }),
  )
}

fn codec_candidates(ctx) -> Array[String] {
  if ctx.is_refresh (
    if ctx.intent.name == "codec" (
      ["1.1.0", "1.0.0"]
    ) else (
      [map_get(ctx.current, "codec")]
    )
  ) else (
    if ctx.has_current (
      [map_get(ctx.current, "codec")]
    ) else (
      ["1.0.0"]
    )
  )
}

fn codec_solution(version: String) -> Solution {
  %{
    "codec" => version,
  }
}

fn resolve_codec(ctx) -> Solution {
  search_assumption(
    "codec",
    codec_candidates(ctx),
    (() => {
      let version = branch_assumption("codec");
      if version == "1.1.0" (
        let left = keyed("logger", [requirement("1.1.0")], resolve_logger);
        let right = keyed("logger", [requirement("1.0.0")], resolve_logger);
        merge_solution(codec_solution(version), merge_solution(left, right))
      ) else (
        let logger = keyed("logger", [requirement("1.0.0")], resolve_logger);
        merge_solution(codec_solution(version), logger)
      )
    }),
  )
}

fn resolve_solution(ctx) -> Solution {
  merge_solution(resolve_util(ctx), resolve_codec(ctx))
}

fn build_current() {
  slot_current("authored-array-fold-slot", "manifest-v1", resolve_solution)
}

fn build_refresh(name: String) {
  slot_refresh(
    "authored-array-fold-slot",
    "manifest-v1",
    UpdatePackage { name: name },
    resolve_solution,
  )
}
VX

invoke {
  entry build_current
}

runs (
  {
    expect {
      result @map{
        util @string"1.0.0"
        codec @string"1.0.0"
        logger @string"1.0.0"
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-array-fold-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"util")
    }

    expect {
      result @map{
        util @string"1.1.0"
        codec @string"1.0.0"
        logger @string"1.0.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-fold-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"util"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec")
    }

    expect {
      result @map{
        util @string"1.1.0"
        codec @string"1.0.0"
        logger @string"1.0.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-fold-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
    }

    expect {
      result @map{
        util @string"1.1.0"
        codec @string"1.0.0"
        logger @string"1.0.0"
      }
      events (
        @must_emit/@slot_reuse{slot "authored-array-fold-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
