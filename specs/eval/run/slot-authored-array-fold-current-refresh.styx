main <<VX,vx
fn registry_packages() {
  %{
    "logger" => [
      %{
        "version" => "1.0.0",
        "default" => true,
        "deps" => [
          %{ "name" => "logger", "version" => "1.0.0" },
        ],
      },
    ],
    "codec" => [
      %{
        "version" => "1.0.0",
        "default" => true,
        "deps" => [
          %{ "name" => "logger", "version" => "1.0.0" },
        ],
      },
      %{
        "version" => "1.1.0",
        "default" => false,
        "deps" => [
          %{ "name" => "logger", "version" => "1.1.0" },
        ],
      },
    ],
  }
}

fn default_candidate(candidates) {
  array_find(candidates, ((candidate) => map_get(candidate, "default")))
}

fn build_default_solution(solution, entry) {
  let name = map_get(entry, "key");
  let candidates = map_get(entry, "value");
  map_put(solution, name, map_get(default_candidate(candidates), "version"))
}

fn apply_dep(solution, dep) {
  map_put(solution, map_get(dep, "name"), map_get(dep, "version"))
}

fn apply_candidate(solution, name, candidate) {
  let rewritten = map_put(solution, name, map_get(candidate, "version"));
  array_fold(map_get(candidate, "deps"), rewritten, apply_dep)
}

fn resolve_solution(ctx) {
  let registry = registry_packages();
  if ctx.is_refresh (
    let current = ctx.current;
    let name = ctx.intent.name;
    let current_version = map_get(current, name);
    let next = array_find(
      map_get(registry, name),
      ((candidate) => map_get(candidate, "version") != current_version),
    );
    apply_candidate(current, name, next)
  ) else (
    array_fold(map_entries(registry), %{}, build_default_solution)
  )
}

fn build_current() {
  slot_current("authored-array-fold-slot", "manifest-v1", resolve_solution)
}

fn build_refresh(name: String) {
  slot_refresh(
    "authored-array-fold-slot",
    "manifest-v1",
    UpdatePackage { name: name },
    resolve_solution,
  )
}
VX

invoke {
  entry build_current
}

runs (
  {
    expect {
      result @map{
        logger @string"1.0.0"
        codec @string"1.0.0"
      }
      events (
        @must_emit/@slot_populate{
          slot "authored-array-fold-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      entry build_refresh
      args (@string"codec")
    }

    expect {
      result @map{
        logger @string"1.1.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_rewrite{
          slot "authored-array-fold-slot"
          reason @refresh{
            intent @struct{
              type UpdatePackage
              fields {
                name @string"codec"
              }
            }
          }
        }
      )
    }
  }

  {
    invoke {
      entry build_current
    }

    expect {
      result @map{
        logger @string"1.1.0"
        codec @string"1.1.0"
      }
      events (
        @must_emit/@slot_reuse{slot "authored-array-fold-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
