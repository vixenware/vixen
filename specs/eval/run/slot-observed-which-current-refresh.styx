main <<VX,vx
fn build_current(name: String) {
  slot_current("toolchain-slot", name, ((ctx) => host_which(ctx.witness)))
}

fn build_refresh(name: String, intent: String) {
  slot_refresh("toolchain-slot", name, intent, ((ctx) => host_which(ctx.witness)))
}
VX

invoke {
  entry build_current
  place win
  args (@string"cl.exe")

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.3/cl.exe"}
          )
        }
      }

      win_same {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.3/cl.exe"}
          )
        }
      }

      win_changed {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.4/cl.exe"}
          )
        }
      }
    }
  }
}

runs (
  {
    expect {
      result @string"C:/VS/14.3/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.3/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
    }
  }

  {
    invoke {
      place win_same
    }

    expect {
      result @string"C:/VS/14.3/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.3/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
    }
  }

  {
    invoke {
      place win_changed
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
    }
  }

  {
    invoke {
      place win_changed
      entry build_refresh
      args (@string"cl.exe" @string"force_rediscover")
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
    }
  }

  {
    invoke {
      place win_changed
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
    }
  }

  {
    invoke {
      place win_changed
      verify_place win_same
    }

    expect {
      poison {
        kind VerificationFailure
        message_contains "host.which(\"cl.exe\") changed"
      }
      events (
        @must_emit/@verify_claims_fail
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
