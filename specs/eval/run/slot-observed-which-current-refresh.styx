main <<VX,vx
fn build() {
  0
}
VX

invoke {
  entry build
  place win

  slot {
    id "toolchain-slot"
    domain @observed_which{
      name "cl.exe"
    }
    action @current
  }

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.3/cl.exe"}
          )
        }
      }

      win_same {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.3/cl.exe"}
          )
        }
      }

      win_changed {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/14.4/cl.exe"}
          )
        }
      }
    }
  }
}

runs (
  {
    expect {
      result @string"C:/VS/14.3/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.3/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@slot_populate{
          slot "toolchain-slot"
          reason @missing
        }
      )
    }
  }

  {
    invoke {
      place win_same
    }

    expect {
      result @string"C:/VS/14.3/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.3/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@slot_reuse{slot "toolchain-slot"}
      )
    }
  }

  {
    invoke {
      place win_changed
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@slot_rewrite{
          slot "toolchain-slot"
          reason @claims_invalid{
            reason_contains "host.which(\"cl.exe\") changed"
          }
        }
      )
    }
  }

  {
    invoke {
      place win_changed
      slot {
        action @refresh{
          intent @string"force_rediscover"
        }
      }
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@slot_rewrite{
          slot "toolchain-slot"
          reason @refresh{
            intent @string"force_rediscover"
          }
        }
      )
    }
  }

  {
    invoke {
      place win_changed
      slot {
        action @current
      }
    }

    expect {
      result @string"C:/VS/14.4/cl.exe"
      obligations (
        @which{
          name "cl.exe"
          expected_path "C:/VS/14.4/cl.exe"
        }
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@slot_reuse{slot "toolchain-slot"}
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
