main <<VX,vx
struct Bundle {
  file: String,
}

fn build() {
  Bundle {
    file: host_read("tool.txt"),
  }
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
          reads (
            {
              path "tool.txt"
              content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          )
        }
      }
    }
  }
}

expect {
  result @struct{
    type Bundle
    fields {
      file @external{
        kind host_file
        descriptor "tool.txt"
      }
    }
  }
  obligations (
    @read{
      path "tool.txt"
      content_hash "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  )
  reuse @observed
  crossing @by_value
  provenance @literal{
    source {
      source_id "specs/eval/run/remote-rpc-host-read-nested.styx#main"
      start {
        byte 50
        line 5
        column 2
      }
      end {
        byte 95
        line 7
        column 3
      }
    }
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
