main <<VX,vx
fn build() {
  host_os()
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }

      linux {
        host {
          os linux
          arch x86_64
        }
      }
    }
  }
}

runs (
  {
    expect {
      result @string"windows"
      obligations (
        @os{value windows}
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
      )
    }
  }

  {
    invoke {
      place linux
    }

    expect {
      result @string"linux"
      obligations (
        @os{value linux}
      )
      reuse @observed
      crossing @by_value
      events (
        @must_emit/@stabilize_miss
        @must_not_emit/@stabilize_hit
        @must_not_emit/@verify_claims_fail
      )
    }
  }
)

expect {
  engines {
    eval1 @skip
    eval2 @pass
  }
}
