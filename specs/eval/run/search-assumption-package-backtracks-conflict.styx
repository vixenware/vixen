main <<VX,vx
struct Dep {
  name: String,
  version: String,
}

struct Candidate {
  version: String,
  deps: Array[Dep],
}

type Solution = Map[String, String]

fn registry_packages() {
  %{
    "logger" => [
      Candidate {
        version: "1.1.0",
        deps: [],
      },
      Candidate {
        version: "1.0.0",
        deps: [],
      },
    ],
    "format" => [
      Candidate {
        version: "1.0.0",
        deps: [
          Dep {
            name: "logger",
            version: "1.0.0",
          },
        ],
      },
    ],
    "codec" => [
      Candidate {
        version: "1.1.0",
        deps: [
          Dep {
            name: "logger",
            version: "1.1.0",
          },
          Dep {
            name: "format",
            version: "1.0.0",
          },
        ],
      },
      Candidate {
        version: "1.0.0",
        deps: [
          Dep {
            name: "logger",
            version: "1.0.0",
          },
          Dep {
            name: "format",
            version: "1.0.0",
          },
        ],
      },
    ],
  }
}

fn candidate_versions(candidates: Array[Candidate]) -> Array[String] {
  array_fold(candidates, [], ((versions, candidate) => array_push(versions, candidate.version)))
}

fn find_candidate(candidates: Array[Candidate], version: String) -> Candidate {
  array_find(candidates, ((candidate) => candidate.version == version))
}

fn requirements_allow(requirements: Array[Dep], version: String) -> Bool {
  array_fold(
    requirements,
    true,
    ((ok, requirement) => if ok (requirement.version == version) else (false)),
  )
}

fn merge_solution_entry(solution: Solution, entry) -> Solution {
  map_put(solution, map_get(entry, "key"), map_get(entry, "value"))
}

fn merge_solution(left: Solution, right: Solution) -> Solution {
  array_fold(map_entries(right), left, merge_solution_entry)
}

fn resolve_dep(dep: Dep) -> Solution {
  keyed(dep.name, [dep], resolve_pkg)
}

fn apply_dep(solution: Solution, dep: Dep) -> Solution {
  merge_solution(solution, resolve_dep(dep))
}

fn apply_candidate(package: String, candidate: Candidate) -> Solution {
  let base = map_put(%{}, package, candidate.version);
  array_fold(candidate.deps, base, apply_dep)
}

fn resolve_pkg(ctx) -> Solution {
  let package = ctx.key;
  let candidates = map_get(registry_packages(), package);
  let requirements = ctx.joined;
  search_assumption(
    package,
    candidate_versions(candidates),
    (() => {
      let version = branch_assumption(package);
      if requirements_allow(requirements, version) (
        apply_candidate(package, find_candidate(candidates, version))
      ) else (
        fail Conflict {
          package: package,
          version: version,
          joined: requirements,
        }
      )
    }),
  )
}

fn build() -> Solution {
  keyed("codec", [], resolve_pkg)
}
VX

invoke {
  entry build
}

expect {
  result @map{
    codec @string"1.0.0"
    format @string"1.0.0"
    logger @string"1.0.0"
  }

  engines {
    eval1 @skip
    eval2 @pass
  }
}
