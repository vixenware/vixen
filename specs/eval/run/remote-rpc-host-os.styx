main <<VX,vx
fn build() {
  host_os()
}
VX

invoke {
  entry build
  place win

  runtime {
    places {
      win {
        host {
          os windows
          arch x86_64
        }
      }
    }
  }
}

expect {
  result @string"windows"
  provenance @host_probe{
    host win
    description host_os
    source {
      source_id "specs/eval/run/remote-rpc-host-os.styx#main"
      start {
        byte 15
        line 1
        column 2
      }
      end {
        byte 24
        line 1
        column 11
      }
    }
  }
  obligations (
    @os{value windows}
  )

  engines {
    eval1 @skip
    eval2 @pass
  }
}
