main <<VX,vx
fn build() {
  ()
}
VX

invoke {
  entry build
  capabilities (fs discover)

  runtime {
    executors {
      default @host{
        os windows
        arch x86_64
        which (
          {name "cl.exe", path "C:/VS/cl.exe"}
          {name "lib.exe", path "C:/VS/lib.exe"}
        )
      }
    }
  }
}

expect {
  engines {
    eval1 @skip
    eval2 @skip
  }
}
