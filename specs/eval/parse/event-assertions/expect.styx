result {
  type Toolchain
  fields {
    os windows
    arch x86_64
  }
}

obligations (
  @os{value windows}
  @arch{value x86_64}
)

events (
  @must_emit/@discover_start{executor default}
  @must_emit/@discover_end
  @must_not_emit/@exec_start
  @before{
    first @discover_start{executor default}
    then @discover_end
  }
)

engines {
  eval1 @pass
  eval2 @pass
}
