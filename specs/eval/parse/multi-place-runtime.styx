main <<VX,vx
fn build() {
  ()
}
VX

invoke {
  entry build

  runtime {
    places {
      local {
        host {
          os macos
          arch aarch64
        }

        tracked_files {
          "Cargo.toml" <<TXT
[package]
name = "demo"
TXT
        }
      }

      win {
        host {
          os windows
          arch x86_64
          which (
            {name "cl.exe", path "C:/VS/cl.exe", bundle msvc}
            {name "link.exe", path "C:/VS/link.exe"}
          )
        }

        tracked_files {
          "src/main.c" <<C
int main(void) { return 0; }
C
        }

        opaque_bundles {
          msvc {
            identity "msvc-14.4"
            files {
              "C:/VS/cl.exe" <<TXT
stub cl
TXT
              "C:/VS/include/vcruntime.h" <<TXT
// stub runtime
TXT
            }
          }
        }
      }
    }
  }
}

expect {
  engines {
    eval1 @skip
    eval2 @skip
  }
}
