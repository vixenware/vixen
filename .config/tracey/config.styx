@schema {id crate:tracey-config@1, cli tracey}

// Tracey configuration for vixen

specs (
    {
        name language
        include (
            docs/spec/language/*.md
            docs/spec/language/**/*.md
        )
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
    {
        name stdlib
        include (
            docs/spec/stdlib/*.md
            docs/spec/stdlib/**/*.md
        )
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
    {
        name internals
        include (docs/spec/internals.md)
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
    {
        name diagnostics
        include (docs/spec/diagnostics.md)
        impls (
            {
                name rust
                include (
                    crates/**/*.rs
                    crates-plus/**/*.rs
                )
                exclude (target/**)
            }
        )
    }
)
