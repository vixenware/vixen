@schema {id crate:tracey-config@1, cli tracey}

// Tracey configuration for vixen

specs (
    {
        name language
        include (docs/content/spec/language.md)
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
    {
        name internals
        include (docs/content/spec/internals.md)
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
)
