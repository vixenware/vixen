@schema {id crate:tracey-config@1, cli tracey}

// Tracey configuration for vixen

specs (
    {
        name vixen
        include (docs/content/spec.md)
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
    {
        name internals
        include (docs/content/internals-spec.md)
        impls (
            {
                name rust
                include (crates/**/*.rs)
                exclude (target/**)
            }
        )
    }
)
