@schema {id crate:dodeca-config@1, cli ddc}

// vixen docs: two sites, one server.
// Root (/) is the USER site: evaluate, install, build, trust.
// /dev is the DEVELOPER site: concepts, constellation, the vix language,
// contributing. Each has its own chrome (templates/static as content-dir
// siblings); cross-links use [[dev:...]] / absolute paths.

source {
    content docs/content
    impls ()
    page_types {
        Doc @object{
            tags @optional(@seq(@string))
            type @string
            created @optional(@string)
            tiers @optional(@seq(@string))
            updated @optional(@string)
        }
    }
    skip_domains ()
}

mounts (
    { name dev, path /dev, local docs/dev/content }
)

site {output public}
