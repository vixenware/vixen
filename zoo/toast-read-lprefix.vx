fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  let class = executor_class("ssh:toast");
  let powershell =
    discover(class, (host) => host.which("powershell.exe"));

  let copied =
    exec(
      [
        powershell,
        "-NoProfile",
        "-Command",
        "Copy-Item -LiteralPath 'src\\\\lprefix.h' -Destination 'out\\\\probe.txt'",
      ]
    ) where {
      executor: class,
      mounts: { @src: Tree(workspace / @zoo/lua-src) },
      writable: [@out],
      observer: (proc, vfs) => (
        if proc.exit_code != 0 (
          fail `process failed`
        ) else (
          vfs.subtree(@out)
        )
      ),
    };

  Tree {
    @probe.txt: copied.file(@probe.txt),
  }
}
