fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  let class = executor_class("ssh:toast");
  let cl =
    discover(class, (host) => host.which("cl.exe"));

  let output =
    exec(
      [
        cl,
        "/nologo",
        "/c",
        "/showIncludes",
        "/Isrc",
        "/Foout\\obj\\lapi.c.obj",
        @src/lapi.c,
      ]
    ) where {
      executor: class,
      mounts: { @src: Tree(workspace / @zoo/lua-src) },
      writable: [@out],
      observer: (proc, _vfs) => (
        Tree {
          @stdout.txt: proc.stdout.collect().blob(),
        }
      ),
    };

  Tree {
    @stdout.txt: output.file(@stdout.txt),
  }
}
