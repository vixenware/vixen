let zlib_sources = [
  @adler32.c, @compress.c, @crc32.c, @deflate.c,
  @gzclose.c, @gzlib.c, @gzread.c, @gzwrite.c,
  @inflate.c, @infback.c, @inftrees.c, @inffast.c,
  @trees.c, @uncompr.c, @zutil.c,
];

let libpng_core_sources = [
  @png.c, @pngerror.c, @pngget.c, @pngmem.c, @pngpread.c,
  @pngread.c, @pngrio.c, @pngrtran.c, @pngrutil.c, @pngset.c,
  @pngtrans.c, @pngwio.c, @pngwrite.c, @pngwtran.c, @pngwutil.c,
];

struct Toolchain {
  os: String,
  arch: String,
  cc: String,
  archive: String,
}

fn toolchain(class: ExecutorClass) {
  discover(class, (host) => {
    let os = host.os();
    let arch = host.arch();
    let cc =
      if os == "windows" (
        host.which("cl.exe")
      ) else (
        host.which("cc")
      );
    let archive =
      if os == "windows" (
        host.which("lib.exe")
      ) else (
        host.which("ar")
      );

    Toolchain { os, arch, cc, archive }
  })
}

fn build_libpng(workspace: Path, class: ExecutorClass) {
  let tc = toolchain(class);
  let zlib_src = Tree(workspace / @zoo/zlib-src);
  let libpng_src = Tree(workspace / @zoo/libpng-src);
  let pnglibconf_h = libpng_src.file @scripts/pnglibconf.h.prebuilt;
  let zlib_defines =
    if tc.os == "windows" (
      []
    ) else (
      ["Z_HAVE_UNISTD_H"]
    );

  let cexec = partial exec where {
    executor: class,
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  fn compile_objects(src: Tree, sources: Array[Path]) where {
    generated: Map[Path, Blob] = {},
    mounts: Map[Path, TreeEntry] = {},
    includes: Array[Path] = [],
    defines: Array[String] = [],
  } -> Tree (
    sources
      .map((file) =>
        if tc.os == "windows" (
          cexec [
            tc.cc,
            "/nologo",
            "/c",
            @(src/{file}),
            `/Foout\\${file}.obj`,
            ..includes.map((include) => ["/I", include]).flatten(),
            ..defines.map((define) => `/D${define}`),
            "/O2",
          ] where {
            mounts: { @src: src, @gen: Tree(generated), ..mounts },
            writable: [@out],
          }
        ) else (
          cexec [
            tc.cc,
            "-c",
            @(src/{file}),
            "-o",
            @(out/{file}.o),
            ..includes.map((include) => ["-I", include]).flatten(),
            ..defines.map((define) => `-D${define}`),
            "-O2",
            "-fPIC",
          ] where {
            mounts: { @src: src, @gen: Tree(generated), ..mounts },
            writable: [@out],
          }
        )
      )
      .merge()
  );

  fn static_archive(name: Path, objects: Tree) -> Tree (
    if tc.os == "windows" (
      cexec [tc.archive, "/nologo", `/OUT:out\\${name}`, ..objects] where {
        writable: [@out],
      }
    ) else (
      cexec [tc.archive, "rcs", @(out/{name}), ..objects] where {
        writable: [@out],
      }
    )
  );

  let zlib_objects =
    compile_objects(zlib_src, zlib_sources) where {
      includes: [@src],
      defines: zlib_defines,
    };

  let zlib_archive_name =
    if tc.os == "windows" (
      @zlib.lib
    ) else (
      @libz.a
    );
  let zlib_static = static_archive(zlib_archive_name, zlib_objects);
  let zlib_install =
    if tc.os == "windows" (
      Tree {
        @include/zlib.h: zlib_src.file @zlib.h,
        @include/zconf.h: zlib_src.file @zconf.h,
        @lib/zlib.lib: zlib_static.file(@zlib.lib),
      }
    ) else (
      Tree {
        @include/zlib.h: zlib_src.file @zlib.h,
        @include/zconf.h: zlib_src.file @zconf.h,
        @lib/libz.a: zlib_static.file(@libz.a),
      }
    );

  let libpng_objects =
    compile_objects(libpng_src, libpng_core_sources) where {
      generated: { @pnglibconf.h: pnglibconf_h },
      mounts: { @deps/zlib: zlib_install },
      includes: [@gen, @src, @deps/zlib/include],
    };

  let libpng_archive_name =
    if tc.os == "windows" (
      @libpng16.lib
    ) else (
      @libpng16.a
    );
  let libpng_static = static_archive(libpng_archive_name, libpng_objects);
  let libpng_install =
    if tc.os == "windows" (
      Tree {
        @include/png.h: libpng_src.file @png.h,
        @include/pngconf.h: libpng_src.file @pngconf.h,
        @include/pnglibconf.h: pnglibconf_h,
        @lib/libpng16.lib: libpng_static.file(@libpng16.lib),
      }
    ) else (
      Tree {
        @include/png.h: libpng_src.file @png.h,
        @include/pngconf.h: libpng_src.file @pngconf.h,
        @include/pnglibconf.h: pnglibconf_h,
        @lib/libpng16.a: libpng_static.file(@libpng16.a),
      }
    );

  let version_source = Tree {
    @png-version.c: Blob(`
#include <stdio.h>
#include <png.h>

int main(void) {
  printf("%lu\n", (unsigned long)png_access_version_number());
  return 0;
}
`),
  };

  let version_program =
    if tc.os == "windows" (
      cexec [
        tc.cc,
        "/nologo",
        "/Feout\\png-version.exe",
        @src/png-version.c,
        "/I", @deps/libpng/include,
        "/I", @deps/zlib/include,
        @deps/libpng/lib/libpng16.lib,
        @deps/zlib/lib/zlib.lib,
      ] where {
        mounts: {
          @src: version_source,
          @deps/libpng: libpng_install,
          @deps/zlib: zlib_install,
        },
        writable: [@out],
      }
    ) else (
      cexec [
        tc.cc,
        "-o",
        @out/png-version,
        @src/png-version.c,
        "-I", @deps/libpng/include,
        "-I", @deps/zlib/include,
        @deps/libpng/lib/libpng16.a,
        @deps/zlib/lib/libz.a,
        "-lm",
      ] where {
        mounts: {
          @src: version_source,
          @deps/libpng: libpng_install,
          @deps/zlib: zlib_install,
        },
        writable: [@out],
      }
    );

  Tree {
    @(artifacts/{tc.os}-{tc.arch}/zlib): zlib_install,
    @(artifacts/{tc.os}-{tc.arch}/libpng): libpng_install,
    @(artifacts/{tc.os}-{tc.arch}/probe): version_program,
  }
}

fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  Tree {
    @orb: build_libpng(workspace, executor_class("ssh:orb")),
    @toast: build_libpng(workspace, executor_class("ssh:toast")),
  }
}
