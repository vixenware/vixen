let core_sources = [
  @lapi.c, @lcode.c, @lctype.c, @ldebug.c, @ldo.c, @ldump.c,
  @lfunc.c, @lgc.c, @llex.c, @lmem.c, @lobject.c, @lopcodes.c,
  @lparser.c, @lstate.c, @lstring.c, @ltable.c, @ltm.c,
  @lundump.c, @lvm.c, @lzio.c,
];

let aux_sources = [@lauxlib.c];

let lib_sources = [
  @lbaselib.c, @ldblib.c, @liolib.c, @lmathlib.c, @loslib.c,
  @ltablib.c, @lstrlib.c, @lutf8lib.c, @loadlib.c, @lcorolib.c,
  @linit.c,
];

let all_lib_sources = [..core_sources, ..aux_sources, ..lib_sources];

struct Toolchain {
  os: String,
  arch: String,
  cc: String,
  archive: String,
}

fn toolchain(class: ExecutorClass) {
  discover(class, (host) => {
    let os = host.os();
    let arch = host.arch();
    let cc =
      if os == "windows" (
        host.which("cl.exe")
      ) else (
        host.which("cc")
      );
    let archive =
      if os == "windows" (
        host.which("lib.exe")
      ) else if os == "darwin" (
        host.which("libtool")
      ) else (
        host.which("ar")
      );

    Toolchain { os, arch, cc, archive }
  })
}

fn build_lua(workspace: Path, class: ExecutorClass) {
  let tc = toolchain(class);
  let src_tree = Tree(workspace / @zoo/lua-src);
  let unix_cflags =
    if tc.os == "linux" (
      ["-Wall", "-O2", "-std=c99", "-DLUA_USE_LINUX"]
    ) else if tc.os == "darwin" (
      ["-Wall", "-O2", "-std=c99", "-DLUA_USE_MACOSX"]
    ) else (
      []
    );
  let unix_syslibs =
    if tc.os == "linux" (
      ["-lm", "-ldl"]
    ) else if tc.os == "darwin" (
      ["-lm"]
    ) else (
      []
    );

  let cexec = partial exec where {
    executor: class,
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  fn compile(file: Path) -> Tree (
    if tc.os == "windows" (
      cexec [
        tc.cc,
        "/nologo",
        "/c",
        "/O2",
        `/Foout\\obj\\${file}.obj`,
        @(src/{file}),
      ] where {
        mounts: { @src: src_tree },
        writable: [@out],
      }
    ) else (
      cexec [
        tc.cc,
        "-c",
        ..unix_cflags,
        "-o",
        @(out/obj/{file}.o),
        @(src/{file}),
      ] where {
        mounts: { @src: src_tree },
      }
    )
  );

  fn archive(objs: Tree) -> Tree (
    if tc.os == "windows" (
      cexec [tc.archive, "/nologo", "/OUT:out\\liblua.lib", ..objs] where {
        writable: [@out],
      }
    ) else if tc.os == "darwin" (
      cexec [tc.archive, "-static", "-o", @out/liblua.a, ..objs]
    ) else (
      cexec [tc.archive, "rcs", @out/liblua.a, ..objs]
    )
  );

  fn link(lua_obj: Tree, liblua: Tree) -> Tree (
    if tc.os == "windows" (
      cexec [tc.cc, "/nologo", "/Feout\\lua.exe", ..lua_obj, ..liblua] where {
        writable: [@out],
      }
    ) else (
      cexec [tc.cc, "-o", @out/lua, ..lua_obj, ..liblua, ..unix_syslibs]
    )
  );

  let objects = (all_lib_sources.map(compile)).merge();
  let liblua = archive(objects);
  let lua_obj = compile(@lua.c);
  let lua_exe = link(lua_obj, liblua);

  let installed_bin =
    if tc.os == "windows" (
      Tree { @lua.exe: lua_exe.file(@lua.exe).executable() }
    ) else (
      Tree { @lua: lua_exe.file(@lua).executable() }
    );

  let installed_lib =
    if tc.os == "windows" (
      Tree { @liblua.lib: liblua.file(@liblua.lib) }
    ) else (
      Tree { @liblua.a: liblua.file(@liblua.a) }
    );

  let version_blob =
    exec(
      if tc.os == "windows" (
        [@bin/lua.exe, "-e", "print(_VERSION)"]
      ) else (
        [@bin/lua, "-e", "print(_VERSION)"]
      )
    ) where {
      executor: class,
      mounts: { @bin: installed_bin },
      observer: (proc, _vfs) => (
        if proc.exit_code != 0 (
          fail `process failed`
        ) else (
          proc.stdout.collect().blob()
        )
      ),
    };

  Tree {
    @(artifacts/{tc.os}-{tc.arch}/bin): installed_bin,
    @(artifacts/{tc.os}-{tc.arch}/lib): installed_lib,
    @(artifacts/{tc.os}-{tc.arch}/version.txt): version_blob,
  }
}

fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  Tree {
    @local: build_lua(workspace, executor_class("default")),
    @orb: build_lua(workspace, executor_class("ssh:orb")),
    @toast: build_lua(workspace, executor_class("ssh:toast")),
  }
}
