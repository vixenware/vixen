let { CToolchain } = import "c"

fn main(workspace: Tree) with { ..VixenMain } -> Tree (
  let src = workspace "main.c";
  fn compile(triple: String) -> Tree (
    let tc = CToolchain where (target == triple);
    Tree %{ triple => tc.executable([src], "main") }
  );
  [
    "x86_64-unknown-linux-gnu",
    "aarch64-apple-darwin",
    "aarch64-pc-windows-msvc",
  ].map(compile).merge()
)
