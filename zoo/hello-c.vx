let config = import("vixen:config")
let c = import("c")

fn build(root: Path) #discover -> Tree {
  let executors = [
    { triple: "x86_64-unknown-linux-gnu", exec: config.linux_executor },
    { triple: "aarch64-apple-darwin", exec: config.mac_executor },
    { triple: "aarch64-pc-windows-msvc", exec: config.win_executor },
    { triple: "local", exec: executor_class("default") }
  ];

  let trees = executors.map((env) => {
    let { triple, exec } = env;
    let toolchain = c.discover_toolchain() where { executor: exec };
    let tree = exec([toolchain.cc, root / @main.c, "-o", @out/main]);
    {
      triple,
      tree,
    }
  });
  trees.collect()

  // shape of the output:
  //
  // [
  //   { triple: "x86_64-unknown-linux-gnu", os: "linux", arch: "x86_64", tree: ? },
  //   { triple: "aarch64-apple-darwin", os: "mac", arch: "aarch64", tree: ? },
  //   { triple: "aarch64-pc-windows-msvc", os: "windows", arch: "aarch64", tree: ? },
  //   { triple: "local", os: "?", arch: "?", tree: ? },
  // ]
  //
  // default => local
  //
  // invocation of `vx build` (defaults to default?)
  //
  // vx build x86_64-unknown-linux-gnu ?
  // vx build local
  //
  // where does it go?
  // how to do a local build?
  //
  // would `vx build` default to `/local` ? where does it write files?
  //
  // what about `vx bench`, `vx test`, `vx run`
  //
  // vx bench rpc_encode
  // vx bench --os windows,linux,mac rpc_encode
  // vx bench /x86_64-unknown-linux-gnu /aarch64-apple-darwin /aarch64-pc-windows-msvc -- rpc_encode
}
