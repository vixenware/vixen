// Lua build sketch
//
// This is a design sketch, not a parser-validated fixture. It lives next to
// a local checkout of the Lua sources under `zoo/lua-src/`, which is ignored
// by git.

let core_sources = [
  @lapi.c, @lcode.c, @lctype.c, @ldebug.c, @ldo.c, @ldump.c,
  @lfunc.c, @lgc.c, @llex.c, @lmem.c, @lobject.c, @lopcodes.c,
  @lparser.c, @lstate.c, @lstring.c, @ltable.c, @ltm.c,
  @lundump.c, @lvm.c, @lzio.c, @ltests.c,
];

let aux_sources = [@lauxlib.c];

let lib_sources = [
  @lbaselib.c, @ldblib.c, @liolib.c, @lmathlib.c, @loslib.c,
  @ltablib.c, @lstrlib.c, @lutf8lib.c, @loadlib.c, @lcorolib.c,
  @linit.c,
];

let all_lib_sources = [..core_sources, ..aux_sources, ..lib_sources];

let cflags = ["-Wall", "-O2", "-std=c99", "-DLUA_USE_LINUX"];
let ldflags = ["-Wl,-E"];
let syslibs = ["-lm", "-ldl"];

struct Tool {
  path: String,
  hash: Blob,
}

namespace Tool {
  fn to_string(self) -> String self.path;
}

fn discover_c_toolchain(class: ExecutorClass) -> Map[Symbol, Tool] (
  discover (class, (host) => (
    fn tool(name: String) -> Tool (
      let path = host.which name;
      Tool {
        path,
        hash: host.hash path,
      }
    );

    fn named_tool(sym: Symbol) -> (Symbol, Tool) (
      (sym, tool sym.to_string!)
    );

    // The returned tool values carry hidden host obligations derived from
    // `which` and `hash`. Later `exec` rechecks them automatically on the
    // concrete executor.
    [:cc, :ar, :ranlib]
      .map named_tool
      .to_map!
  ))
) 

fn build(ws: Path, args: Array[String], env: Map[String, String]) #fs #discover -> Tree (
  let src_tree = Tree.from_path (ws / @zoo/lua-src);
  let tools = discover_c_toolchain (executor_class "default");
  let { cc, ar, ranlib } = tools;

  let common = {
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      );

      Stream.of (vfs.subtree @out)
    ),
  };

  let cexec = (partial exec where common).then ($.next!);

  fn compile(file: Path) -> Tree (
    cexec [
      cc,
      "-c",
      ..cflags,
      "-o",
      @(out/obj/{file}.o),
      @(src/{file}),
    ] where {
      mounts: { @src: src_tree },
    }
  );

  fn archive(objs: Tree) -> Tree (
    let archived = cexec [ar, "rc", @out/liblua.a, ..objs];

    cexec [ranlib, @out/liblua.a] where {
      mounts: { @out: archived },
    }
  );

  fn link(objs: Tree) -> Tree (
    cexec [cc, "-o", @out/bin/lua, ..ldflags, ..objs, ..syslibs]
  );

  let objects = (all_lib_sources.map compile).merge!;
  let liblua = archive objects;

  let lua_exe = link (Tree [compile @lua.c, liblua]);

  Tree {
    @bin/lua: lua_exe,
    @lib/liblua.a: liblua,
  }
)
