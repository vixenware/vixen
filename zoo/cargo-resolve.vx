// Cargo-style dependency resolution sketch
//
// This is not a Cargo builtin. The only ambient pieces are:
// - Http.get(url)
// - Toml.parse[T](blob)
// - Toml.serialize(value)
// - Json.parse[T](blob)
//
// Everything else is ordinary Vixen code over those primitives.

#[untagged]
enum CargoDependencySpec {
  struct Version {
    value: String,
  },

  #[rename_all = "kebab-case"]
  struct Detailed {
    version: String?,
    features: Array[String] = [],
    default_features: Bool = true,
    optional: Bool = false,
    workspace: Bool = false,
    path: String?,
    git: String?,
    rev: String?,
    package: String?,
  },
}

#[rename_all = "kebab-case"]
struct CargoManifest {
  package: CargoPackage,
  dependencies: Map[String, CargoDependencySpec] = %{},
  dev_dependencies: Map[String, CargoDependencySpec] = %{},
  build_dependencies: Map[String, CargoDependencySpec] = %{},
  features: Map[String, Array[String]] = %{},
  target: Map[String, CargoTargetTable] = %{},
  workspace: CargoWorkspace?,
}

#[untagged]
enum CargoInheritedString {
  struct Value {
    value: String,
  },

  struct Workspace {
    workspace: Bool,
  },
}

struct CargoPackage {
  name: String,
  version: CargoInheritedString,
  edition: CargoInheritedString? = None,
}

struct CargoWorkspacePackage {
  version: String?,
  edition: String?,
}

struct CargoWorkspace {
  dependencies: Map[String, CargoDependencySpec] = %{},
  package: CargoWorkspacePackage?,
}

struct CargoWorkspaceRootManifest {
  workspace: CargoWorkspace? = None,
}

#[rename_all = "kebab-case"]
struct CargoTargetTable {
  dependencies: Map[String, CargoDependencySpec] = %{},
  dev_dependencies: Map[String, CargoDependencySpec] = %{},
  build_dependencies: Map[String, CargoDependencySpec] = %{},
}

struct CargoLock {
  package: Array[LockedPackage] = [],
}

struct LockedPackage {
  name: String,
  version: String,
  source: String?,
  checksum: String?,
}

struct WorkspaceDependencyMissing {
  name: String,
}

struct WorkspacePackageFieldMissing {
  field: String,
}

struct DependencyRequest {
  name: String,
  package_name: String?,
  version_req: SemverReq?,
  features: Array[String] = [],
  default_features: Bool = true,
  optional: Bool = false,
  kind: String = "normal",
  target: String?,
  source: DependencySource = DependencySource.Registry,
}

struct SemverVersion {
  major: U64,
  minor: U64,
  patch: U64,
  pre: String?,
}

enum ComparatorOp {
  struct Exact,
  struct Greater,
  struct GreaterEq,
  struct Less,
  struct LessEq,
  struct Caret,
  struct Tilde,
}

struct Comparator {
  op: ComparatorOp,
  version: SemverVersion,
}

struct SemverReq {
  comparators: Array[Comparator],
}

struct ActivatedDependencyFeature {
  dependency: String,
  feature: String,
}

struct FeatureMapEntry {
  key: String,
  value: Array[String],
}

struct UnifiedFeatures {
  local: Array[String] = [],
  enabled_optional_deps: Array[String] = [],
  dependency_features: Array[ActivatedDependencyFeature] = [],
}

struct FeatureExpansionState {
  pending: Array[String] = [],
  enabled_optional_deps: Array[String] = [],
  dependency_features: Array[ActivatedDependencyFeature] = [],
}

struct BuildTarget {
  triple: String,
  cfg: Array[CfgFact] = [],
}

enum CfgFact {
  struct Name {
    name: String,
  },
  struct KeyValue {
    key: String,
    value: String,
  },
}

enum CfgExpr {
  struct Name {
    name: String,
  },
  struct KeyValue {
    key: String,
    value: String,
  },
  struct Not {
    expr: CfgExpr,
  },
  struct Any {
    exprs: Array[CfgExpr],
  },
  struct All {
    exprs: Array[CfgExpr],
  },
}

enum TargetSelector {
  struct Triple {
    triple: String,
  },
  struct Cfg {
    expr: CfgExpr,
  },
}

enum DependencySource {
  struct Registry,
  struct LocalPath {
    base: Path,
    path: String,
  },
  struct Git {
    url: String,
    rev: String?,
  },
}

struct IndexDependency {
  name: String,
  req: String,
  package: String?,
  features: Array[String] = [],
  optional: Bool = false,
  default_features: Bool = true,
  target: String?,
  kind: String?,
}

struct IndexEntry {
  name: String,
  vers: String,
  cksum: String,
  features: Map[String, Array[String]] = %{},
  features2: Map[String, Array[String]] = %{},
  yanked: Bool = false,
  deps: Array[IndexDependency] = [],
}

struct SparseConfig {
  dl: String,
}

newtype PackageId of String

struct ResolvedCrate {
  id: PackageId,
  name: String,
  version: String,
  source: ResolvedSource,
  features: Array[String] = [],
  dependencies: Array[DependencyRequest] = [],
  resolved_dependencies: Array[PackageId] = [],
}

struct PackageFacts {
  id: PackageId,
  name: String,
  version: String,
  source: ResolvedSource,
  feature_graph: Map[String, Array[String]] = %{},
  dependencies: Array[DependencyRequest] = [],
}

enum ResolvedSource {
  struct Registry {
    checksum: String,
    download_url: String,
  },
  struct LocalPath {
    path: Path,
  },
  struct Git {
    url: String,
    rev: String,
    checksum: String?,
    archive_url: String?,
  },
}

struct RegistryResolution {
  roots: Array[PackageId],
  packages: Array[ResolvedCrate],
}

struct MaterializedGraphState {
  packages: Map[String, ResolvedCrate] = %{},
}

struct CompiledRustArtifact {
  package_id: PackageId,
  crate_name: String,
  mount: Path,
  tree: Tree,
}

fn parse_lock(ws: Tree) -> CargoLock? (
  match ws.file(@Cargo.lock)? (
    Some { value } => Toml.parse[CargoLock](value),
    None => None,
  )
)

fn parse_sparse_entries(blob: Blob) -> Array[IndexEntry] (
  blob.utf8()
    .lines()
    .filter(!$.is_empty())
    .map(Json.parse[IndexEntry]($))
    .to_array()
)

fn merged_entry_features(entry: IndexEntry) -> Map[String, Array[String]] (
  array_fold(
    entry.features2.map((key, value) => FeatureMapEntry { key, value }),
    entry.features,
    ((acc, pair) => map_put(acc, pair.key, pair.value)),
  )
)

fn sparse_index_url(name: String) -> String (
  // crates.io sparse index sharding is ordinary string logic:
  // - 1 char: `1/x`
  // - 2 chars: `2/xy`
  // - 3 chars: `3/x/xyz`
  // - 4+ chars: `ab/cd/abcdef`
  let lower = name.to_lower();
  let len = lower.len();

  let rel =
    if len == 1 (
      `1/{lower}`
    ) else (
      if len == 2 (
        `2/{lower}`
      ) else (
        if len == 3 (
          `3/{lower.slice(0..1)}/{lower}`
        ) else (
          `{lower.slice(0..2)}/{lower.slice(2..4)}/{lower}`
        )
      )
    );

  `https://index.crates.io/{rel}`
)

fn sparse_prefix(name: String) -> String (
  let len = name.len();
  if len == 1 (
    "1"
  ) else (
    if len == 2 (
      "2"
    ) else (
      if len == 3 (
        `3/{name.slice(0..1)}`
      ) else (
        `{name.slice(0..2)}/{name.slice(2..4)}`
      )
    )
  )
)

fn crate_download_url(config: SparseConfig, name: String, version: String, checksum: String) -> String (
  // Cargo's sparse config can provide a download template. If it contains
  // no placeholders, Cargo appends `/{crate}/{version}/download`.
  let prefix = sparse_prefix(name);
  let lowerprefix = sparse_prefix(name.to_lower());
  let template = config.dl;

  if (
    template.contains("{crate}") ||
    template.contains("{version}") ||
    template.contains("{prefix}") ||
    template.contains("{lowerprefix}") ||
    template.contains("{sha256-checksum}")
  ) (
    template
      .replace("{crate}", name)
      .replace("{version}", version)
      .replace("{prefix}", prefix)
      .replace("{lowerprefix}", lowerprefix)
      .replace("{sha256-checksum}", checksum)
  ) else (
    `{template}/{name}/{version}/download`
  )
)

fn manifest_requests(manifest: CargoManifest) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  manifest_requests_at_with_workspace(manifest, @., %{}) where { target }
)

fn manifest_requests_with_workspace(
  manifest: CargoManifest,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  manifest_requests_at_with_workspace(manifest, @., workspace_dependencies) where { target }
)

fn manifest_requests_at(
  manifest: CargoManifest,
  manifest_root: Path,
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  manifest_requests_at_with_workspace(manifest, manifest_root, %{}) where { target }
)

fn manifest_requests_at_with_workspace(
  manifest: CargoManifest,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  [
    ..manifest.dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "normal", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.dev_dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "dev", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.build_dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "build", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.target
      .map((selector, table) => (
        target_requests_at_with_workspace(selector, table, manifest_root, workspace_dependencies) where { target }
      ))
      .flatten(),
  ]
)

fn root_requests_at_with_workspace(
  manifest: CargoManifest,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  [
    ..manifest.dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "normal", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.build_dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "build", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.target
      .map((selector, table) => (
        root_target_requests_at_with_workspace(selector, table, manifest_root, workspace_dependencies)
          where { target }
      ))
      .flatten(),
  ]
)

fn package_dependency_requests_at_with_workspace(
  manifest: CargoManifest,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) -> Array[DependencyRequest] (
  [
    ..manifest.dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "normal", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.build_dependencies
      .map((name, dep) => (
        request_from_dep_at_with_workspace(name, dep, "build", manifest_root, workspace_dependencies)
      ))
      .to_array(),
    ..manifest.target
      .map((selector, table) => (
        package_target_requests_at_with_workspace(selector, table, manifest_root, workspace_dependencies)
      ))
      .flatten(),
  ]
)

fn request_from_dep(name: String, dep: CargoDependencySpec, kind: String) -> DependencyRequest (
  request_from_dep_at_with_workspace(name, dep, kind, @., %{})
)

fn request_from_dep_with_workspace(
  name: String,
  dep: CargoDependencySpec,
  kind: String,
  workspace_dependencies: Map[String, CargoDependencySpec],
) -> DependencyRequest (
  request_from_dep_at_with_workspace(name, dep, kind, @., workspace_dependencies)
)

fn request_from_dep_at(
  name: String,
  dep: CargoDependencySpec,
  kind: String,
  manifest_root: Path,
) -> DependencyRequest (
  request_from_dep_at_with_workspace(name, dep, kind, manifest_root, %{})
)

fn request_from_dep_at_with_workspace(
  name: String,
  dep: CargoDependencySpec,
  kind: String,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) -> DependencyRequest (
  match dep (
    Version { value } => DependencyRequest {
      name,
      package_name: None,
      version_req: Some(parse_semver_req(value)),
      features: [],
      default_features: true,
      kind,
      optional: false,
      target: None,
      source: DependencySource.Registry,
    },
    Detailed {
      version,
      features,
      default_features,
      optional,
      workspace,
      path,
      git,
      rev,
      package,
    } => (
      if workspace (
        if workspace_dependencies.has(name) (
          let inherited =
            request_from_dep_at_with_workspace(name, workspace_dependencies.get(name), kind, @., %{})
          ;
          DependencyRequest {
            name,
            package_name:
              match package (
                Some { value } => Some(value),
                None => inherited.package_name,
              ),
            version_req:
              match version (
                Some { value } => Some(parse_semver_req(value)),
                None => inherited.version_req,
              ),
            features: [..inherited.features, ..features],
            default_features: inherited.default_features && default_features,
            optional: inherited.optional || optional,
            kind,
            target: None,
            source:
              match path (
                Some { value } => DependencySource.LocalPath {
                  base: manifest_root,
                  path: value,
                },
                None => (
                  match git (
                    Some { value } => DependencySource.Git { url: value, rev },
                    None => inherited.source,
                  )
                ),
              ),
          }
        ) else (
          fail WorkspaceDependencyMissing { name }
        )
      ) else (
        DependencyRequest {
          name,
          package_name: package,
          version_req:
            match version (
              Some { value } => Some(parse_semver_req(value)),
              None => None,
            ),
          features,
          default_features,
          optional,
          kind,
          target: None,
          source:
            match path (
              Some { value } => DependencySource.LocalPath {
                base: manifest_root,
                path: value,
              },
              None => (
                match git (
                  Some { value } => DependencySource.Git { url: value, rev },
                  None => DependencySource.Registry,
                )
              ),
            ),
        }
      )
    ),
  )
)

fn parse_semver_version(s: String) -> SemverVersion (
  let core_and_pre = s.split_once("-");
  let core =
    match core_and_pre (
      Some { value } => (
        let (value, _pre) = value;
        value
      ),
      None => s,
    );
  let pre =
    match core_and_pre (
      Some { value } => (
        let (_value, pre) = value;
        Some(pre)
      ),
      None => None,
    );
  match core.split_once(".") (
    Some { value } => (
      let (major, minor_patch) = value;
      match minor_patch.split_once(".") (
        Some { value } => (
          let (minor, patch) = value;
          SemverVersion {
            major: major.to_u64(),
            minor: minor.to_u64(),
            patch: patch.to_u64(),
            pre,
          }
        ),
        None => SemverVersion {
          major: major.to_u64(),
          minor: minor_patch.to_u64(),
          patch: 0,
          pre,
        },
      )
    ),
    None => SemverVersion {
      major: core.to_u64(),
      minor: 0,
      patch: 0,
      pre,
    },
  )
)

fn parse_semver_comparator(s: String) -> Comparator (
  let trimmed = trim_spaces(s);
  if trimmed.starts_with("^") (
    Comparator {
      op: ComparatorOp.Caret,
      version: parse_semver_version(trimmed.slice(1..)),
    }
  ) else if trimmed.starts_with("~") (
    Comparator {
      op: ComparatorOp.Tilde,
      version: parse_semver_version(trimmed.slice(1..)),
    }
  ) else if trimmed.starts_with(">=") (
    Comparator {
      op: ComparatorOp.GreaterEq,
      version: parse_semver_version(trimmed.slice(2..)),
    }
  ) else if trimmed.starts_with("<=") (
    Comparator {
      op: ComparatorOp.LessEq,
      version: parse_semver_version(trimmed.slice(2..)),
    }
  ) else if trimmed.starts_with(">") (
    Comparator {
      op: ComparatorOp.Greater,
      version: parse_semver_version(trimmed.slice(1..)),
    }
  ) else if trimmed.starts_with("<") (
    Comparator {
      op: ComparatorOp.Less,
      version: parse_semver_version(trimmed.slice(1..)),
    }
  ) else if trimmed.starts_with("=") (
    Comparator {
      op: ComparatorOp.Exact,
      version: parse_semver_version(trimmed.slice(1..)),
    }
  ) else (
    Comparator {
      op: ComparatorOp.Caret,
      version: parse_semver_version(trimmed),
    }
  )
)

fn parse_semver_req(s: String) -> SemverReq (
  SemverReq {
    comparators: split_top_level_args(s).map(parse_semver_comparator($)).to_array(),
  }
)

fn matches_semver(req: SemverReq?, version: SemverVersion) -> Bool (
  match req (
    None => true,
    Some { value } =>
      !value.comparators.any((cmp) => !matches_comparator(cmp, version)),
  )
)

fn matches_comparator(cmp: Comparator, version: SemverVersion) -> Bool (
  let ordering = compare_semver(version, cmp.version);
  match cmp.op (
    ComparatorOp.Exact => ordering == 1,
    ComparatorOp.Greater => ordering == 2,
    ComparatorOp.GreaterEq => ordering != 0,
    ComparatorOp.Less => ordering == 0,
    ComparatorOp.LessEq => ordering != 2,
    ComparatorOp.Caret => (
      if cmp.version.major == 0 (
        version.major == 0 &&
        version.minor == cmp.version.minor &&
        ordering != 0
      ) else (
        version.major == cmp.version.major &&
        ordering != 0
      )
    ),
    ComparatorOp.Tilde =>
      version.major == cmp.version.major &&
      version.minor == cmp.version.minor &&
      ordering != 0,
  )
)

fn compare_semver(a: SemverVersion, b: SemverVersion) -> U64 (
  if a.major < b.major (
    0
  ) else if a.major > b.major (
    2
  ) else if a.minor < b.minor (
    0
  ) else if a.minor > b.minor (
    2
  ) else if a.patch < b.patch (
    0
  ) else if a.patch > b.patch (
    2
  ) else (
    match a.pre (
      Some { value: a_pre } => (
        match b.pre (
          Some { value: b_pre } => (
            if a_pre < b_pre (
              0
            ) else if a_pre > b_pre (
              2
            ) else (
              1
            )
          ),
          None => 0,
        )
      ),
      None => (
        match b.pre (
          Some { value: _ } => 2,
          None => 1,
        )
      ),
    )
  )
)

fn candidate_entries(entries: Array[IndexEntry], request: DependencyRequest) -> Array[IndexEntry] (
  entries
    .filter((entry) =>
      !entry.yanked &&
      matches_semver(request.version_req, parse_semver_version(entry.vers))
    )
    .to_array()
)

fn highest_version(entries: Array[IndexEntry]) -> IndexEntry (
  array_fold(
    array_rest(entries),
    array_first(entries),
    ((best, entry) =>
      if compare_semver(parse_semver_version(entry.vers), parse_semver_version(best.vers)) == 2 (
        entry
      ) else (
        best
      )
    ),
  )
)

fn sorted_candidate_versions(entries: Array[IndexEntry]) -> Array[String] (
  match entries.find((_item) => true) (
    Some { value: _ } => (
      let best = highest_version(entries);
      [
        best.vers,
        ..sorted_candidate_versions(entries.filter($.vers != best.vers).to_array()),
      ]
    ),
    None => [],
  )
)

fn ordered_candidate_versions(
  entries: Array[IndexEntry],
  request: DependencyRequest,
  lock: LockedPackage?,
) -> Array[String] (
  let sorted = sorted_candidate_versions(candidate_entries(entries, request));
  match lock (
    Some { value } => (
      if sorted.any($ == value.version) (
        [value.version, ..sorted.filter($ != value.version).to_array()]
      ) else (
        sorted
      )
    ),
    None => sorted,
  )
)

fn parse_cfg_expr(s: String) -> CfgExpr (
  let trimmed = trim_spaces(s);
  if trimmed.starts_with("all(") && trimmed.ends_with(")") (
    let end = trimmed.len() - 1;
    CfgExpr.All {
      exprs:
        split_top_level_args(trimmed.slice(4..end))
          .map(parse_cfg_expr($))
          .to_array(),
    }
  ) else if trimmed.starts_with("any(") && trimmed.ends_with(")") (
    let end = trimmed.len() - 1;
    CfgExpr.Any {
      exprs:
        split_top_level_args(trimmed.slice(4..end))
          .map(parse_cfg_expr($))
          .to_array(),
    }
  ) else if trimmed.starts_with("not(") && trimmed.ends_with(")") (
    let end = trimmed.len() - 1;
    CfgExpr.Not {
      expr: parse_cfg_expr(trimmed.slice(4..end)),
    }
  ) else (
    match trimmed.split_once("=") (
      Some { value } => (
        let (key, value) = value;
        CfgExpr.KeyValue {
          key: trim_spaces(key),
          value: unquote(trim_spaces(value)),
        }
      ),
      None => CfgExpr.Name {
        name: trimmed,
      },
    )
  )
)

fn parse_target_selector(s: String) -> TargetSelector (
  if s.starts_with("cfg(") (
    let end = s.len() - 1;
    TargetSelector.Cfg {
      expr: parse_cfg_expr(s.slice(4..end)),
    }
  ) else (
    TargetSelector.Triple { triple: s }
  )
)

fn cfg_matches(target: BuildTarget, expr: CfgExpr) -> Bool (
  match expr (
    CfgExpr.Name { name } => target.cfg.any((fact) => (
      match fact (
        CfgFact.Name { name: value } => value == name,
        CfgFact.KeyValue { key: _, value: _ } => false,
      )
    )),
    CfgExpr.KeyValue { key, value } => target.cfg.any((fact) => (
      match fact (
        CfgFact.Name { name: _ } => false,
        CfgFact.KeyValue {
          key: fact_key,
          value: fact_value,
        } => fact_key == key && fact_value == value,
      )
    )),
    CfgExpr.Not { expr } => !cfg_matches(target, expr),
    CfgExpr.Any { exprs } => exprs.any(cfg_matches(target, $)),
    CfgExpr.All { exprs } => !exprs.any(!cfg_matches(target, $)),
  )
)

fn selector_matches(target: BuildTarget, selector: TargetSelector) -> Bool (
  match selector (
    TargetSelector.Triple { triple } => target.triple == triple,
    TargetSelector.Cfg { expr } => cfg_matches(target, expr),
  )
)

fn trim_spaces(s: String) -> String (
  if s.starts_with(" ") (
    trim_spaces(s.slice(1..))
  ) else if s.ends_with(" ") (
    let end = s.len() - 1;
    trim_spaces(s.slice(0..end))
  ) else (
    s
  )
)

fn unquote(s: String) -> String (
  if s.starts_with("\"") && s.ends_with("\"") (
    let end = s.len() - 1;
    s.slice(1..end)
  ) else (
    s
  )
)

fn split_top_level_args_rec(
  s: String,
  idx: U64,
  depth: U64,
  start: U64,
  acc: Array[String],
) -> Array[String] (
  if idx == s.len() (
    [..acc, trim_spaces(s.slice(start..idx))]
  ) else (
    let ch = s.slice(idx..idx + 1);
    if ch == "(" (
      split_top_level_args_rec(s, idx + 1, depth + 1, start, acc)
    ) else if ch == ")" (
      split_top_level_args_rec(s, idx + 1, depth - 1, start, acc)
    ) else if ch == "," && depth == 0 (
      split_top_level_args_rec(
        s,
        idx + 1,
        depth,
        idx + 1,
        [..acc, trim_spaces(s.slice(start..idx))],
      )
    ) else (
      split_top_level_args_rec(s, idx + 1, depth, start, acc)
    )
  )
)

fn split_top_level_args(s: String) -> Array[String] (
  if trim_spaces(s).is_empty() (
    []
  ) else (
    split_top_level_args_rec(s, 0, 0, 0, [])
  )
)

fn target_requests(selector: String, table: CargoTargetTable) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  target_requests_at_with_workspace(selector, table, @., %{}) where { target }
)

fn target_requests_with_workspace(
  selector: String,
  table: CargoTargetTable,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  target_requests_at_with_workspace(selector, table, @., workspace_dependencies) where { target }
)

fn target_requests_at_with_workspace(
  selector: String,
  table: CargoTargetTable,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  if selector_matches(target, parse_target_selector(selector)) (
    package_target_requests_at_with_workspace(selector, table, manifest_root, workspace_dependencies)
  ) else (
    []
  )
)

fn package_target_requests_at_with_workspace(
  selector: String,
  table: CargoTargetTable,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) -> Array[DependencyRequest] (
  [
    ..table.dependencies
      .map((name, dep) => (
        let req =
          request_from_dep_at_with_workspace(
            name,
            dep,
            "normal",
            manifest_root,
            workspace_dependencies,
          );
        DependencyRequest { ..req, target: selector }
      ))
      .to_array(),
    ..table.build_dependencies
      .map((name, dep) => (
        let req =
          request_from_dep_at_with_workspace(
            name,
            dep,
            "build",
            manifest_root,
            workspace_dependencies,
          );
        DependencyRequest { ..req, target: selector }
      ))
      .to_array(),
  ]
)

fn root_target_requests_at_with_workspace(
  selector: String,
  table: CargoTargetTable,
  manifest_root: Path,
  workspace_dependencies: Map[String, CargoDependencySpec],
) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  if selector_matches(target, parse_target_selector(selector)) (
    package_target_requests_at_with_workspace(selector, table, manifest_root, workspace_dependencies)
  ) else (
    []
  )
)

fn workspace_root_dependencies_from_blob(blob: Blob) -> Map[String, CargoDependencySpec] (
  match Toml.parse[CargoWorkspaceRootManifest](blob).workspace (
    Some { value } => value.dependencies,
    None => %{},
  )
)

fn workspace_root_dependencies(workspace: Tree) -> Map[String, CargoDependencySpec] (
  workspace_root_dependencies_from_blob(workspace.file(@Cargo.toml))
)

fn workspace_root_package_from_blob(blob: Blob) -> CargoWorkspacePackage? (
  match Toml.parse[CargoWorkspaceRootManifest](blob).workspace (
    Some { value } => value.package,
    None => None,
  )
)

fn workspace_root_package(workspace: Tree) -> CargoWorkspacePackage? (
  workspace_root_package_from_blob(workspace.file(@Cargo.toml))
)

fn resolve_inherited_string(
  value: CargoInheritedString?,
  workspace_value: String?,
  field: String,
) -> String (
  match value (
    Some { value } => (
      match value (
        CargoInheritedString.Value { value } => value,
        CargoInheritedString.Workspace { workspace } => (
          if workspace (
            match workspace_value (
              Some { value } => value,
              None => fail WorkspacePackageFieldMissing { field },
            )
          ) else (
            fail WorkspacePackageFieldMissing { field }
          )
        ),
      )
    ),
    None => (
      match workspace_value (
        Some { value } => value,
        None => fail WorkspacePackageFieldMissing { field },
      )
    ),
  )
)

fn package_version(package: CargoPackage, workspace_package: CargoWorkspacePackage?) -> String (
  let inherited =
    match workspace_package (
      Some { value } => value.version,
      None => None,
    );
  resolve_inherited_string(Some(package.version), inherited, "version")
)

fn package_edition(package: CargoPackage, workspace_package: CargoWorkspacePackage?) -> String (
  let inherited =
    match workspace_package (
      Some { value } => value.edition,
      None => None,
    );
  resolve_inherited_string(package.edition, inherited, "edition")
)

fn request_from_index_dep(dep: IndexDependency) -> DependencyRequest (
  DependencyRequest {
    name: dep.name,
    package_name: dep.package,
    version_req: Some(parse_semver_req(dep.req)),
    features: dep.features,
    default_features: dep.default_features,
    optional: dep.optional,
    kind: dep.kind.unwrap_or("normal"),
    target: dep.target,
    source: DependencySource.Registry,
  }
)

fn dependency_target_matches(target: BuildTarget, dep: DependencyRequest) -> Bool (
  match dep.target (
    Some { value } => selector_matches(target, parse_target_selector(value)),
    None => true,
  )
)

enum FeatureEdge {
  struct Local {
    feature: String,
  },
  struct EnableDependency {
    dependency: String,
  },
  struct DependencyFeature {
    dependency: String,
    feature: String,
    weak: Bool = false,
  },
}

fn parse_feature_edge(s: String) -> FeatureEdge (
  if s.starts_with("dep:") (
    FeatureEdge.EnableDependency {
      dependency: s.slice(4..),
    }
  ) else (
    match s.split_once("/") (
      Some { value } => (
        let (dep, feat) = value;
        if dep.ends_with("?") (
          let end = dep.len() - 1;
          FeatureEdge.DependencyFeature {
            dependency: dep.slice(0..end),
            feature: feat,
            weak: true,
          }
        ) else (
          FeatureEdge.DependencyFeature {
            dependency: dep,
            feature: feat,
            weak: false,
          }
        )
      ),
      None => FeatureEdge.Local { feature: s },
    )
  )
)

fn append_unique_string(items: Array[String], value: String) -> Array[String] (
  if items.any($ == value) (
    items
  ) else (
    [..items, value]
  )
)

fn append_unique_dependency_feature(
  items: Array[ActivatedDependencyFeature],
  dependency: String,
  feature: String,
) -> Array[ActivatedDependencyFeature] (
  if items.any($.dependency == dependency && $.feature == feature) (
    items
  ) else (
    [
      ..items,
      ActivatedDependencyFeature {
        dependency,
        feature,
      },
    ]
  )
)

fn apply_feature_edge(
  state: FeatureExpansionState,
  feature_graph: Map[String, Array[String]],
  optional_dependencies: Array[String],
  edge_text: String,
) -> FeatureExpansionState (
  match parse_feature_edge(edge_text) (
    FeatureEdge.Local { feature } => (
      if !feature_graph.has(feature) && optional_dependencies.any($ == feature) (
        FeatureExpansionState {
          ..state,
          enabled_optional_deps: append_unique_string(state.enabled_optional_deps, feature),
        }
      ) else (
        FeatureExpansionState {
          ..state,
          pending: append_unique_string(state.pending, feature),
        }
      )
    ),
    FeatureEdge.EnableDependency { dependency } => FeatureExpansionState {
      ..state,
      enabled_optional_deps: append_unique_string(state.enabled_optional_deps, dependency),
    },
    FeatureEdge.DependencyFeature {
      dependency,
      feature,
      weak,
    } => (
      let _weak = weak;
      FeatureExpansionState {
        ..state,
        dependency_features: append_unique_dependency_feature(
          state.dependency_features,
          dependency,
          feature,
        ),
      }
    ),
  )
)

fn expand_features(
  feature_graph: Map[String, Array[String]],
  optional_dependencies: Array[String],
  pending: Array[String],
  seen: Array[String],
  enabled_optional_deps: Array[String],
  dependency_features: Array[ActivatedDependencyFeature],
) -> UnifiedFeatures (
  if pending == [] (
    UnifiedFeatures {
      local: seen,
      enabled_optional_deps,
      dependency_features,
    }
  ) else (
    let feature = array_first(pending);
    let rest = array_rest(pending);
    if seen.any($ == feature) (
      expand_features(
        feature_graph,
        optional_dependencies,
        rest,
        seen,
        enabled_optional_deps,
        dependency_features,
      )
    ) else (
      let edges =
        if feature_graph.has(feature) (
          feature_graph.get(feature)
        ) else (
          []
        );
      let folded =
        array_fold(
          edges,
          FeatureExpansionState {
            pending: rest,
            enabled_optional_deps,
            dependency_features,
          },
          ((state, edge_text) =>
            apply_feature_edge(state, feature_graph, optional_dependencies, edge_text)
          ),
        );
      expand_features(
        feature_graph,
        optional_dependencies,
        folded.pending,
        append_unique_string(seen, feature),
        folded.enabled_optional_deps,
        folded.dependency_features,
      )
    )
  )
)

fn optional_dependency_names(deps: Array[DependencyRequest]) -> Array[String] (
  array_fold(
    deps,
    [],
    ((acc, dep) =>
      if dep.optional (
        append_unique_string(acc, dep.name)
      ) else (
        acc
      )
    ),
  )
)

fn unify_features(
  feature_graph: Map[String, Array[String]],
  optional_dependencies: Array[String],
  request: DependencyRequest,
) -> UnifiedFeatures (
  let seeds =
    if request.default_features && feature_graph.has("default") (
      ["default", ..request.features]
    ) else (
      request.features
    );
  expand_features(feature_graph, optional_dependencies, seeds, [], [], [])
)

fn extend_dependency_features(dep: DependencyRequest, extra: Array[String]) -> DependencyRequest (
  DependencyRequest {
    name: dep.name,
    package_name: dep.package_name,
    version_req: dep.version_req,
    features: [..dep.features, ..extra],
    default_features: dep.default_features,
    optional: dep.optional,
    kind: dep.kind,
    target: dep.target,
    source: dep.source,
  }
)

fn dependency_feature_names(
  requested: Array[ActivatedDependencyFeature],
  dependency: String,
) -> Array[String] (
  array_fold(
    requested,
    [],
    ((acc, item) =>
      if item.dependency == dependency (
        array_push(acc, item.feature)
      ) else (
        acc
      )
    ),
  )
)

fn apply_feature_requests(deps: Array[DependencyRequest], features: UnifiedFeatures) -> Array[DependencyRequest] (
  array_fold(
    deps,
    [],
    ((acc, dep) =>
      if !dep.optional || features.enabled_optional_deps.any($ == dep.name) (
        let extra = dependency_feature_names(features.dependency_features, dep.name);
        array_push(acc, extend_dependency_features(dep, extra))
      ) else (
        acc
      )
    ),
  )
)

fn activate_package_facts(facts: PackageFacts, request: DependencyRequest) where {
  target: BuildTarget,
} -> ResolvedCrate (
  let dependencies =
    facts.dependencies
      .filter($.kind != "dev")
      .filter(dependency_target_matches(target, $))
      .to_array();
  let features = unify_features(
    facts.feature_graph,
    optional_dependency_names(dependencies),
    request,
  );

  ResolvedCrate {
    id: facts.id,
    name: facts.name,
    version: facts.version,
    source: facts.source,
    features: features.local,
    dependencies: apply_feature_requests(dependencies, features),
  }
)

fn package_request_key(req: DependencyRequest) -> String (
  dependency_request_source_key(req)
)

fn dependency_source_key(source: DependencySource) -> String (
  match source (
    DependencySource.Registry => fail "dependency_source_key requires a concrete non-registry source",
    DependencySource.LocalPath { base, path } => `path:{(base / Path(path)).to_string()}`,
    DependencySource.Git { url, rev } => (
      match rev (
        Some { value } => `git:{url}#{value}`,
        None => `git:{url}`,
      )
    ),
  )
)

fn dependency_request_source_key(req: DependencyRequest) -> String (
  let source =
    match req.source (
      DependencySource.Registry => `registry:{req.package_name.unwrap_or(req.name)}`,
      DependencySource.LocalPath { base: _, path: _ } => dependency_source_key(req.source),
      DependencySource.Git { url: _, rev: _ } => dependency_source_key(req.source),
    );
  source
)

fn conjoin_semver(left: SemverReq?, right: SemverReq?) -> SemverReq? (
  match left (
    Some { value } => (
      match right (
        Some { value: other } => Some(
          SemverReq {
            comparators: [..value.comparators, ..other.comparators],
          }
        ),
        None => Some(value),
      )
    ),
    None => right,
  )
)

fn merge_requests(existing: DependencyRequest, incoming: DependencyRequest) -> DependencyRequest (
  DependencyRequest {
    ..existing,
    version_req: conjoin_semver(existing.version_req, incoming.version_req),
    features: [..existing.features, ..incoming.features],
    default_features: existing.default_features || incoming.default_features,
    optional: existing.optional && incoming.optional,
  }
)

fn merge_joined_requests(requests: Array[DependencyRequest]) -> DependencyRequest (
  array_fold(array_rest(requests), array_first(requests), merge_requests)
)

fn canonical_request_insert(
  acc: Map[String, DependencyRequest],
  req: DependencyRequest,
) -> Map[String, DependencyRequest] (
  let key = package_request_key(req);
  if acc.has(key) (
    map_put(acc, key, merge_requests(acc.get(key), req))
  ) else (
    map_put(acc, key, req)
  )
)

fn dependency_request_values(
  requests: Map[String, DependencyRequest],
) -> Array[DependencyRequest] (
  requests.map((key, value) => value)
)

fn canonical_requests(requests: Array[DependencyRequest]) -> Array[DependencyRequest] (
  dependency_request_values(array_fold(requests, %{}, canonical_request_insert))
)

fn demand_package(request: DependencyRequest) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> ResolvedCrate (
  keyed(
    package_request_key(request),
    [request],
    ((ctx) => resolve_package_node(ctx) where {
      config,
      lock,
      target,
      workspace,
    }),
  )
)

fn demand_dependency_package(
  ok: Bool,
  dep: DependencyRequest,
) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> Bool (
  let _package = demand_package(dep) where { config, lock, target, workspace };
  ok
)

fn validate_package_graph(crate: ResolvedCrate) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> ResolvedCrate (
  let _validated =
    array_fold(
      canonical_requests(crate.dependencies),
      true,
      ((ok, dep) => demand_dependency_package(ok, dep) where {
        config,
        lock,
        target,
        workspace,
      }),
    );
  crate
)

fn resolve_non_registry_package_node(request: DependencyRequest) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> ResolvedCrate (
  let facts =
    keyed(
      package_facts_key(request.source),
      [request.source],
      ((ctx) => resolve_non_registry_facts(array_first(ctx.joined)) where { workspace }),
    );
  let crate = activate_package_facts(facts, request) where { target };
  validate_package_graph(crate) where {
    config,
    lock,
    target,
    workspace,
  }
)

fn resolve_package_node(ctx) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> ResolvedCrate (
  let request = merge_joined_requests(ctx.joined);
  match request.source (
    DependencySource.Registry =>
      search_registry_candidate(request) where {
        config,
        lock,
        target,
        workspace,
      },
    DependencySource.LocalPath { base: _, path: _ } =>
      resolve_non_registry_package_node(request) where {
        config,
        lock,
        target,
        workspace,
      },
    DependencySource.Git { url: _, rev: _ } =>
      resolve_non_registry_package_node(request) where {
        config,
        lock,
        target,
        workspace,
      },
  )
)

fn materialize_package_graph(
  state: MaterializedGraphState,
  crate: ResolvedCrate,
) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> MaterializedGraphState (
  if state.packages.has(crate.id.value) (
    state
  ) else (
    let dependencies =
      canonical_requests(crate.dependencies)
        .map((dep) => demand_package(dep) where { config, lock, target, workspace })
        .to_array();
    let with_crate =
      MaterializedGraphState {
        ..state,
        packages: map_put(
          state.packages,
          crate.id.value,
          ResolvedCrate {
            ..crate,
            resolved_dependencies: dependencies.map($.id).to_array(),
          },
        ),
      };
    array_fold(
      dependencies,
      with_crate,
      ((acc, package) => (
        materialize_package_graph(acc, package) where {
          config,
          lock,
          target,
          workspace,
        }
      )),
    )
  )
)

fn materialize_resolution(
  roots: Array[ResolvedCrate],
) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> RegistryResolution (
  let state =
    array_fold(
      roots,
      MaterializedGraphState {
        packages: %{},
      },
      ((acc, root) => (
        materialize_package_graph(acc, root) where {
          config,
          lock,
          target,
          workspace,
        }
      )),
    );
  RegistryResolution {
    roots: roots.map($.id).to_array(),
    packages: state.packages.map((key, value) => value),
  }
)

fn demand_root_packages(roots: Array[DependencyRequest]) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> Array[ResolvedCrate] (
  canonical_requests(roots)
    .map(demand_package($) where { config, lock, target, workspace })
    .to_array()
)

fn demand_graph(roots: Array[DependencyRequest]) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> Array[PackageId] (
  (demand_root_packages(roots) where { config, lock, target, workspace })
    .map($.id)
    .to_array()
)

fn lock_entry(lock: CargoLock?, name: String) -> LockedPackage? (
  match lock (
    Some { value } => value.package.find($.name == name),
    None => None,
  )
)

fn version_assumption_name(request: DependencyRequest) -> String (
  `version:{package_request_key(request)}`
)

fn registry_entries_key(package_name: String) -> String (
  `entries:registry:{package_name}`
)

fn registry_candidates_key(request: DependencyRequest) -> String (
  `candidates:{package_request_key(request)}`
)

fn registry_entry_key(package_name: String, version: String) -> String (
  `entry:registry:{package_name}@{version}`
)

fn package_facts_key(source: DependencySource) -> String (
  `facts:{dependency_source_key(source)}`
)

fn registry_candidate_facts_key(package_name: String, version: String) -> String (
  `candidate:registry:{package_name}@{version}`
)

fn registry_candidate_package_key(request: DependencyRequest, version: String) -> String (
  `package:{package_request_key(request)}:{version}`
)

fn resolve_registry_entries(package_name: String) -> Array[IndexEntry] (
  parse_sparse_entries(Http.get(sparse_index_url(package_name)))
)

fn demand_registry_entries(package_name: String) -> Array[IndexEntry] (
  keyed(
    registry_entries_key(package_name),
    [package_name],
    ((ctx) => resolve_registry_entries(array_first(ctx.joined))),
  )
)

fn resolve_registry_candidates(request: DependencyRequest) where {
  lock: CargoLock?,
} -> Array[String] (
  let package_name = request.package_name.unwrap_or(request.name);
  let entries = demand_registry_entries(package_name);
  ordered_candidate_versions(entries, request, lock_entry(lock, package_name))
)

fn resolve_registry_candidate_versions(request: DependencyRequest) where {
  lock: CargoLock?,
} -> Array[String] (
  keyed(
    registry_candidates_key(request),
    [request],
    ((ctx) => resolve_registry_candidates(merge_joined_requests(ctx.joined)) where { lock }),
  )
)

fn resolve_registry_entry(package_name: String, version: String) -> IndexEntry (
  let entries = demand_registry_entries(package_name);

  match entries.find($.vers == version) (
    Some { value } => value,
    None =>
      fail Conflict {
        package: package_name,
        version: version,
        reason: "missing-candidate",
      },
  )
)

fn resolve_registry_candidate_facts(chosen: IndexEntry) where {
  config: SparseConfig,
} -> PackageFacts (
  let dependencies =
    chosen.deps
      .map(request_from_index_dep($))
      .to_array();
  let source =
    ResolvedSource.Registry {
      checksum: chosen.cksum,
      download_url: crate_download_url(config, chosen.name, chosen.vers, chosen.cksum),
    };

  PackageFacts {
    id: PackageId(`registry:{chosen.name}@{chosen.vers}`),
    name: chosen.name,
    version: chosen.vers,
    source,
    feature_graph: merged_entry_features(chosen),
    dependencies,
  }
)

fn resolve_registry_candidate_package(request: DependencyRequest, version: String) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} -> ResolvedCrate (
  let package_name = request.package_name.unwrap_or(request.name);
  let chosen =
    keyed(
      registry_entry_key(package_name, version),
      [version],
      ((ctx) => resolve_registry_entry(package_name, array_first(ctx.joined))),
    );
  let facts =
    keyed(
      registry_candidate_facts_key(package_name, version),
      [version],
      ((ctx) => resolve_registry_candidate_facts(chosen) where { config }),
    );
  let crate = activate_package_facts(facts, request) where { target };
  validate_package_graph(crate) where {
    config,
    lock,
    target,
    workspace,
  }
)

fn search_registry_candidate(request: DependencyRequest) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> ResolvedCrate (
  let package_name = request.package_name.unwrap_or(request.name);
  let candidates = resolve_registry_candidate_versions(request) where { lock };

  match candidates.find((_item) => true) (
    Some { value: _ } => (
      search_assumption(
        version_assumption_name(request),
        candidates,
        (() => (
          let version = branch_assumption(version_assumption_name(request));
          keyed(
            registry_candidate_package_key(request, version),
            [request],
            ((ctx) => resolve_registry_candidate_package(merge_joined_requests(ctx.joined), version) where {
              config,
              lock,
              target,
              workspace,
            }),
          )
        )),
      )
    ),
    None =>
      fail Conflict {
        package: package_name,
        request: request,
        reason: "no-candidate",
      },
  )
)

fn resolve_non_registry_facts(source: DependencySource) where {
  workspace: Tree,
} #discover -> PackageFacts (
  let workspace_package = workspace_root_package(workspace);

  match source (
    DependencySource.LocalPath { base, path } => (
      let dep_root = base / Path(path);
      let dep_manifest = Toml.parse[CargoManifest](workspace.file(dep_root / @Cargo.toml));
      let dependency_requests =
        package_dependency_requests_at_with_workspace(
          dep_manifest,
          dep_root,
          workspace_root_dependencies(workspace),
        );
      let source = ResolvedSource.LocalPath { path: dep_root };

      PackageFacts {
        id: PackageId(`path:{dep_root.to_string()}`),
        name: dep_manifest.package.name,
        version: package_version(dep_manifest.package, workspace_package),
        source,
        feature_graph: dep_manifest.features,
        dependencies: dependency_requests,
      }
    ),
    DependencySource.Git { url, rev } => (
      let exact_rev =
        match rev (
          Some { value } => value,
          None => fail "git dependency resolution without explicit rev omitted from sketch",
        );
      let dep_manifest = Toml.parse[CargoManifest](Http.get(github_raw_manifest_url(url, exact_rev)));
      let dependency_requests = package_dependency_requests_at_with_workspace(dep_manifest, @., %{});
      let source =
        ResolvedSource.Git {
          url,
          rev: exact_rev,
          checksum: None,
          archive_url: Some(github_archive_url(url, exact_rev)),
        };

      PackageFacts {
        id: PackageId(`git:{url}#{exact_rev}`),
        name: dep_manifest.package.name,
        version: package_version(dep_manifest.package, None),
        source,
        feature_graph: dep_manifest.features,
        dependencies: dependency_requests,
      }
    ),
    DependencySource.Registry => fail "resolve_non_registry_facts called for registry request",
  )
)

fn resolve_request(request: DependencyRequest) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> ResolvedCrate (
  demand_package(request) where { config, lock, target, workspace }
)

fn resolve_manifest(manifest: CargoManifest) where {
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> RegistryResolution (
  resolve_manifest_at(manifest, @.) where { lock, target, workspace }
)

fn resolve_manifest_at(manifest: CargoManifest, manifest_root: Path) where {
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> RegistryResolution (
  let config = Json.parse[SparseConfig](Http.get("https://index.crates.io/config.json"));
  let requests =
    root_requests_at_with_workspace(manifest, manifest_root, workspace_root_dependencies(workspace))
      where { target };
  let roots = demand_root_packages(requests) where { config, lock, target, workspace };
  materialize_resolution(roots) where { config, lock, target, workspace }
)

fn resolve_workspace_member_at(workspace: Tree, member_root: Path) where {
  lock: CargoLock?,
  target: BuildTarget,
} #discover -> RegistryResolution (
  let manifest = Toml.parse[CargoManifest](workspace.file(member_root / @Cargo.toml));
  resolve_manifest_at(manifest, member_root) where { lock, target, workspace }
)

fn demand_manifest(manifest: CargoManifest) where {
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> Array[PackageId] (
  demand_manifest_at(manifest, @.) where { lock, target, workspace }
)

fn demand_manifest_at(manifest: CargoManifest, manifest_root: Path) where {
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> Array[PackageId] (
  let config = Json.parse[SparseConfig](Http.get("https://index.crates.io/config.json"));
  let requests =
    root_requests_at_with_workspace(manifest, manifest_root, workspace_root_dependencies(workspace))
      where { target };
  demand_graph(requests) where { config, lock, target, workspace }
)

fn demand_workspace_member_at(workspace: Tree, member_root: Path) where {
  lock: CargoLock?,
  target: BuildTarget,
} #discover -> Array[PackageId] (
  let manifest = Toml.parse[CargoManifest](workspace.file(member_root / @Cargo.toml));
  demand_manifest_at(manifest, member_root) where { lock, target, workspace }
)

fn github_repo_path(url: String) -> String (
  if !url.starts_with("https://github.com/") (
    fail "git dependency resolution only supports https://github.com URLs in sketch"
  ) else (
    let repo = url.slice(19..);
    if repo.ends_with(".git") (
      let end = repo.len() - 4;
      repo.slice(0..end)
    ) else (
      repo
    )
  )
)

fn github_raw_manifest_url(url: String, rev: String) -> String (
  let repo = github_repo_path(url);
  `https://raw.githubusercontent.com/{repo}/{rev}/Cargo.toml`
)

fn github_archive_url(url: String, rev: String) -> String (
  let repo = github_repo_path(url);
  `https://codeload.github.com/{repo}/tar.gz/{rev}`
)

fn emit_lockfile(resolution: RegistryResolution) -> Blob (
  Toml.serialize(CargoLock {
    package:
      resolution.packages
        .map((pkg) => LockedPackage {
          name: pkg.name,
          version: pkg.version,
          source:
            match pkg.source (
              ResolvedSource.Registry { checksum: _, download_url: _ } =>
                "registry+https://github.com/rust-lang/crates.io-index",
              ResolvedSource.Git { url, rev, checksum: _, archive_url: _ } =>
                `git+${url}#${rev}`,
              ResolvedSource.LocalPath { path: _ } => None,
            ),
          checksum:
            match pkg.source (
              ResolvedSource.Registry { checksum, download_url: _ } => checksum,
              ResolvedSource.Git { url: _, rev: _, checksum, archive_url: _ } => checksum,
              ResolvedSource.LocalPath { path: _ } => None,
            ),
        })
        .to_array(),
  })
)

fn crate_source(pkg: ResolvedCrate) where {
  workspace_root: Path,
} -> Tree (
  match pkg.source (
    ResolvedSource.Registry { checksum, download_url } => (
      acquire(download_url) where {
        digest: `sha256:{checksum}`,
        extract: "tar.gz",
      }
    ),
    ResolvedSource.LocalPath { path } => Tree(workspace_root / path),
    ResolvedSource.Git { url, rev, checksum, archive_url } => (
      let _url = url;
      let _rev = rev;
      let _checksum = checksum;
      let _archive_url = archive_url;
      fail "git source acquisition omitted from sketch"
    ),
  )
)

fn vendored_entry(pkg: ResolvedCrate) where {
  workspace_root: Path,
} -> (Path, Tree) (
  let name = pkg.name;
  let version = pkg.version;
  (Path(`{name}-{version}`), crate_source(pkg) where { workspace_root })
)

fn resolution_package(
  resolution: RegistryResolution,
  id: PackageId,
) -> ResolvedCrate (
  match resolution.packages.find(($.id == id)) (
    Some { value } => value,
    None => fail `missing package {id.value} in materialized resolution`,
  )
)

fn rust_crate_name(name: String) -> String (
  name.replace("-", "_")
)

fn compile_mount(crate_name: String) -> Path (
  Path(crate_name)
)

fn compile_output_name(crate_name: String) -> Path (
  Path(`lib{crate_name}.rlib`)
)

fn compile_dep_mounts(artifacts: Array[CompiledRustArtifact]) -> Map[Path, Tree] (
  array_fold(
    artifacts,
    %{},
    ((acc, artifact) => map_put(acc, compile_mount(artifact.crate_name), artifact.tree)),
  )
)

fn compile_dep_args(artifacts: Array[CompiledRustArtifact]) -> Array[String] (
  array_fold(
    artifacts,
    [],
    ((acc, artifact) => (
      let mount = compile_mount(artifact.crate_name).to_string();
      let output = compile_output_name(artifact.crate_name).to_string();
      [
        ..acc,
        "-L",
        `dependency={mount}/out`,
        "--extern",
        `{artifact.crate_name}={mount}/out/{output}`,
      ]
    )),
  )
)

fn compile_rust_library(pkg: ResolvedCrate, resolution: RegistryResolution) where {
  workspace_root: Path,
  rustc: ExecPath,
} #discover -> CompiledRustArtifact (
  let crate_name = rust_crate_name(pkg.name);
  let source = crate_source(pkg) where { workspace_root };
  let manifest = Toml.parse[CargoManifest](source.file(@Cargo.toml));
  let edition = package_edition(manifest.package, workspace_root_package(Tree(workspace_root)));
  let dep_artifacts =
    pkg.resolved_dependencies
      .map((id) => compile_rust_library(resolution_package(resolution, id), resolution) where {
        workspace_root,
        rustc,
      })
      .to_array();
  let dep_mounts = compile_dep_mounts(dep_artifacts);
  let dep_args = compile_dep_args(dep_artifacts);

  match source.file(@src/lib.rs)? (
    Some { value: _ } => (
      let tree =
        exec [
          rustc,
          @crate/src/lib.rs,
          "--crate-name",
          crate_name,
          "--crate-type",
          "lib",
          "--edition",
          edition,
          "-o",
          Path("out") / compile_output_name(crate_name),
          ..dep_args,
        ] where {
          mounts: map_put(dep_mounts, @crate, source),
          writable: [@out],
          observer: (proc, vfs) => (
            if proc.exit_code != 0 (
              fail `rustc failed compiling library {pkg.name}: {proc.stderr.collect().utf8_lossy()}`
            ) else (
              vfs
            )
          ),
        };
      CompiledRustArtifact {
        package_id: pkg.id,
        crate_name,
        mount: compile_mount(crate_name),
        tree,
      }
    ),
    None => fail `package {pkg.name} does not have src/lib.rs`,
  )
)

fn maybe_compile_with_rustc(
  manifest_root: Path,
  manifest: CargoManifest,
  resolution: RegistryResolution,
  workspace_root: Path,
) #discover -> Tree? (
  let non_local =
    resolution.packages.any((pkg) => (
      match pkg.source (
        ResolvedSource.LocalPath { path: _ } => false,
        ResolvedSource.Registry { checksum: _, download_url: _ } => true,
        ResolvedSource.Git { url: _, rev: _, checksum: _, archive_url: _ } => true,
      )
    ));

  if non_local (
    None
  ) else (
    let class = executor_class("default");
    let rustc = discover(class, (host) => host.which("rustc"));
    let source = Tree(workspace_root / manifest_root);
    let edition = package_edition(manifest.package, workspace_root_package(Tree(workspace_root)));
    let dep_artifacts =
      resolution.roots
        .map((id) => compile_rust_library(resolution_package(resolution, id), resolution) where {
          workspace_root,
          rustc,
        })
        .to_array();
    let dep_mounts = compile_dep_mounts(dep_artifacts);
    let dep_args = compile_dep_args(dep_artifacts);

    match source.file(@src/main.rs)? (
      Some { value: _ } => (
        Some(
          exec [
            rustc,
            @crate/src/main.rs,
            "--crate-name",
            rust_crate_name(manifest.package.name),
            "--edition",
            edition,
            "-o",
            Path("out") / Path(manifest.package.name),
            ..dep_args,
          ] where {
            mounts: map_put(dep_mounts, @crate, source),
            writable: [@out],
            observer: (proc, vfs) => (
              if proc.exit_code != 0 (
                fail `rustc failed compiling binary {manifest.package.name}: {proc.stderr.collect().utf8_lossy()}`
              ) else (
                vfs.subtree(@out)
              )
            ),
          }
        )
      ),
      None => None,
    )
  )
)

fn build(ws: Path, args: Array[String], env: Map[String, String]) #fs #discover -> Tree (
  let workspace = Tree(ws);
  let lock = parse_lock(workspace);
  let target = BuildTarget {
    // Sketch only:
    // a real implementation would derive this from the selected build target,
    // executor class, or explicit CLI/config inputs.
    triple: "x86_64-unknown-linux-gnu",
    cfg: [],
  };

  let (manifest_root, manifest) =
    match args.find((_item) => true) (
      Some { value } => (
        let manifest_root = Path(value);
        let manifest = Toml.parse[CargoManifest](workspace.file(manifest_root / @Cargo.toml));
        (manifest_root, manifest)
      ),
      None => (
        let manifest_root = @.;
        let manifest = Toml.parse[CargoManifest](workspace.file(@Cargo.toml));
        (manifest_root, manifest)
      ),
    );
  let resolution =
    resolve_manifest_at(manifest, manifest_root) where { lock, target, workspace };

  // Resolution discovers exact versions and checksums.
  // Acquisition stays fixed-hash and cacheable.
  let vendor =
    Tree(
      array_fold(resolution.packages, %{}, (acc, pkg) => (
        let (path, tree) = vendored_entry(pkg) where { workspace_root: ws };
        map_put(acc, path, tree)
      ))
    );
  let lock_blob = emit_lockfile(resolution);
  let _env = env;
  let compiled = maybe_compile_with_rustc(manifest_root, manifest, resolution, ws);

  match compiled (
    Some { value } => Tree %{
      @vendor => vendor,
      @Cargo.lock => lock_blob,
      @out => value,
    },
    None => Tree %{
      @vendor => vendor,
      @Cargo.lock => lock_blob,
    },
  )
)
