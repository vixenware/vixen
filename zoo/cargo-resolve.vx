// Cargo-style dependency resolution sketch
//
// This is not a Cargo builtin. The only ambient pieces are:
// - Http.get(url)
// - Toml.parse[T](blob)
// - Toml.serialize(value)
// - Json.parse[T](blob)
//
// Everything else is ordinary Vixen code over those primitives.

#[untagged]
enum CargoDependencySpec {
  struct Version {
    value: String,
  },

  #[rename_all = "kebab-case"]
  struct Detailed {
    version: String?,
    features: Array[String] = [],
    default_features: Bool = true,
    optional: Bool = false,
    path: String?,
    git: String?,
    package: String?,
  },
}

#[rename_all = "kebab-case"]
struct CargoManifest {
  package: CargoPackage,
  dependencies: Map[String, CargoDependencySpec] = %{},
  dev_dependencies: Map[String, CargoDependencySpec] = %{},
  build_dependencies: Map[String, CargoDependencySpec] = %{},
  features: Map[String, Array[String]] = %{},
  target: Map[String, CargoTargetTable] = %{},
}

struct CargoPackage {
  name: String,
  version: String,
  edition: String = "2021",
}

#[rename_all = "kebab-case"]
struct CargoTargetTable {
  dependencies: Map[String, CargoDependencySpec] = %{},
  dev_dependencies: Map[String, CargoDependencySpec] = %{},
  build_dependencies: Map[String, CargoDependencySpec] = %{},
}

struct CargoLock {
  package: Array[LockedPackage] = [],
}

struct LockedPackage {
  name: String,
  version: String,
  source: String?,
  checksum: String?,
}

struct DependencyRequest {
  name: String,
  package_name: String?,
  version_req: SemverReq?,
  features: Array[String] = [],
  default_features: Bool = true,
  optional: Bool = false,
  kind: String = "normal",
  target: String?,
  source: DependencySource = DependencySource.Registry,
}

struct SemverVersion {
  major: U64,
  minor: U64,
  patch: U64,
  pre: String?,
}

enum ComparatorOp {
  struct Exact,
  struct Greater,
  struct GreaterEq,
  struct Less,
  struct LessEq,
  struct Caret,
  struct Tilde,
}

struct Comparator {
  op: ComparatorOp,
  version: SemverVersion,
}

struct SemverReq {
  comparators: Array[Comparator],
}

struct ActivatedDependencyFeature {
  dependency: String,
  feature: String,
}

struct UnifiedFeatures {
  local: Array[String] = [],
  enabled_optional_deps: Array[String] = [],
  dependency_features: Array[ActivatedDependencyFeature] = [],
}

struct FeatureExpansionState {
  pending: Array[String] = [],
  enabled_optional_deps: Array[String] = [],
  dependency_features: Array[ActivatedDependencyFeature] = [],
}

struct BuildTarget {
  triple: String,
  cfg: Array[CfgFact] = [],
}

enum CfgFact {
  struct Name {
    name: String,
  },
  struct KeyValue {
    key: String,
    value: String,
  },
}

enum CfgExpr {
  struct Name {
    name: String,
  },
  struct KeyValue {
    key: String,
    value: String,
  },
  struct Not {
    expr: CfgExpr,
  },
  struct Any {
    exprs: Array[CfgExpr],
  },
  struct All {
    exprs: Array[CfgExpr],
  },
}

enum TargetSelector {
  struct Triple {
    triple: String,
  },
  struct Cfg {
    expr: CfgExpr,
  },
}

enum DependencySource {
  struct Registry,
  struct Path {
    path: String,
  },
  struct Git {
    url: String,
  },
}

struct IndexDependency {
  name: String,
  req: String,
  package: String?,
  features: Array[String] = [],
  optional: Bool = false,
  default_features: Bool = true,
  target: String?,
  kind: String?,
}

struct IndexEntry {
  name: String,
  vers: String,
  cksum: String,
  features: Map[String, Array[String]] = %{},
  features2: Map[String, Array[String]] = %{},
  yanked: Bool = false,
  deps: Array[IndexDependency] = [],
}

struct SparseConfig {
  dl: String,
}

newtype PackageId of String

struct ResolvedCrate {
  id: PackageId,
  name: String,
  version: String,
  source: ResolvedSource,
  features: Array[String] = [],
  dependencies: Array[DependencyRequest] = [],
}

enum ResolvedSource {
  struct Registry {
    checksum: String,
    download_url: String,
  },
  struct Path {
    path: String,
  },
  struct Git {
    url: String,
    rev: String,
    checksum: String?,
    archive_url: String?,
  },
}

struct RegistryResolution {
  roots: Array[PackageId],
  packages: Array[ResolvedCrate],
}

fn parse_lock(ws: Tree) -> CargoLock? (
  match ws.file(@Cargo.lock)? (
    Some { value } => Toml.parse[CargoLock](value),
    None => None,
  )
)

fn parse_sparse_entries(blob: Blob) -> Array[IndexEntry] (
  blob.utf8()
    .lines()
    .filter(!$.is_empty())
    .map(Json.parse[IndexEntry]($))
    .to_array()
)

fn merged_entry_features(entry: IndexEntry) -> Map[String, Array[String]] (
  array_fold(
    entry.features2.to_array(),
    entry.features,
    ((acc, pair) => map_put(acc, pair.get("key"), pair.get("value"))),
  )
)

fn sparse_index_url(name: String) -> String (
  // crates.io sparse index sharding is ordinary string logic:
  // - 1 char: `1/x`
  // - 2 chars: `2/xy`
  // - 3 chars: `3/x/xyz`
  // - 4+ chars: `ab/cd/abcdef`
  let lower = name.to_lower();
  let len = lower.len();

  let rel =
    if len == 1 (
      `1/{lower}`
    ) else (
      if len == 2 (
        `2/{lower}`
      ) else (
        if len == 3 (
          `3/{lower.slice(0..1)}/{lower}`
        ) else (
          `{lower.slice(0..2)}/{lower.slice(2..4)}/{lower}`
        )
      )
    );

  `https://index.crates.io/{rel}`
)

fn sparse_prefix(name: String) -> String (
  let len = name.len();
  if len == 1 (
    "1"
  ) else (
    if len == 2 (
      "2"
    ) else (
      if len == 3 (
        `3/{name.slice(0..1)}`
      ) else (
        `{name.slice(0..2)}/{name.slice(2..4)}`
      )
    )
  )
)

fn crate_download_url(config: SparseConfig, name: String, version: String, checksum: String) -> String (
  // Cargo's sparse config can provide a download template. If it contains
  // no placeholders, Cargo appends `/{crate}/{version}/download`.
  let prefix = sparse_prefix(name);
  let lowerprefix = sparse_prefix(name.to_lower());
  let template = config.dl;

  if (
    template.contains("{crate}") ||
    template.contains("{version}") ||
    template.contains("{prefix}") ||
    template.contains("{lowerprefix}") ||
    template.contains("{sha256-checksum}")
  ) (
    template
      .replace("{crate}", name)
      .replace("{version}", version)
      .replace("{prefix}", prefix)
      .replace("{lowerprefix}", lowerprefix)
      .replace("{sha256-checksum}", checksum)
  ) else (
    `{template}/{name}/{version}/download`
  )
)

fn manifest_requests(manifest: CargoManifest) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  [
    ..manifest.dependencies
      .map((name, dep) => request_from_dep(name, dep, "normal"))
      .to_array(),
    ..manifest.dev_dependencies
      .map((name, dep) => request_from_dep(name, dep, "dev"))
      .to_array(),
    ..manifest.build_dependencies
      .map((name, dep) => request_from_dep(name, dep, "build"))
      .to_array(),
    ..manifest.target
      .map((selector, table) => target_requests(selector, table) where { target })
      .flatten(),
  ]
)

fn request_from_dep(name: String, dep: CargoDependencySpec, kind: String) -> DependencyRequest (
  match dep (
    Version { value } => DependencyRequest {
      name,
      package_name: None,
      version_req: Some(parse_semver_req(value)),
      features: [],
      default_features: true,
      kind,
      optional: false,
      target: None,
      source: DependencySource.Registry,
    },
    Detailed {
      version,
      features,
      default_features,
      optional,
      path,
      git,
      package,
    } => (
      DependencyRequest {
        name,
        package_name: package,
        version_req:
          match version (
            Some { value } => Some(parse_semver_req(value)),
            None => None,
          ),
        features,
        default_features,
        optional,
        kind,
        target: None,
        source:
          match path (
            Some { value } => DependencySource.Path { path: value },
            None => (
              match git (
                Some { value } => DependencySource.Git { url: value },
                None => DependencySource.Registry,
              )
            ),
          ),
      }
    ),
  )
)

fn parse_semver_version(s: String) -> SemverVersion (
  let core_and_pre = s.split_once("-");
  let core =
    match core_and_pre (
      Some { value } => (
        let (value, _pre) = value;
        value
      ),
      None => s,
    );
  let pre =
    match core_and_pre (
      Some { value } => (
        let (_value, pre) = value;
        Some(pre)
      ),
      None => None,
    );
  match core.split_once(".") (
    Some { value } => (
      let (major, minor_patch) = value;
      match minor_patch.split_once(".") (
        Some { value } => (
          let (minor, patch) = value;
          SemverVersion {
            major: major.to_u64(),
            minor: minor.to_u64(),
            patch: patch.to_u64(),
            pre,
          }
        ),
        None => SemverVersion {
          major: major.to_u64(),
          minor: minor_patch.to_u64(),
          patch: 0,
          pre,
        },
      )
    ),
    None => SemverVersion {
      major: core.to_u64(),
      minor: 0,
      patch: 0,
      pre,
    },
  )
)

fn parse_semver_req(s: String) -> SemverReq (
  if s.starts_with("^") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.Caret,
          version: parse_semver_version(s.slice(1..)),
        },
      ],
    }
  ) else if s.starts_with("~") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.Tilde,
          version: parse_semver_version(s.slice(1..)),
        },
      ],
    }
  ) else if s.starts_with(">=") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.GreaterEq,
          version: parse_semver_version(s.slice(2..)),
        },
      ],
    }
  ) else if s.starts_with("<=") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.LessEq,
          version: parse_semver_version(s.slice(2..)),
        },
      ],
    }
  ) else if s.starts_with(">") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.Greater,
          version: parse_semver_version(s.slice(1..)),
        },
      ],
    }
  ) else if s.starts_with("<") (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.Less,
          version: parse_semver_version(s.slice(1..)),
        },
      ],
    }
  ) else (
    SemverReq {
      comparators: [
        Comparator {
          op: ComparatorOp.Caret,
          version: parse_semver_version(s),
        },
      ],
    }
  )
)

fn matches_semver(req: SemverReq?, version: SemverVersion) -> Bool (
  match req (
    None => true,
    Some { value } =>
      !value.comparators.any((cmp) => !matches_comparator(cmp, version)),
  )
)

fn matches_comparator(cmp: Comparator, version: SemverVersion) -> Bool (
  let ordering = compare_semver(version, cmp.version);
  match cmp.op (
    ComparatorOp.Exact => ordering == 1,
    ComparatorOp.Greater => ordering == 2,
    ComparatorOp.GreaterEq => ordering != 0,
    ComparatorOp.Less => ordering == 0,
    ComparatorOp.LessEq => ordering != 2,
    ComparatorOp.Caret => (
      if cmp.version.major == 0 (
        version.major == 0 &&
        version.minor == cmp.version.minor &&
        ordering != 0
      ) else (
        version.major == cmp.version.major &&
        ordering != 0
      )
    ),
    ComparatorOp.Tilde =>
      version.major == cmp.version.major &&
      version.minor == cmp.version.minor &&
      ordering != 0,
  )
)

fn compare_semver(a: SemverVersion, b: SemverVersion) -> U64 (
  if a.major < b.major (
    0
  ) else if a.major > b.major (
    2
  ) else if a.minor < b.minor (
    0
  ) else if a.minor > b.minor (
    2
  ) else if a.patch < b.patch (
    0
  ) else if a.patch > b.patch (
    2
  ) else (
    match a.pre (
      Some { value: a_pre } => (
        match b.pre (
          Some { value: b_pre } => (
            if a_pre < b_pre (
              0
            ) else if a_pre > b_pre (
              2
            ) else (
              1
            )
          ),
          None => 0,
        )
      ),
      None => (
        match b.pre (
          Some { value: _ } => 2,
          None => 1,
        )
      ),
    )
  )
)

fn candidate_entries(entries: Array[IndexEntry], request: DependencyRequest) -> Array[IndexEntry] (
  entries
    .filter((entry) =>
      !entry.yanked &&
      matches_semver(request.version_req, parse_semver_version(entry.vers))
    )
    .to_array()
)

fn highest_version(entries: Array[IndexEntry]) -> IndexEntry (
  array_fold(
    array_rest(entries),
    array_first(entries),
    ((best, entry) =>
      if compare_semver(parse_semver_version(entry.vers), parse_semver_version(best.vers)) == 2 (
        entry
      ) else (
        best
      )
    ),
  )
)

fn parse_cfg_expr(s: String) -> CfgExpr (
  // Sketch only:
  // parse Cargo cfg selectors such as:
  // - `unix`
  // - `target_os = "linux"`
  // - `all(unix, target_env = "gnu")`
  // - `any(windows, target_os = "macos")`
  // - `not(target_arch = "wasm32")`
  let _s = s;
  fail "cfg parser omitted from sketch"
)

fn parse_target_selector(s: String) -> TargetSelector (
  if s.starts_with("cfg(") (
    TargetSelector.Cfg {
      expr: parse_cfg_expr(s.slice(4..s.len() - 1)),
    }
  ) else (
    TargetSelector.Triple { triple: s }
  )
)

fn cfg_matches(target: BuildTarget, expr: CfgExpr) -> Bool (
  // Sketch only:
  // evaluate `expr` against `target.cfg`
  let _target = target;
  let _expr = expr;
  fail "cfg evaluation omitted from sketch"
)

fn selector_matches(target: BuildTarget, selector: TargetSelector) -> Bool (
  match selector (
    TargetSelector.Triple { triple } => target.triple == triple,
    TargetSelector.Cfg { expr } => cfg_matches(target, expr),
  )
)

fn target_requests(selector: String, table: CargoTargetTable) where {
  target: BuildTarget,
} -> Array[DependencyRequest] (
  if selector_matches(target, parse_target_selector(selector)) (
    [
      ..table.dependencies
        .map((name, dep) => (
          let req = request_from_dep(name, dep, "normal");
          DependencyRequest { ..req, target: selector }
        ))
        .to_array(),
      ..table.build_dependencies
        .map((name, dep) => (
          let req = request_from_dep(name, dep, "build");
          DependencyRequest { ..req, target: selector }
        ))
        .to_array(),
    ]
  ) else (
    []
  )
)

fn request_from_index_dep(dep: IndexDependency) -> DependencyRequest (
  DependencyRequest {
    name: dep.name,
    package_name: dep.package,
    version_req: Some(parse_semver_req(dep.req)),
    features: dep.features,
    default_features: dep.default_features,
    optional: dep.optional,
    kind: dep.kind.unwrap_or("normal"),
    target: dep.target,
    source: DependencySource.Registry,
  }
)

enum FeatureEdge {
  struct Local {
    feature: String,
  },
  struct EnableDependency {
    dependency: String,
  },
  struct DependencyFeature {
    dependency: String,
    feature: String,
    weak: Bool = false,
  },
}

fn parse_feature_edge(s: String) -> FeatureEdge (
  if s.starts_with("dep:") (
    FeatureEdge.EnableDependency {
      dependency: s.slice(4..),
    }
  ) else (
    match s.split_once("/") (
      Some { value } => (
        let (dep, feat) = value;
        if dep.ends_with("?") (
          FeatureEdge.DependencyFeature {
            dependency: dep.slice(0..dep.len() - 1),
            feature: feat,
            weak: true,
          }
        ) else (
          FeatureEdge.DependencyFeature {
            dependency: dep,
            feature: feat,
            weak: false,
          }
        )
      ),
      None => FeatureEdge.Local { feature: s },
    )
  )
)

fn append_unique_string(items: Array[String], value: String) -> Array[String] (
  if items.any($ == value) (
    items
  ) else (
    [..items, value]
  )
)

fn append_unique_dependency_feature(
  items: Array[ActivatedDependencyFeature],
  dependency: String,
  feature: String,
) -> Array[ActivatedDependencyFeature] (
  if items.any($.dependency == dependency && $.feature == feature) (
    items
  ) else (
    [
      ..items,
      ActivatedDependencyFeature {
        dependency,
        feature,
      },
    ]
  )
)

fn apply_feature_edge(state: FeatureExpansionState, edge_text: String) -> FeatureExpansionState (
  match parse_feature_edge(edge_text) (
    FeatureEdge.Local { feature } => FeatureExpansionState {
      ..state,
      pending: append_unique_string(state.pending, feature),
    },
    FeatureEdge.EnableDependency { dependency } => FeatureExpansionState {
      ..state,
      enabled_optional_deps: append_unique_string(state.enabled_optional_deps, dependency),
    },
    FeatureEdge.DependencyFeature {
      dependency,
      feature,
      weak,
    } => (
      if weak && !state.enabled_optional_deps.any($ == dependency) (
        state
      ) else (
        FeatureExpansionState {
          ..state,
          dependency_features: append_unique_dependency_feature(
            state.dependency_features,
            dependency,
            feature,
          ),
        }
      )
    ),
  )
)

fn expand_features(
  feature_graph: Map[String, Array[String]],
  pending: Array[String],
  seen: Array[String],
  enabled_optional_deps: Array[String],
  dependency_features: Array[ActivatedDependencyFeature],
) -> UnifiedFeatures (
  if pending == [] (
    UnifiedFeatures {
      local: seen,
      enabled_optional_deps,
      dependency_features,
    }
  ) else (
    let feature = array_first(pending);
    let rest = array_rest(pending);
    if seen.any($ == feature) (
      expand_features(
        feature_graph,
        rest,
        seen,
        enabled_optional_deps,
        dependency_features,
      )
    ) else (
      let edges =
        if feature_graph.has(feature) (
          feature_graph.get(feature)
        ) else (
          []
        );
      let folded =
        array_fold(
          edges,
          FeatureExpansionState {
            pending: rest,
            enabled_optional_deps,
            dependency_features,
          },
          apply_feature_edge,
        );
      expand_features(
        feature_graph,
        folded.pending,
        append_unique_string(seen, feature),
        folded.enabled_optional_deps,
        folded.dependency_features,
      )
    )
  )
)

fn unify_features(feature_graph: Map[String, Array[String]], request: DependencyRequest) -> UnifiedFeatures (
  let seeds =
    if request.default_features && feature_graph.has("default") (
      ["default", ..request.features]
    ) else (
      request.features
    );
  expand_features(feature_graph, seeds, [], [], [])
)

fn extend_dependency_features(dep: DependencyRequest, extra: Array[String]) -> DependencyRequest (
  DependencyRequest {
    name: dep.name,
    package_name: dep.package_name,
    version_req: dep.version_req,
    features: [..dep.features, ..extra],
    default_features: dep.default_features,
    optional: dep.optional,
    kind: dep.kind,
    target: dep.target,
    source: dep.source,
  }
)

fn dependency_feature_names(
  requested: Array[ActivatedDependencyFeature],
  dependency: String,
) -> Array[String] (
  array_fold(
    requested,
    [],
    ((acc, item) =>
      if item.dependency == dependency (
        array_push(acc, item.feature)
      ) else (
        acc
      )
    ),
  )
)

fn apply_feature_requests(deps: Array[DependencyRequest], features: UnifiedFeatures) -> Array[DependencyRequest] (
  array_fold(
    deps,
    [],
    ((acc, dep) =>
      if !dep.optional || features.enabled_optional_deps.any($ == dep.name) (
        let extra = dependency_feature_names(features.dependency_features, dep.name);
        array_push(acc, extend_dependency_features(dep, extra))
      ) else (
        acc
      )
    ),
  )
)

fn request_key(req: DependencyRequest) -> String (
  let source =
    match req.source (
      DependencySource.Registry => `registry:{req.package_name.unwrap_or(req.name)}`,
      DependencySource.Path { path } => `path:{path}`,
      DependencySource.Git { url } => `git:{url}`,
    );

  let target =
    match req.target (
      Some { value } => `@{value}`,
      None => "",
    );

  `{source}:{req.kind}{target}`
)

fn conjoin_semver(left: SemverReq?, right: SemverReq?) -> SemverReq? (
  match left (
    Some { value } => (
      match right (
        Some { value: other } => SemverReq {
          comparators: [..value.comparators, ..other.comparators],
        },
        None => value,
      )
    ),
    None => right,
  )
)

fn merge_requests(existing: DependencyRequest, incoming: DependencyRequest) -> DependencyRequest (
  DependencyRequest {
    ..existing,
    version_req: conjoin_semver(existing.version_req, incoming.version_req),
    features: [..existing.features, ..incoming.features],
    default_features: existing.default_features || incoming.default_features,
    optional: existing.optional && incoming.optional,
  }
)

fn canonical_requests(requests: Array[DependencyRequest]) -> Array[DependencyRequest] (
  // Sketch only:
  // group by `request_key`, then merge requests that target the same package
  requests
    .group_by(request_key($))
    .map((key, group) => group.reduce((left, right) => merge_requests(left, right)))
    .to_array()
)

fn resolve_graph(roots: Array[DependencyRequest]) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> RegistryResolution (
  let demanded = canonical_requests(roots);

  // Sketch only:
  // - treat `demanded` as the root package requests
  // - resolve each request into a canonical package node
  // - each resolved package contributes more dependency requests
  // - merge those requests by `request_key`
  // - repeat to a least fixpoint
  // - the semantic result is the resolved graph itself; any ordering is a
  //   later projection for lockfiles, diagnostics, or export
  let _demanded = demanded;
  let _config = config;
  let _lock = lock;
  let _target = target;
  let _workspace = workspace;
  fail "transitive graph resolution omitted from sketch"
)

fn lock_entry(lock: CargoLock?, name: String) -> LockedPackage? (
  match lock (
    Some { value } => value.package.find($.name == name),
    None => None,
  )
)

fn pick_version(entries: Array[IndexEntry], request: DependencyRequest, lock: LockedPackage?) -> IndexEntry (
  let candidates = candidate_entries(entries, request);

  match lock (
    Some { value } => (
      match candidates.find($.vers == value.version) (
        Some { value } => value,
        None => highest_version(candidates),
      )
    ),
    None => highest_version(candidates),
  )
)

fn resolve_request(request: DependencyRequest) where {
  config: SparseConfig,
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> ResolvedCrate (
  let package_name = request.package_name.unwrap_or(request.name);

  match request.source (
    DependencySource.Path { path } => (
      let dep_root = Path(path);
      let dep_manifest = Toml.parse[CargoManifest](workspace.file(dep_root / @Cargo.toml));
      let features = unify_features(dep_manifest.features, request);
      let source = ResolvedSource.Path { path };
      ResolvedCrate {
        id: PackageId(`path:{path}`),
        name: dep_manifest.package.name,
        version: dep_manifest.package.version,
        features: features.local,
        dependencies: apply_feature_requests(manifest_requests(dep_manifest) where { target }, features),
        source,
      }
    ),
    DependencySource.Git { url } => (
      // Under the current primitive set, git still wants a real fetch story.
      // This could become:
      // - an archive URL convention for known hosts, or
      // - a future VCS fetch primitive layered over Http.get.
      let _url = url;
      fail "git dependency resolution omitted from sketch"
    ),
    DependencySource.Registry => (
  let entries = parse_sparse_entries(Http.get(sparse_index_url(package_name)));

  let chosen = pick_version(entries, request, lock_entry(lock, package_name));
  let features = unify_features(merged_entry_features(chosen), request);
  let dependencies =
    chosen.deps
      .filter($.kind.unwrap_or("normal") == request.kind)
      .map(request_from_index_dep($))
      .to_array();
  let source =
    ResolvedSource.Registry {
      checksum: chosen.cksum,
      download_url: crate_download_url(config, chosen.name, chosen.vers, chosen.cksum),
    };

  ResolvedCrate {
    id: PackageId(`registry:{chosen.name}@{chosen.vers}`),
    name: chosen.name,
    version: chosen.vers,
    features: features.local,
    dependencies: apply_feature_requests(dependencies, features),
    source,
  }
    ),
  )
)

fn resolve_manifest(manifest: CargoManifest) where {
  lock: CargoLock?,
  target: BuildTarget,
  workspace: Tree,
} #discover -> RegistryResolution (
  let config = Json.parse[SparseConfig](Http.get("https://index.crates.io/config.json"));
  let requests = manifest_requests(manifest) where { target };
  resolve_graph(requests) where { config, lock, target, workspace }
)

fn emit_lockfile(resolution: RegistryResolution) -> Blob (
  Toml.serialize(CargoLock {
    package:
      resolution.packages
        .map((pkg) => LockedPackage {
          name: pkg.name,
          version: pkg.version,
          source:
            match pkg.source (
              ResolvedSource.Registry { checksum: _, download_url: _ } =>
                "registry+https://github.com/rust-lang/crates.io-index",
              ResolvedSource.Git { url, rev, checksum: _, archive_url: _ } =>
                `git+${url}#${rev}`,
              ResolvedSource.Path { path: _ } => None,
            ),
          checksum:
            match pkg.source (
              ResolvedSource.Registry { checksum, download_url: _ } => checksum,
              ResolvedSource.Git { url: _, rev: _, checksum, archive_url: _ } => checksum,
              ResolvedSource.Path { path: _ } => None,
            ),
        })
        .to_array(),
  })
)

fn crate_source(pkg: ResolvedCrate) where {
  workspace_root: Path,
} -> Tree (
  match pkg.source (
    ResolvedSource.Registry { checksum, download_url } => (
      acquire(download_url) where {
        digest: `sha256:${checksum}`,
        extract: "tar.gz",
      }
    ),
    ResolvedSource.Path { path } => Tree(workspace_root / Path(path)),
    ResolvedSource.Git { url, rev, checksum, archive_url } => (
      let _url = url;
      let _rev = rev;
      let _checksum = checksum;
      let _archive_url = archive_url;
      fail "git source acquisition omitted from sketch"
    ),
  )
)

fn vendored_entry(pkg: ResolvedCrate) where {
  workspace_root: Path,
} -> (Path, Tree) (
  (@(vendor/{pkg.name}-{pkg.version}), crate_source(pkg) where { workspace_root })
)

fn build(ws: Path, args: Array[String], env: Map[String, String]) #fs #discover -> Tree (
  let workspace = Tree(ws);
  let manifest = Toml.parse[CargoManifest](workspace.file(@Cargo.toml));
  let lock = parse_lock(workspace);
  let target = BuildTarget {
    // Sketch only:
    // a real implementation would derive this from the selected build target,
    // executor class, or explicit CLI/config inputs.
    triple: "x86_64-unknown-linux-gnu",
  };

  let resolution = resolve_manifest(manifest) where { lock, target, workspace };

  // Resolution discovers exact versions and checksums.
  // Acquisition stays fixed-hash and cacheable.
  let vendor =
    Tree(
      resolution.packages
        .to_map((pkg) => vendored_entry(pkg) where { workspace_root: ws })
    );
  let lock_blob = emit_lockfile(resolution);

  // Next layer, not modeled here:
  // - parse vendored Cargo.toml files
  // - compile the resolved crate graph by demanding root packages
  Tree %{
    @vendor => vendor,
    @Cargo.lock => lock_blob,
  }
)
