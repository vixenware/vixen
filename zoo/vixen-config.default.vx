fn platforms(env: Map[String, String]) {
  if env.has("VX_PLATFORMS") (
    env.get("VX_PLATFORMS").split(",")
  ) else (
    ["darwin"]
  )
}

fn executor_for_platform(name: String) {
  if name == "darwin" (
    executor_class("default")
  ) else if name == "linux" (
    executor_class("ssh:orb")
  ) else if name == "windows" (
    executor_class("ssh:pauline")
  ) else (
    fail `unknown platform: ${name}`
  )
}
