let c_toolchain = import("vixen:c-toolchain");

// Minimal cc-version build sketch for the current resolver/evaluator lane.
//
// This is intentionally separate from `zoo/lua.vx`: it exercises a small
// discovery/exec path and returns a real output file instead of an empty tree.
//
// The surface here is intentionally aspirational. The point of this sketch is
// to show the shape we want:
// - discover returns a named toolchain record, not a pair
// - coarse host exposure is a single authored concept
// - toolchain discovery lives in a package/module, not on `Host`
// - low-level CLT subpath bookkeeping should not be spelled out inline here

struct CToolchain {
  cc: String,
  coarse_mounts: Array[SandboxExemption],
}

fn discover_c_toolchain(class: ExecutorClass) {
  discover(class, (host) => c_toolchain.discover(host))
}

fn build(ws: Path, args: Array[String], env: Map[String, String]) #discover -> Tree (
  let class = executor_class("default");
  let toolchain = discover_c_toolchain(class);
  let ev_stream = exec [toolchain.cc, "--version"] where {
    coarse_mounts: toolchain.coarse_mounts,
    observer: (proc, _vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        Tree %{
          @cc-version.txt => proc.stdout.collect().blob(),
        }
      )
    ),
    observer: (proc, vfs) => (
      proc.stdout.lines.filter_map.from_json {

      }
    )
  }

  // smth with ev_stream
)
