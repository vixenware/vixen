// Minimal cc-version build sketch for the current resolver/evaluator lane.
//
// This is intentionally separate from `zoo/lua.vx`: it exercises a small
// discovery/exec path and returns a real output file instead of an empty tree.

fn build(ws: Path, args: Array[String], env: Map[String, String]) #discover -> Tree (
  let class = executor_class("default");
  let tool = discover(class, (host) => (
    host.which("cc"),
    [
      host.exec_subpath("/usr/bin"),
      host.exec_subpath("/Library/Developer/CommandLineTools/usr/bin"),
      host.read_subpath("/Library/Developer/CommandLineTools"),
      host.read_subpath("/Library/Developer/CommandLineTools/usr/lib"),
      host.read_subpath("/Library/Developer/CommandLineTools/SDKs"),
    ]
  ));
  let cc = tool._0;
  let coarse_mounts = tool._1;

  exec [cc, "--version"] where {
    coarse_mounts: coarse_mounts,
    observer: (proc, _vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        Tree %{
          @cc-version.txt => proc.stdout.collect().blob(),
        }
      )
    ),
  }
)
