let { RustToolchain } = import "rust"
let { parse_artifact } = import "rust"   // @vixen/rust owns the --json artifact parser

// Compile a crate, surfacing each artifact the instant rustc finalizes it. The
// .rmeta event flows before codegen finishes — and stands even if codegen then
// fails — so a dependent crate can pipeline against it. A streaming observer
// returns Stream[T], so exec returns Stream[T].
//
// `@[ … ]` has no grammar name — the leading {tc.rustc} (the command the
// RustToolchain capability advertises) carries it; routing falls out of `tc`.
fn compile(tc: RustToolchain, name: String, src: Path, out: Path) -> Stream[Artifact] (
  exec(@[ {tc.rustc} --crate-name ${name} --edition 2021 --emit metadata,link --out-dir ${out} ${src} ]) with {
    observer: (run) => (
      // finalization isn't knowable from the VFS; rustc announces it on stderr as
      // JSON. We correlate each message to a live handle into the producing tree
      // (run.stream.out is the per-path producing handle; it survives a late fail).
      run.stream.stderr.lines()
        .filter_map(parse_artifact)                  // line -> Option[ArtifactMsg]
        .map((m) => Artifact { kind: m.emit, file: run.stream.out.file(m.path) })
    ),
  }
)

fn main(workspace: Tree) with { ..VixenMain } -> Tree (
  let tc = RustToolchain where (version >= 1.91);
  let lib = workspace "src/lib.rs";
  // The produced artifacts stream out as rustc finalizes them; collect the linked
  // outputs into the result tree. (A dependent crate would instead demand the
  // Metadata artifact and pipeline against it before .rlib exists.)
  compile(tc, "mylib", lib, "out")
    .filter((a) => a.kind == ArtifactKind.Link)
    .map((a) => a.file)
    .merge()
)
