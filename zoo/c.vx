```styx
id @vixen/c
version 1.0.0
capability {
  advertises CToolchain
}
```

enum Style { struct Gcc, struct Msvc }   // Gcc: gcc/clang/apple — one CLI; Msvc: its own

// Advertising this capability *is* defining its commands. `cc` is a `Command`: it
// bundles its grammar, the probed binary, how to fingerprint it, and the exemptions
// it needs — one declaration, never split (see the wiki: "The exec primitive" §4,
// and "Types are values"). The grammar is a *value* the command carries (imported
// from @vixen/grammar-cc as a value, or computed from the probe), projected on
// demand by a `${self.cc} …` invocation — never a static type.
struct CToolchain {
  target: String,    // the triple it builds for — the constraint surface
  style: Style,
  version: SemVer,
  cc: Command,       // the C compiler command (grammar + binary + fingerprint + exemptions)
}

namespace CToolchain (
  // Compile one source to an object, gated on success. A `…` invocation has no
  // grammar name — the leading ${self.cc} carries it. The grammar classifies the source as
  // an input and the output target as an output, so the sandbox mounts + the
  // writable root fall out of the command; routing falls out of `self`'s provenance.
  fn object(self, src: Path, obj: Path) -> Blob (
    // `exec` defaults its observer to `(run) => run.ok.out` — the settled output
    // tree, success-gated — so we don't spell it out.
    let tree = match self.style (
      Style.Gcc  => `${self.cc} -c ${src} -o ${obj}`,
      Style.Msvc => `${self.cc} /c ${src} /Fo:${obj}`,
    );
    tree.file(obj)
  )

  // Compile + link sources to an executable, gated on success. `${..srcs}` splats
  // the source list into the grammar's repeatable source position.
  fn executable(self, srcs: Array[Path], out: Path) -> Blob (
    let tree = match self.style (
      Style.Gcc  => `${self.cc} ${..srcs} -o ${out}`,
      Style.Msvc => `${self.cc} ${..srcs} /Fe:${out}.exe`,
    );
    tree.file(out)
  )

  // discovery — how a daemon advertises this for its host. The probe builds the
  // `cc` Command from the binary it found + the exemptions it needs, fingerprinted
  // by the probe observations (host.which / host.hash) so a different `cc`
  // invalidates the cache.
  fn probe(host: Host) -> Option[CToolchain] (
    // The cc grammar is a value the package exports — held, not type-imported.
    let grammars = import "@vixen/grammar-cc";
    match host.which?("cc") (
      None => None,
      Some { value: cc_path } => Some(CToolchain {
        target: "${host.arch()}-unknown-${host.os()}",
        style:  Style.Gcc,        // TODO: confirm via `cc --version` (clang reports Gcc-style too)
        version: 1.0.0,           // TODO: probe `cc -dumpversion`
        // The Command, bundled — never split. The grammar value travels with it;
        // the `${self.cc} …` invocation projects `cc.grammar` to classify its arguments.
        cc: Command {
          grammar:     grammars.cc,          // the cc Grammar value (or computed from the probe)
          binary:      ExecPath(cc_path),
          fingerprint: host.hash(cc_path),   // a different cc ⇒ a different cache key
          exemptions: [                      // host paths it may touch outside the VFS
            host.exec_subpath("/usr/bin"),
            host.read_subpath("/usr/include"),
            host.read_subpath("/usr/lib"),
          ],
        },
      }),
    )
  )
)
