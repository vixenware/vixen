let config = import("vixen:config");

struct Toolchain {
  os: String,
  arch: String,
  cc: String,
}

fn toolchain(class: ExecutorClass) {
  discover(class, (host) => {
    let os = host.os();
    let arch = host.arch();
    let cc = if os == "windows" {
      host.which("cl.exe")
    } else {
      "cc"
    };
    Toolchain { os, arch, cc }
  })
}

fn compile_hello(class: ExecutorClass) {
  let tc = toolchain(class);
  let source = Tree %{
    @hello.c => Blob(`
int answer(void) {
  return 42;
}
`),
  };

  exec(
    if tc.os == "windows" {
      [tc.cc, "/nologo", "/c", "/Foout\\hello.obj", @src/hello.c]
    } else {
      [tc.cc, "-c", "-o", @out/hello.o, @src/hello.c]
    }
  ) where {
    executor: class,
    mounts: %{
      @src => source,
    },
    writable: if tc.os == "windows" { [@out] } else { [] },
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        Tree %{
          @(artifacts/{tc.os}-{tc.arch}) => vfs.subtree(@out),
        }
      )
    ),
  }
}

fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  config.platforms(env)
    .map((name) => Tree %{ @({name}) => compile_hello(config.executor_for_platform(name)) })
    .merge()
}
