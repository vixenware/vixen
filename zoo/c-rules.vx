struct Toolchain {
  os: String,
  arch: String,
  cc: String,
  archive: String,
}

struct CLibraryVariant {
  link_tree: Tree,
  link_inputs: Array[Path],
  runtime_tree: Tree,
  defines: Array[String] = [],
}

struct CLibrary {
  headers: Tree,
  static: CLibraryVariant,
  shared: CLibraryVariant,
}

struct CExecutableVariant {
  run_tree: Tree,
  program: Path,
}

struct CExecutable {
  static: CExecutableVariant,
  shared: CExecutableVariant,
}

fn discover_toolchain(class: ExecutorClass) {
  discover(class, (host) => {
    let os = host.os();
    let arch = host.arch();
    let cc =
      if os == "windows" (
        host.which("cl.exe")
      ) else (
        host.which("cc")
      );
    let archive =
      if os == "windows" (
        host.which("lib.exe")
      ) else if os == "darwin" (
        host.which("libtool")
      ) else (
        host.which("ar")
      );

    Toolchain { os, arch, cc, archive }
  })
}

fn compile_objects(class: ExecutorClass, tc: Toolchain, src: Tree, sources: Array[Path]) where {
  generated: Map[Path, Blob] = %{},
  mounts: Map[Path, TreeEntry] = %{},
  includes: Array[Path] = [],
  defines: Array[String] = [],
  flags: Array[String] = [],
  pic: Bool = true,
} -> Tree (
  let cexec = partial exec where {
    executor: class,
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  sources
    .map((file) =>
      if tc.os == "windows" (
        cexec [
          tc.cc,
          "/nologo",
          "/c",
          @(src/{file}),
          `/Foout\\obj\\${file}.obj`,
          ..includes.map((include) => ["/I", include]).flatten(),
          ..defines.map((define) => `/D${define}`),
          "/O2",
          ..flags,
        ] where {
          mounts: %{ @src => src, @gen => Tree(generated), ..mounts },
          writable: [@out],
          create_dirs: [@out/obj],
        }
      ) else (
        cexec [
          tc.cc,
          "-c",
          @(src/{file}),
          "-o",
          @(out/obj/{file}.o),
          ..includes.map((include) => ["-I", include]).flatten(),
          ..defines.map((define) => `-D${define}`),
          "-O2",
          ..if pic (["-fPIC"]) else ([]),
          ..flags,
        ] where {
          mounts: %{ @src => src, @gen => Tree(generated), ..mounts },
          writable: [@out],
        }
      )
    )
    .merge()
)

fn static_archive(class: ExecutorClass, tc: Toolchain, name: Path, objects: Tree) -> Tree (
  let cexec = partial exec where {
    executor: class,
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  if tc.os == "windows" (
    cexec [tc.archive, "/nologo", `/OUT:out\\${name}`, ..objects] where {
      writable: [@out],
    }
  ) else if tc.os == "darwin" (
    cexec [tc.archive, "-static", "-o", @(out/{name}), ..objects] where {
      writable: [@out],
    }
  ) else (
    cexec [tc.archive, "rcs", @(out/{name}), ..objects] where {
      writable: [@out],
    }
  )
)
