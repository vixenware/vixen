let core_sources = [
  @lapi.c, @lcode.c, @lctype.c, @ldebug.c, @ldo.c, @ldump.c,
  @lfunc.c, @lgc.c, @llex.c, @lmem.c, @lobject.c, @lopcodes.c,
  @lparser.c, @lstate.c, @lstring.c, @ltable.c, @ltm.c,
  @lundump.c, @lvm.c, @lzio.c,
];

let aux_sources = [@lauxlib.c];

let lib_sources = [
  @lbaselib.c, @ldblib.c, @liolib.c, @lmathlib.c, @loslib.c,
  @ltablib.c, @lstrlib.c, @lutf8lib.c, @loadlib.c, @lcorolib.c,
  @linit.c,
];

let all_lib_sources = [..core_sources, ..aux_sources, ..lib_sources];

struct Toolchain {
  os: String,
  arch: String,
  cc: String,
  archive: String,
}

fn toolchain(class: ExecutorClass) {
  discover(class, (host) => {
    let os = host.os();
    let arch = host.arch();
    let cc =
      if os == "windows" (
        host.which("cl.exe")
      ) else (
        host.which("cc")
      );
    let archive =
      if os == "windows" (
        host.which("lib.exe")
      ) else if os == "darwin" (
        host.which("libtool")
      ) else (
        host.which("ar")
      );

    Toolchain { os, arch, cc, archive }
  })
}

fn build_lua(workspace: Path, class: ExecutorClass) {
  let tc = toolchain(class);
  let src_tree = Tree(workspace / @zoo/lua-src);

  let cexec = partial exec where {
    executor: class,
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  fn compile(file: Path) -> Tree (
      cexec [
        tc.cc,
        "/nologo",
        "/c",
        "/O2",
        "/Isrc",
        `/Foout\\obj\\${file}.obj`,
        @(src/{file}),
      ] where {
        mounts: %{ @src => src_tree },
        writable: [@out],
    }
  );

  fn archive(objs: Tree) -> Tree (
    cexec [tc.archive, "/nologo", "/OUT:out\\liblua.lib", ..objs] where {
      writable: [@out],
    }
  );

  fn link(lua_obj: Tree, liblua: Tree) -> Tree (
    cexec [tc.cc, "/nologo", "/Feout\\lua.exe", ..lua_obj, ..liblua] where {
      writable: [@out],
    }
  );

  let objects = (all_lib_sources.map(compile)).merge();
  let liblua = archive(objects);
  let lua_obj = compile(@lua.c);
  let lua_exe = link(lua_obj, liblua);

  let installed_bin = Tree %{ @lua.exe => lua_exe.file(@lua.exe).executable() };
  let installed_lib = Tree %{ @liblua.lib => liblua.file(@liblua.lib) };

  let version_blob =
    exec([@bin/lua.exe, "-e", "print(_VERSION)"]) where {
      executor: class,
      mounts: %{ @bin => installed_bin },
      observer: (proc, _vfs) => (
        if proc.exit_code != 0 (
          fail `process failed`
        ) else (
          proc.stdout.collect().blob()
        )
      ),
    };

  Tree %{
    @(artifacts/{tc.os}-{tc.arch}/bin) => installed_bin,
    @(artifacts/{tc.os}-{tc.arch}/lib) => installed_lib,
    @(artifacts/{tc.os}-{tc.arch}/version.txt) => version_blob,
  }
}

fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  build_lua(workspace, executor_class("ssh:toast"))
}
