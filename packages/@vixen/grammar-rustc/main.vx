```styx
id "@vixen/grammar-rustc"
version "0.1.0"
```

// The rustc grammar, authored in Vixen against @vixen/command-grammar.
//
// We model the *effective rustc invocation* — the flag set rustc actually
// receives — not cargo's profile machinery. Most of cargo's fingerprint reduces
// to flags here: features become `--cfg`, edition `--edition`, target triple
// `--target`, the codegen knobs `-C…`. What isn't a flag (rustc version, the
// source + dep inputs) is host facts / inputs, handled elsewhere.
//
// The `compat` block is the Tier-1 cache-equivalence layer: it folds invocations
// that rustc treats as identical onto one cache key (default-valued knobs, value
// aliases, and knobs that don't affect output). Plain canonicalization keeps the
// literal flags; only the effective-command identity normalizes.

let { Grammar, Flag, Compat, Spelling, Policy, Kind, ValueDomain, Positional, EnvDecl, Arity, Operation } =
  import "vixen:command-grammar"

let rustc = Grammar {
  name: "rustc",
  flags: [
    // ---- codegen options (-C key=value) --------------------------------------
    Flag { canonical: "-Copt-level", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "opt-level", value: ValueDomain.OneOf { values: ["0", "1", "2", "3", "s", "z"] },
           doc: "optimization level" },
    Flag { canonical: "-Cdebuginfo", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "debuginfo", doc: "amount of debug info (0/1/2 or none/limited/full)" },
    Flag { canonical: "-Clto", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "lto", doc: "link-time optimization" },
    Flag { canonical: "-Ccodegen-units", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "codegen-units", doc: "number of codegen units" },
    Flag { canonical: "-Cpanic", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "panic", value: ValueDomain.OneOf { values: ["unwind", "abort"] },
           doc: "panic strategy" },
    Flag { canonical: "-Coverflow-checks", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "overflow-checks", doc: "enable integer overflow checks" },

    // ---- crate shape ---------------------------------------------------------
    Flag { canonical: "--edition", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "edition", value: ValueDomain.OneOf { values: ["2015", "2018", "2021", "2024"] },
           doc: "Rust edition" },
    Flag { canonical: "--crate-name", spelling: Spelling.Separated, policy: Policy.Once,
           role: "crate-name", doc: "the crate's name" },
    Flag { canonical: "--crate-type", spelling: Spelling.Separated, policy: Policy.DedupUnordered,
           role: "crate-type", doc: "lib/bin/cdylib/… (repeatable)" },
    Flag { canonical: "--cfg", spelling: Spelling.Separated, policy: Policy.DedupUnordered,
           role: "cfg", operation: Operation.Add, doc: "a --cfg predicate, e.g. feature=\"x\"" },
    Flag { canonical: "--target", spelling: Spelling.Separated, policy: Policy.Once,
           role: "target", value: ValueDomain.Named { domain: "triple" }, doc: "target triple" },

    // ---- inputs / search paths ----------------------------------------------
    Flag { canonical: "-L", spelling: Spelling.Separated, policy: Policy.DedupOrdered,
           kind: Kind.Input { dir: true }, role: "lib-dir", operation: Operation.Add,
           value: ValueDomain.Path { dir: true }, doc: "add a library search directory" },
    Flag { canonical: "--extern", spelling: Spelling.Separated, policy: Policy.DedupOrdered,
           role: "extern", operation: Operation.Add, doc: "NAME=PATH of a direct dependency" },
    Flag { canonical: "--emit", spelling: Spelling.Separated, policy: Policy.DedupUnordered,
           role: "emit", doc: "what to emit (metadata/link/obj/…)" },

    // ---- outputs -------------------------------------------------------------
    Flag { canonical: "-o", spelling: Spelling.Separated, policy: Policy.Once,
           kind: Kind.Output { dir: false }, role: "output", value: ValueDomain.Path { dir: false },
           doc: "write output to this file" },
    Flag { canonical: "--out-dir", spelling: Spelling.Separated, policy: Policy.Once,
           kind: Kind.Output { dir: true }, role: "out-dir", value: ValueDomain.Path { dir: true },
           doc: "write output into this directory" },
  ],
  env: [
    EnvDecl { name: "SOURCE_DATE_EPOCH", kind: Kind.Text, role: "source-date",
              doc: "fixed timestamp for reproducible builds" },
  ],
  positionals: [
    Positional { name: "crate-root", kind: Kind.Input { dir: false }, role: "source",
                 arity: Arity.One, doc: "the crate root source file (e.g. src/lib.rs)" },
  ],
  // ---- cache-equivalence (Tier 1) -------------------------------------------
  compat: [
    // opt-level 0 is rustc's default — keying on it would be spurious.
    Compat { flag: "-Copt-level", default_value: "0" },
    // debuginfo: numeric and named spellings are aliases; 0 is the default.
    Compat { flag: "-Cdebuginfo",
             classes: [["0", "none"], ["1", "limited"], ["2", "full"]],
             default_value: "0" },
    // lto: fat/yes/true ≡ on, off/no/false ≡ off (the default), thin is distinct.
    Compat { flag: "-Clto",
             classes: [["fat", "yes", "true"], ["off", "no", "false"], ["thin"]],
             default_value: "off" },
    // codegen-units never changes the produced artifact's identity for our cache.
    Compat { flag: "-Ccodegen-units", ignored: true },
  ],
}
