/// Construct an executor class selector value.
fn executor_class(label: String) -> ExecutorClass;

/// Evaluate a build entry function through the runtime.
fn build[T](
  entry: Fn(Path, Array[String], Map[String, String]) #fs #discover -> T,
) -> T;

/// Probe a representative executor in the class with host authority.
///
/// Values returned from `discover` carry hidden verification obligations
/// derived from the host observations performed by the probe.
fn discover[T](
  class: ExecutorClass,
  probe: Fn(Host) #host -> T,
) #discover -> T;

/// Fetch a fixed-hash resource and return its content as a blob.
fn acquire(url: String) where {
  /// Expected digest of the fetched payload, written as `scheme:hex`.
  digest: String,
} -> Blob;

/// Fetch and extract a fixed-hash archive in one cached step.
fn acquire(url: String) where {
  /// Expected digest of the fetched archive, written as `scheme:hex`.
  digest: String,
  /// Archive format selector, e.g. `"tar.gz"` or `"tar.xz"`.
  extract: String,
} -> Tree;

/// Render a text template into a blob.
///
/// The template may interpolate values from the bindings record. This is the
/// primitive used for generated config headers, pkg-config files, and small
/// generated scripts in builds.
fn render[T](template: Path) where {
  bindings: T,
} -> Blob;

/// Read a local file as a blob.
fn read_file(path: String) #fs -> Blob;

/// List entries in a local directory.
fn read_dir(path: String) #fs -> Array[String];

/// Expand a local glob pattern.
fn glob(pattern: String) #fs -> Array[String];

/// Test whether a local path exists.
fn exists(path: String) #fs -> Bool;

/// Read basic metadata for a local path.
fn metadata(path: String) #fs -> Map[String, String];

/// Run a sandboxed process on an executor and return the observer result.
///
/// If the observer returns `Stream[T]`, then `exec` itself returns
/// `Stream[T]`. Otherwise it returns an ordinary value.
fn exec[T](
  args: Array[ExecInput]
) where {
  /// Additional environment variables for the sandboxed process.
  env: Map[String, ExecInput] = {},
  /// Explicit VFS mounts, in addition to implicit mounts from args/env.
  mounts: Map[Path, TreeEntry] = {},
  /// Executor class on which to run the process.
  executor: ExecutorClass = executor_class("default"),
  /// Executor-side observer evaluated with sandbox authority.
  observer: Fn(Process, Tree) #sandbox -> T,
} -> T;

/// Persist and reuse a chosen result across builds.
fn stabilize[W, T](
  /// Local witness for when the stabilized result should be reconsidered.
  witness: Fn() #fs -> W,
  /// Discovery/resolve step that computes the stabilized result.
  resolve: Fn(W) #discover -> T,
) -> T;
