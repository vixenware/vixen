/// Evaluate a build entry function through the runtime.
fn build[T](
  entry: Fn(Path, Array[String], Map[String, String]) -> T,
) -> T;

/// Fetch a fixed-hash resource and return its content as a blob.
fn acquire(url: String) with {
  /// Expected digest of the fetched payload, written as `scheme:hex`.
  digest: String,
} -> Blob;

/// Fetch and extract a fixed-hash archive in one cached step.
fn acquire(url: String) with {
  /// Expected digest of the fetched archive, written as `scheme:hex`.
  digest: String,
  /// Archive format selector, e.g. `"tar.gz"` or `"tar.xz"`.
  extract: String,
} -> Tree;

/// Render a text template into a blob.
///
/// The template may interpolate values from the bindings record. This is the
/// primitive used for generated config headers, pkg-config files, and small
/// generated scripts in builds.
fn render[T](template: Path) with {
  bindings: T,
} -> Blob;

/// Read a local file as a blob.
fn read_file(path: String) -> Blob;

/// List entries in a local directory.
fn read_dir(path: String) -> Array[String];

/// Expand a local glob pattern.
fn glob(pattern: String) -> Array[String];

/// Test whether a local path exists.
fn exists(path: String) -> Bool;

/// Read basic metadata for a local path.
fn metadata(path: String) -> Map[String, String];

// Running a tool is a backtick **invocation** (`r[expr.command]`), not a function:
// `` `$tool args…` `` whose leading hole is a tool, the tokens after it its
// arguments. Forcing the invocation runs it on the tool's executor and yields the
// observer's result — the default observer is `run.ok.out` (`r[exec.observer.simple]`).
// A trailing `with { env, mounts, writable, create_dirs, exemptions, observer }`
// supplies the non-defaults (`r[exec.invocation]`). There is no `exec` function and
// no `executor:` kwarg — routing falls out of the tool's provider provenance
// (`r[ability.match]`).
