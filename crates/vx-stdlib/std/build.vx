/// Evaluate a build entry function through the runtime.
fn build[T](
  entry: Fn(Path, Array[String], Map[String, String]) -> T,
) -> T;

/// Fetch a fixed-hash resource and return its content as a blob.
fn acquire(url: String) with {
  /// Expected digest of the fetched payload, written as `scheme:hex`.
  digest: String,
} -> Blob;

/// Fetch and extract a fixed-hash archive in one cached step.
fn acquire(url: String) with {
  /// Expected digest of the fetched archive, written as `scheme:hex`.
  digest: String,
  /// Archive format selector, e.g. `"tar.gz"` or `"tar.xz"`.
  extract: String,
} -> Tree;

/// Render a text template into a blob.
///
/// The template may interpolate values from the bindings record. This is the
/// primitive used for generated config headers, pkg-config files, and small
/// generated scripts in builds.
fn render[T](template: Path) with {
  bindings: T,
} -> Blob;

/// Read a local file as a blob.
fn read_file(path: String) -> Blob;

/// List entries in a local directory.
fn read_dir(path: String) -> Array[String];

/// Expand a local glob pattern.
fn glob(pattern: String) -> Array[String];

/// Test whether a local path exists.
fn exists(path: String) -> Bool;

/// Read basic metadata for a local path.
fn metadata(path: String) -> Map[String, String];

/// Run a sandboxed process on an executor and return the observer result.
///
/// `exec` takes a **`Command`** — a `@[ ${cmd} args… ]` CLI literal whose leading
/// interpolated command carries the grammar (there is no grammar name and no
/// separate grammar import; see the wiki: "The exec primitive" §4). The grammar
/// classifies each argument's `Kind`, so the VFS mount set (inputs) and the
/// writable roots (outputs) fall out of the command. There is **no `executor:`
/// kwarg**: routing falls out of the provenance of the ability values the command
/// consumes (§4–5).
///
/// The observer is evaluated **executor-side** against the `Run` (§6–7); its
/// authority is exactly that `Run`. The default — `(run) => run.ok.out` — gates on
/// success and returns the whole write-set tree. If the observer returns
/// `Stream[T]`, `exec` itself returns `Stream[T]`.
fn exec[T](
  command: Command,
) with {
  /// Value source for grammar-declared environment channels.
  env: Map[String, ExecInput] = %{},
  /// Extra VFS mounts not already implied by the command's classified inputs.
  mounts: Map[Path, TreeEntry] = %{},
  /// Writable roots supplementing the grammar-derived outputs.
  writable: Array[Path] = [],
  /// Additional directories to create under writable roots before launch.
  create_dirs: Array[Path] = [],
  /// Executor-side observer evaluated with sandbox authority — defaults to the
  /// success-gated write-set tree.
  observer: Fn(Run) -> T = (run) => run.ok.out,
} -> T;
