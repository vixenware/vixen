/// An interned symbolic name.
type Symbol;
/// A normalized VFS/local path value.
type Path;
/// Opaque file content.
type Blob;
/// Raw bytes not yet committed or interpreted as a file.
type Bytes;
/// A slice/range descriptor for collection and string operations.
type Range;
/// An opaque wall-clock duration.
type Duration;
/// Opaque directory content.
type Tree;
/// A path-like exec argument carrying implicit mount provenance.
type ExecPath;
/// A runnable command — the value a CLI literal `@[ ${cmd} … ]` is built around,
/// and what `exec` consumes. It bundles its grammar, the resolved binary, how to
/// fingerprint it, and the exemptions it needs (see the wiki: "The exec
/// primitive", "Types are values"). The grammar is a *value* carried by the
/// command, projected on demand — not a static type. A capability constructs
/// `Command`s (advertising a capability is defining its commands).
type Command;
/// Marker namespace for TOML parsing.
type Toml;
/// Marker namespace for JSON parsing.
type Json;
/// Marker namespace for YAML parsing.
type Yaml;
/// Marker namespace for HTTP access.
type Http;
/// Executor-local host inspection capability.
type Host;

enum Option[T] {
  Some(T),
  None,
}

namespace Option[T] {
  /// Return the inner value, or `default` if the option is empty.
  fn unwrap_or(self, default: T) -> T;
}

/// The result of a fallible computation — what the `?` suffix yields (the failure
/// model). `Ok(v)` on success; `Err(e)` carries the caught domain error. `fail e`
/// raises; `expr?` catches it here as data instead of propagating. The caught
/// `Err` payload is a `Failure[E]`, so the failure's context survives the catch.
enum Result[T, E] {
  Ok(T),
  Err(E),
}

/// The uniform runtime envelope of a failure (the failure model's `context`):
/// the source span where the failure originated, the demand-path the poison
/// crossed, and — later — the strand stack + timing. Opaque: authors carry it
/// through (`Err(Failure { err: e, .. })`) but do not inspect it deeply; the
/// runtime derives the human report from it.
type FailureContext;

/// The single failure value (the failure model's `Failure { err, context }`): the
/// *same* value whether it propagates as a poison or is caught as `Result.Err`.
/// `err` is the domain error (the inferred union `E`); `context` is the uniform
/// envelope. `?` catches a poison into `Err(Failure { err, context })`, preserving
/// the context, and `fail f` re-raises a caught `Failure` with its context intact.
struct Failure[E] {
  err: E,
  context: FailureContext,
}

/// Surface values accepted by `exec` arguments and environment entries.
type ExecInput = String | Path | Blob | Tree | ExecPath;
/// Values that can occupy a tree entry or explicit exec mount.
type TreeEntry = Blob | Tree;

/// A host-backed sandbox exemption — a read-only hole in the sandbox for host
/// filesystem state that ordinary VFS tracking can't justify. Not a mount: it is
/// chosen by authored Vixen code and rechecked by the runtime on the concrete
/// runner. `ReadSubpath` permits reads under `root`; `ExecSubpath` additionally
/// permits executing a discovered tool. Both are read-only — host state is a
/// build input, never a sink.
enum SandboxExemption {
  struct ExecSubpath {
    root: String,
  },
  struct ReadSubpath {
    root: String,
  },
}

/// The settled outcome of a *successful* run — what `run.ok` yields. Forcing
/// `run.ok` poisons (with the failure model's report) on **any** non-success
/// (nonzero exit or a signal); reaching this record at all means the process
/// exited 0. `run.ok.out` is the whole resolved write-set tree. (See the wiki:
/// "The exec primitive" §7. `run.ok?` → `Result[Exit, ProcError]` joins when the
/// failure model's `Result` + tuple-payload variants land.)
struct Exit {
  /// Wall-clock duration of the run.
  duration: Duration,
  /// Captured standard output (bounded by the capture kwargs).
  stdout: Bytes,
  /// Captured standard error (bounded by the capture kwargs).
  stderr: Bytes,
  /// The settled write-set — every output the run finalized.
  out: Tree,
}

/// The **live**, ungated face of a `Run` (`run.stream`) — available *as the
/// process runs* and surviving a later `.ok` failure: `run.stream.out` is the
/// producing write-set tree (entries resolve as files finalize), and the streams
/// are the live feeds you parse to learn *when* a path finalized.
struct Live {
  /// Standard output as it is produced.
  stdout: Stream[Bytes],
  /// Standard error as it is produced.
  stderr: Stream[Bytes],
  /// The producing write-set tree — entries resolve as files finalize.
  out: Tree,
}

/// What an `exec` observer receives — **never a bare exit code**. Success is
/// reached through `.ok` (settled, success-gated: forcing it poisons on any
/// non-success), and the live face is `.stream`. The two ways to the output tree:
/// `run.ok.out` (gated — "the output, if it succeeded") and `run.stream.out`
/// (live — "the output as it's produced"). `.ok` is a demand edge, not a stored
/// field: forcing it runs the success gate.
struct Run {
  /// The settled, success-gated face.
  ok: Exit,
  /// The live, ungated face.
  stream: Live,
}

/// A process-termination signal — the signal number a kill delivered (room for
/// richer detail like core-dumped later).
newtype Signal of U64;

/// How a process ended when it did *not* exit 0: a nonzero exit code, or a signal.
/// `run.ok` poisons on either; `run.ok?` surfaces it as the `ProcError`'s `cause`.
enum ProcCause {
  Exited(U64),
  Signaled(Signal),
}

/// The recorded read/write set of a run — the cache key's other half (which inputs
/// were read, which outputs written). Opaque domain data carried through a failure.
type VfsTrace;

/// The domain error of a failed `exec` — what `run.ok?` yields as
/// `Result[Exit, ProcError]`. **Pure data**: the span + strand stack + demand-path
/// live in the `FailureContext` envelope (`Failure { err: ProcError, context }`),
/// uniform across all failures, not stuffed in here. (Wiki: "The exec primitive" §7.)
struct ProcError {
  /// Exit vs. kill — distinct, so a normalizer can match e.g. `Exited(7)` precisely.
  cause: ProcCause,
  /// The full effective command that ran.
  command: Command,
  /// Captured tail of stderr (bounded by the capture kwargs).
  stderr_tail: Bytes,
  /// The read/write set the run recorded.
  vfs_trace: VfsTrace,
  /// Wall-clock duration of the run.
  duration: Duration,
}

struct KeyedContext[K, J] {
  key: K,
  joined: J,
}

namespace Symbol {
  /// Convert a symbol to its textual spelling.
  fn to_string(self) -> String;
}

namespace String {
  /// Test whether the string starts with `prefix`.
  fn starts_with(self, prefix: String) -> Bool;
  /// Test whether the string ends with `suffix`.
  fn ends_with(self, suffix: String) -> Bool;
  /// Test whether the string contains `needle`.
  fn contains(self, needle: String) -> Bool;
  /// Test whether the string is empty.
  fn is_empty(self) -> Bool;
  /// Split the string by `sep`.
  fn split(self, sep: String) -> Array[String];
  /// Split the string once by `sep`.
  fn split_once(self, sep: String) -> Option[(String, String)];
  /// Split the string into lines.
  fn lines(self) -> Array[String];
  /// Trim leading and trailing whitespace.
  fn trim(self) -> String;
  /// Convert the string to uppercase.
  fn to_upper(self) -> String;
  /// Convert the string to lowercase.
  fn to_lower(self) -> String;
  /// Parse a decimal integer.
  fn to_u64(self) -> U64;
  /// Replace all occurrences of `old` with `new`.
  fn replace(self, old: String, new: String) -> String;
  /// Return the byte length of the string.
  fn len(self) -> U64;
  /// Return the string's grapheme clusters.
  fn chars(self) -> Array[String];
  /// Return a substring described by `range`.
  fn slice(self, range: Range) -> String;
}

namespace Array[T] {
  /// Apply `f` to each element.
  fn map[U](self, f: Fn(T) -> U) -> Stream[U];
  /// Map each element to a stream-like value and flatten one level.
  fn flat_map[U](self, f: Fn(T) -> U) -> Stream[U];
  /// Keep the elements for which `pred` returns true.
  fn filter(self, pred: Fn(T) -> Bool) -> Stream[T];
  /// Map and skip empty results in one pass.
  fn filter_map[U](self, f: Fn(T) -> Option[U]) -> Array[U];
  /// Return the first element for which `pred` returns true.
  fn find(self, pred: Fn(T) -> Bool) -> Option[T];
  /// Return true if any element satisfies `pred`.
  fn any(self, pred: Fn(T) -> Bool) -> Bool;
  /// Materialize an array-shaped collection as an array.
  fn to_array(self) -> Array[T];
  /// Build a map by using each element as the key.
  fn to_map[V](self, f: Fn(T) -> V) -> Map[T, V];
  /// Group elements by a derived key.
  fn group_by[K](self, f: Fn(T) -> K) -> Map[K, Array[T]];
  /// Reduce the array using the first element as the initial accumulator.
  fn reduce(self, f: Fn(T, T) -> T) -> T;
  /// Flatten one level of nested arrays.
  fn flatten(self) -> T;
  /// Merge a list of trees or tree-like fragments into one tree.
  fn merge(self) -> Tree;
}

/// Return the first element from `items`, poisoning if the array is empty.
fn array_first[T](items: Array[T]) -> T;
/// Return every element after the first.
fn array_rest[T](items: Array[T]) -> Array[T];
/// Append one item to the end of an array.
fn array_push[T](items: Array[T], item: T) -> Array[T];
/// Fold an array left-to-right.
fn array_fold[T, U](items: Array[T], init: U, step: Fn(U, T) -> U) -> U;

namespace Map[K, V] {
  /// Apply `f` to each `(key, value)` pair and collect the results.
  fn map[U](self, f: Fn(K, V) -> U) -> Stream[U];
  /// Apply `f` to each value while preserving keys.
  fn map_values[U](self, f: Fn(V) -> U) -> Map[K, U];
  /// Return true if the map contains `key`.
  fn has(self, key: K) -> Bool;
  /// Return the value for `key`, poisoning if it does not exist.
  fn get(self, key: K) -> V;
}

/// Insert or replace one map entry.
fn map_put[K, V](map: Map[K, V], key: K, value: V) -> Map[K, V];

namespace Path {
  /// Parse and normalize a path string.
  fn Path(s: String) -> Self;
  /// Convert a path back to its normalized textual spelling.
  fn to_string(self) -> String;
}

namespace Blob {
  /// Construct a text blob from a string.
  fn Blob(s: String) -> Self;
  /// Mark the blob as executable when materialized to a filesystem.
  fn executable(self) -> Self;
  /// Decode the blob as UTF-8, poisoning on invalid input.
  fn utf8(self) -> String;
  /// Decode the blob as UTF-8 with replacement on invalid input.
  fn utf8_lossy(self) -> String;
}

namespace Bytes {
  /// Construct a raw byte sequence from a string's UTF-8 encoding.
  fn Bytes(s: String) -> Self;
  /// Decode the bytes as UTF-8, poisoning on invalid input.
  fn utf8(self) -> String;
  /// Decode the bytes as UTF-8 with replacement on invalid input.
  fn utf8_lossy(self) -> String;
  /// Materialize the bytes as a blob.
  fn blob(self) -> Blob;
}

namespace Stream[T] {
  /// Apply `f` to each stream item.
  fn map[U](self, f: Fn(T) -> U) -> Stream[U];
  /// Map each item to a stream-like value and flatten one level.
  fn flat_map[U](self, f: Fn(T) -> U) -> Stream[U];
  /// Keep the items for which `pred` returns true.
  fn filter(self, pred: Fn(T) -> Bool) -> Stream[T];
  /// Flatten one level of nested arrays or streams into a single stream.
  fn flatten(self) -> T;
  /// Merge a stream of tree fragments into one tree.
  fn merge(self) -> Tree;
  /// Force the whole stream, discarding item values.
  fn for_each(self) -> Unit;
  /// Collect a stream of `(key, value)` entries into a deterministic map.
  fn to_map[K, V](self) -> Map[K, V];
  /// Collect the stream into a deterministic array value.
  fn to_array(self) -> Array[T];
  /// Collect the entire stream into a single value.
  fn collect(self) -> T;
}

namespace Toml {
  /// Parse a TOML blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
  /// Parse a TOML string into a value of type `T`.
  fn parse[T](text: String) -> T;
  /// Serialize a value to TOML.
  fn serialize[T](value: T) -> Blob;
}

namespace Json {
  /// Parse a JSON blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
  /// Parse a JSON string into a value of type `T`.
  fn parse[T](text: String) -> T;
}

namespace Yaml {
  /// Parse a YAML blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
  /// Parse a YAML string into a value of type `T`.
  fn parse[T](text: String) -> T;
}

namespace Http {
  /// Fetch a URL and return the response body as a blob.
  fn get(url: String) -> Blob;
}

namespace Tree {
  /// Construct a tree from a path-keyed map of entries.
  fn Tree(entries: Map[Path, TreeEntry]) -> Self;
  /// Construct a tree by merging an array of tree/blob values.
  fn Tree(entries: Array[TreeEntry]) -> Self;
  /// Create a lazy filesystem-backed tree handle.
  fn Tree(path: Path) -> Self;

  /// Select a blob at a relative path.
  fn file(self, path: Path) -> Blob;
  /// Select a subtree at a relative path.
  fn subtree(self, path: Path) -> Self;
  /// Merge another tree into this tree.
  fn merge(self, other: Tree) -> Self;
}

namespace Host {
  /// Canonical host operating system name, e.g. `"linux"`, `"darwin"`, or `"windows"`.
  fn os(self) -> String;
  /// Canonical host CPU architecture, e.g. `"x86_64"` or `"aarch64"`.
  fn arch(self) -> String;
  /// Resolve a tool or executable name on the executor host.
  fn which(self, name: String) -> String;
  /// Read a host file.
  fn read(self, path: String) -> Blob;
  /// Hash a host file with Blake3.
  fn hash(self, path: String) -> Blob;
}

/// Halt execution with an error message (testing/debugging primitive).
fn trap[T](message: String) -> T;

/// Demand or widen a keyed incremental computation.
fn keyed[K, J, R](key: K, joined: J, resolver: Fn(KeyedContext[K, J]) -> R) -> R;
/// Read a branch-local assumption.
fn branch_assumption[T](name: String) -> T;
/// Search candidate assumptions until one branch succeeds.
fn search_assumption[T, R](name: String, candidates: Array[T], resolver: Fn() -> R) -> R;
