/// An interned symbolic name.
type Symbol;
/// A normalized VFS/local path value.
type Path;
/// Opaque file content.
type Blob;
/// Raw bytes not yet committed or interpreted as a file.
type Bytes;
/// Opaque directory content.
type Tree;
/// A path-like exec argument carrying implicit mount provenance.
type ExecPath;
/// Marker namespace for TOML parsing.
type Toml;
/// Marker namespace for JSON parsing.
type Json;
/// Marker namespace for YAML parsing.
type Yaml;
/// Marker namespace for HTTP access.
type Http;
/// A class of equivalent executor environments.
type ExecutorClass;
/// Executor-local host inspection capability.
type Host;

/// Surface values accepted by `exec` arguments and environment entries.
type ExecInput = String | Path | Blob | Tree | ExecPath;

/// Process result visible to an `exec` observer.
struct Process {
  /// Standard output as a stream of raw bytes.
  stdout: Stream[Bytes],
  /// Standard error as a stream of raw bytes.
  stderr: Stream[Bytes],
  /// Exit status once the process finishes.
  exit_code: U64,
}

namespace Symbol {
  /// Convert a symbol to its textual spelling.
  fn to_string(self) -> String;
}

namespace String {
  /// Test whether the string starts with `prefix`.
  fn starts_with(self, prefix: String) -> Bool;
  /// Test whether the string ends with `suffix`.
  fn ends_with(self, suffix: String) -> Bool;
  /// Test whether the string contains `needle`.
  fn contains(self, needle: String) -> Bool;
  /// Test whether the string is empty.
  fn is_empty(self) -> Bool;
  /// Split the string by `sep`.
  fn split(self, sep: String) -> Array[String];
  /// Split the string once by `sep`.
  fn split_once(self, sep: String) -> Option[(String, String)];
  /// Split the string into lines.
  fn lines(self) -> Array[String];
  /// Trim leading and trailing whitespace.
  fn trim(self) -> String;
  /// Convert the string to uppercase.
  fn to_upper(self) -> String;
  /// Convert the string to lowercase.
  fn to_lower(self) -> String;
  /// Replace all occurrences of `old` with `new`.
  fn replace(self, old: String, new: String) -> String;
  /// Return the byte length of the string.
  fn len(self) -> U64;
  /// Return the string's grapheme clusters.
  fn chars(self) -> Array[String];
  /// Return a substring described by `range`.
  fn slice(self, range: Range) -> String;
}

namespace Array[T] {
  /// Apply `f` to each element.
  fn map[U](self, f: Fn(T) -> U) -> Array[U];
  /// Build a map by using each element as the key.
  fn to_map[V](self, f: Fn(T) -> V) -> Map[T, V];
  /// Flatten one level of nested arrays.
  fn flatten(self) -> T;
  /// Merge a list of trees or tree-like fragments into one tree.
  fn merge(self) -> Tree;
}

namespace Map[K, V] {
  /// Apply `f` to each value while preserving keys.
  fn map_values[U](self, f: Fn(V) -> U) -> Map[K, U];
}

namespace Path {
  /// Parse and normalize a path string.
  fn Path(s: String) -> Self;
  /// Convert a path back to its normalized textual spelling.
  fn to_string(self) -> String;
}

namespace Blob {
  /// Construct a text blob from a string.
  fn Blob(s: String) -> Self;
  /// Mark the blob as executable when materialized to a filesystem.
  fn executable(self) -> Self;
  /// Decode the blob as UTF-8, poisoning on invalid input.
  fn utf8(self) -> String;
  /// Decode the blob as UTF-8 with replacement on invalid input.
  fn utf8_lossy(self) -> String;
}

namespace Bytes {
  /// Construct a raw byte sequence from a string's UTF-8 encoding.
  fn Bytes(s: String) -> Self;
  /// Decode the bytes as UTF-8, poisoning on invalid input.
  fn utf8(self) -> String;
  /// Decode the bytes as UTF-8 with replacement on invalid input.
  fn utf8_lossy(self) -> String;
  /// Materialize the bytes as a blob.
  fn blob(self) -> Blob;
}

namespace Stream[T] {
  /// Collect the entire stream into a single value.
  fn collect(self) -> T;
}

namespace Toml {
  /// Parse a TOML blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
  /// Serialize a value to TOML.
  fn serialize[T](value: T) -> Blob;
}

namespace Json {
  /// Parse a JSON blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
}

namespace Yaml {
  /// Parse a YAML blob into a value of type `T`.
  fn parse[T](blob: Blob) -> T;
}

namespace Http {
  /// Fetch a URL and return the response body as a blob.
  fn get(url: String) #discover -> Blob;
}

namespace Tree {
  /// Construct a tree from a path-keyed map of entries.
  fn Tree(entries: Map[Path, Blob | Tree]) -> Self;
  /// Construct a tree by merging an array of tree/blob values.
  fn Tree(entries: Array[Tree | Blob]) -> Self;
  /// Create a lazy filesystem-backed tree handle.
  fn Tree(path: Path) #fs -> Self;

  /// Select a blob at a relative path.
  fn file(self, path: Path) -> Blob;
  /// Select a subtree at a relative path.
  fn subtree(self, path: Path) -> Self;
  /// Merge another tree into this tree.
  fn merge(self, other: Tree) -> Self;
}

namespace Host {
  /// Resolve a tool or executable name on the executor host.
  fn which(self, name: String) -> String;
  /// Read a host file.
  fn read(self, path: String) -> Blob;
  /// Hash a host file with Blake3.
  fn hash(self, path: String) -> Blob;
}
