// Lua build sketch
//
// This is a design sketch, not a parser-validated fixture. It lives next to
// a local checkout of the Lua sources under `zoo/lua-src/`, which is ignored
// by git.

let core_sources = [
  @lapi.c, @lcode.c, @lctype.c, @ldebug.c, @ldo.c, @ldump.c,
  @lfunc.c, @lgc.c, @llex.c, @lmem.c, @lobject.c, @lopcodes.c,
  @lparser.c, @lstate.c, @lstring.c, @ltable.c, @ltm.c,
  @lundump.c, @lvm.c, @lzio.c,
];

let aux_sources = [@lauxlib.c];

let lib_sources = [
  @lbaselib.c, @ldblib.c, @liolib.c, @lmathlib.c, @loslib.c,
  @ltablib.c, @lstrlib.c, @lutf8lib.c, @loadlib.c, @lcorolib.c,
  @linit.c,
];

let all_lib_sources = [..core_sources, ..aux_sources, ..lib_sources];

let cflags = ["-Wall", "-O2", "-std=c99"];
let ldflags = [];
let syslibs = ["-lm"];

fn build(ws: Path, args: Array[String], env: Map[String, String]) #fs #discover -> Tree (
  struct Tool {
    path: String,
    hash: Blob,
  }

  namespace Tool {
    fn to_string(self) -> String self.path;
  }

  let class = executor_class("default");
  let src_tree = Tree(ws / @zoo/lua-src);
  let toolchain =
    discover(class, (host) =>
      // The map stays demand-driven: each discovered tool can become
      // available independently, and later `exec` only rechecks the
      // obligations attached to the tool values it actually consumes.
      //
      // On macOS, we currently archive with `libtool -static` rather than
      // `ar`, because `/usr/bin/ar` internally invokes `ranlib`, which still
      // trips a VFS rename bug tracked in issue #252.
      [:cc, :libtool]
        |> _.to_map(host.which)
        |> _.map_values((path) => Tool { path, hash: host.hash(path) })
    );
  let { cc, libtool } = toolchain;

  let common = {
    observer: (proc, vfs) => (
      if proc.exit_code != 0 (
        fail `process failed`
      ) else (
        vfs.subtree(@out)
      )
    ),
  };

  let cexec = partial exec with common;

  fn compile(file: Path) -> Tree (
    cexec [
      cc,
      "-c",
      ..cflags,
      "-o",
      @(out/obj/{file}.o),
      @(src/{file}),
    ] with {
      mounts: %{ @src => src_tree },
    }
  );

  fn archive(objs: Tree) -> Tree (
    cexec [libtool, "-static", "-o", @out/liblua.a, ..objs]
  );

  fn link(objs: Tree) -> Tree (
    cexec [cc, "-o", @out/bin/lua, ..ldflags, ..objs, ..syslibs]
  );

  let objects = (all_lib_sources.map(compile)).merge();
  let liblua = archive(objects);

  let lua_exe = link(Tree [compile @lua.c, liblua]);

  Tree %{
    @bin/lua => lua_exe.file(@bin/lua).executable(),
    @lib/liblua.a => liblua.file(@liblua.a),
  }
)
