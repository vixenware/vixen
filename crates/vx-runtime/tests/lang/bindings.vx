// Let bindings: chained, ascribed, aliased — and lazy, so an unused binding is
// never forced (the bomb stays cold).

#[test]
fn single_let() ( let x = 40; assert_eq(x + 2, 42) )

#[test]
fn chained_lets() ( let a = 10; let b = a + 20; assert_eq(b + 12, 42) )

// Demand-driven: a binding that is never read is never forced.
#[test]
fn unused_binding_never_forced() ( let x = 💣; assert_eq(40 + 2, 42) )

#[test]
fn type_ascription_passthrough() ( let x: U64 = 42; assert_eq(x, 42) )

#[test]
fn binding_chain_aliases() ( let p = (1, 2); let q = p; assert_eq(q[0], 1) )
