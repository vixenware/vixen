// Enum variants in the runtime: construction (struct-form + unit) and pattern
// matching. The value carries its tag; `match` compares the tag and binds the
// payload. A non-generic enum keeps the focus on eval, not type inference.
// Cross-mode parity (Off/Interp/Jit) is the oracle.

enum Light {
  struct On { level: U64 },
  struct Off,
}

#[test]
fn match_binds_a_fielded_variant() (
  let l = On { level: 5 };
  assert_eq(match l ( On { level: x } => x, Off => 0 ), 5)
)

#[test]
fn unit_variant_matches_on_its_tag() (
  let l = Off;
  assert_eq(match l ( On { level: x } => x, Off => 42 ), 42)
)

#[test]
fn the_tag_selects_the_arm_not_the_fields() (
  // The tag decides which arm fires; the wildcard ignores the payload.
  let l = On { level: 1 };
  assert_eq(match l ( Off => 0, On { level: _ } => 7 ), 7)
)

// Tuple-payload variants: declaration `Name(T…)`, construction `Name(v…)`, and
// positional matching `Name(x…)`. A tuple variant is a struct variant whose
// payload fields are named by index, so it flows through the same machinery.

enum Sign {
  Pos(U64),
  Neg(U64),
  Zero,
}

#[test]
fn match_binds_a_tuple_variant() (
  let s = Pos(7);
  assert_eq(match s ( Pos(n) => n, Neg(n) => n, Zero => 0 ), 7)
)

#[test]
fn tuple_form_unit_variant_matches() (
  let s = Zero;
  assert_eq(match s ( Pos(n) => n, Neg(n) => n, Zero => 99 ), 99)
)

enum Pair {
  Both(U64, U64),
  Neither,
}

#[test]
fn match_binds_multiple_tuple_fields() (
  let p = Both(3, 4);
  assert_eq(match p ( Both(a, b) => a + b, Neither => 0 ), 7)
)
