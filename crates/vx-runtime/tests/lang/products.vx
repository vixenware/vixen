// Products: tuple indexing and named fields, including aliasing and projection
// across a function boundary. (The bomb-in-dead-slot demand cases live in
// demand_basis.vx; here the focus is the projection shapes themselves.)

fn pick(p: (U64, U64)) -> U64 ( p[0] )

#[test]
fn second_index() ( let p = (99, 42); assert_eq(p[1], 42) )

#[test]
fn anonymous_record_field() ( let r = { a: 42, b: 99 }; assert_eq(r.a, 42) )

#[test]
fn projection_across_a_call() ( assert_eq(pick((42, 💣)), 42) )
