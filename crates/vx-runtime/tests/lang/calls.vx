// Function calls: direct, multi-arg, chained, local sharing, and call-laziness
// (an argument in a dead slot is never evaluated).

fn add_one(n: U64) -> U64 ( n + 1 )
fn add(a: U64, b: U64) -> U64 ( a + b )
fn plus_one(n: U64) -> U64 ( n + 1 )
fn pick_first(p: (U64, U64)) -> U64 ( p[0] )

#[test]
fn direct_call() ( assert_eq(add_one(41), 42) )

#[test]
fn multi_arg_call() ( assert_eq(add(20, 22), 42) )

#[test]
fn call_chain() ( assert_eq(add_one(add_one(40)), 42) )

#[test]
fn local_sharing() ( let n = 10; let x = plus_one(n); assert_eq(x + x, 22) )

// The pair is constructed and passed, but only its live slot is read.
#[test]
fn dead_sibling_through_call() ( let p = (42, 💣); assert_eq(pick_first(p), 42) )
