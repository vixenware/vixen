// The failure model's inferred error union: `expr?` types as
// `Result[inner, Failure[E]]`, where `E` is the union of error types that can reach
// that `?` through the call graph. The error-union pass computes `E` (a whole-call-
// graph fixpoint) and re-types the `match` so `Err(Failure { err: e })` binds the
// real `E`. At runtime, `?` wraps the outcome by VALUE (`Ok(v)` / a caught
// `Err(Failure { err: failed_value, .. })`), independent of the static `E` — so
// these run identically across modes (Off/Interp/Jit), the oracle.

// ---------------------------------------------------------------------------
// (a) Single-source error: the only reachable `fail` is a `String`, so `E`
//     infers as `String` and `e.len()` type-checks on the `Err` binding.
// ---------------------------------------------------------------------------

fn checked_str(x: U64) -> U64 (
  if x > 0 ( x ) else ( fail "non-positive" )
)

#[test]
fn single_source_err_binds_a_string() (
  // `E = String` (inferred, not hardcoded): destructuring the caught
  // `Failure { err: e }` binds `e` to the failed String, so `.len()` works —
  // "non-positive" is 12 chars.
  assert_eq(match checked_str(0)? ( Ok(v) => v, Err(Failure { err: e }) => e.len() ), 12)
)

#[test]
fn single_source_ok_yields_the_value() (
  assert_eq(match checked_str(42)? ( Ok(v) => v, Err(Failure { err: e }) => e.len() ), 42)
)

// ---------------------------------------------------------------------------
// (b) Heterogeneous union: two functions failing with DIFFERENT error types —
//     one a `String`, one a custom enum value — both reachable through a single
//     `?`. `E` infers as the union `String | DomainErr`, so the caught payload is
//     `Failure[String | DomainErr]`. The `Err(Failure { err: e })` arm binds `e`
//     to that union; we don't read `e` (just take the arm), so it stays decidable
//     across modes.
// ---------------------------------------------------------------------------

enum DomainErr {
  TooSmall,
  TooBig,
}

fn fails_with_string(x: U64) -> U64 (
  if x > 0 ( x ) else ( fail "string-error" )
)

fn fails_with_enum(x: U64) -> U64 (
  if x < 100 ( x ) else ( fail TooBig )
)

// A single `?` whose inner subtree reaches BOTH failure sources (the `+`'s two
// operands), so the `?` sees the heterogeneous union `String | DomainErr`. The
// `let r = …?; match r (…)` form is the v1-supported dataflow: phase D re-types
// `r` and the `Err(e)` binding to the inferred union.
fn combine(a: U64, b: U64) -> U64 (
  let r = (fails_with_string(a) + fails_with_enum(b))?;
  match r ( Ok(v) => v, Err(Failure { err: e }) => 0 )
)

#[test]
fn heterogeneous_union_ok_path() (
  // Both succeed (a>0 and b<100): Ok(7 + 3) == 10.
  assert_eq(combine(7, 3), 10)
)

#[test]
fn heterogeneous_union_string_err_path() (
  // a == 0 → the String branch fails first; the `?` catches it, Err arm → 0.
  assert_eq(combine(0, 3), 0)
)

#[test]
fn heterogeneous_union_enum_err_path() (
  // a ok, b == 100 → the enum branch fails; the `?` catches it, Err arm → 0.
  assert_eq(combine(7, 100), 0)
)
