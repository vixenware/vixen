// If/else: only the taken branch runs (the untaken side is a bomb), plus the
// comparison/equality operators.

#[test(kernel)]
fn if_true() ( assert_eq(if true ( 42 ) else ( 0 ), 42) )

#[test(kernel)]
fn if_false() ( assert_eq(if false ( 0 ) else ( 42 ), 42) )

#[test]
fn nested_if() ( assert_eq(if true ( if false ( 0 ) else ( 42 ) ) else ( 99 ), 42) )

#[test]
fn bool_binding_condition() ( let b = true; assert_eq(if b ( 42 ) else ( 0 ), 42) )

// The untaken branch is never evaluated — the bomb in the dead side stays cold.
#[test]
fn untaken_branch_is_cold() ( assert_eq(if true ( 42 ) else ( 💣 ), 42) )

#[test]
fn equality() ( assert(1 == 1) )

#[test]
fn inequality() ( assert(1 != 2) )
