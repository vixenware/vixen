// The failure model: `fail e` raises a typed error; `expr?` catches it as a
// `Result` value (`Ok(v)` / `Err(Failure { err })`) instead of propagating. The
// caught `Err` payload is the `Failure { err, context }` envelope, so the failure's
// context survives the catch; destructure it to reach the domain `err`. A bare
// `fail "…"` carries a `String` err. Cross-mode parity (Off/Interp/Jit) is the
// oracle.

fn checked(x: U64) -> U64 (
  if x > 0 ( x ) else ( fail "non-positive" )
)

#[test]
fn catch_ok_yields_the_value() (
  assert_eq(match checked(42)? ( Ok(v) => v, Err(Failure { err: e }) => 0 ), 42)
)

#[test]
fn catch_err_takes_the_err_arm() (
  assert_eq(match checked(0)? ( Ok(v) => v, Err(Failure { err: e }) => 7 ), 7)
)

#[test]
fn caught_err_is_the_failed_value() (
  // The caught Failure's `err` is the `fail`ed String — 12 chars of
  // "non-positive". Destructure `Err(Failure { err: e })` to reach it.
  assert_eq(match checked(0)? ( Ok(v) => v, Err(Failure { err: e }) => e.len() ), 12)
)

#[test(poisons)]
fn reraise_of_a_caught_failure_poisons() (
  // `fail f` re-raises a caught Failure, preserving its err + context (the value
  // is the same Failure, not a fresh one). Here the Err arm catches the failure
  // and immediately re-raises it with `fail f`; with no outer `?`, that re-raise
  // propagates and poisons — consistently across all modes.
  match checked(0)? (
    Ok(v) => v,
    Err(f) => fail f
  )
)

#[test(poisons)]
fn an_uncaught_failure_poisons() (
  // No `?` — the failure propagates and poisons the whole evaluation.
  checked(0)
)
