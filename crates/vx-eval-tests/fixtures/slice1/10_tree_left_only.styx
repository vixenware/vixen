source <<VX,vixen
enum Tree {
  struct Leaf { val: U64 }
  struct Node { left: Tree, right: Tree }
}

fn bomb() -> Tree ( trap("boom") )

fn leftmost(t: Tree) -> U64 (
  match t (
    Leaf { val } => val,
    Node { left, right } => leftmost(left),
  )
)

fn main() -> U64 (
  let tree = Node {
    left: Node { left: Leaf { val: 42 }, right: bomb() },
    right: bomb()
  };
  leftmost(tree)
)
VX

entry main
expect @u64"42"

trace {
  not_entered (bomb)
}
