source <<VX,vixen
enum List {
  struct Cons { head: U64, tail: List }
  struct Nil {}
}

fn length(list: List) -> U64 (
  match list (
    Cons { head, tail } => 1 + length(tail),
    Nil {} => 0,
  )
)

fn main() -> U64 (
  length(Cons { head: 10, tail: Cons { head: 20, tail: Cons { head: 30, tail: Nil {} } } })
)
VX

entry main
expect @u64"3"
