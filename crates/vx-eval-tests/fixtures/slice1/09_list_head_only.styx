source <<VX,vixen
enum List {
  struct Cons { head: U64, tail: List }
  struct Nil {}
}

fn bomb() -> List ( trap("boom") )

fn main() -> U64 (
  let list = Cons { head: 42, tail: bomb() };
  match list (
    Cons { head, tail } => head,
    Nil {} => 0,
  )
)
VX

entry main
expect @u64"42"

trace {
  not_entered (bomb)
}
