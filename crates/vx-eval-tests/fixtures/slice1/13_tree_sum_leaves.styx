source <<VX,vixen
enum Tree {
  struct Leaf { val: U64 }
  struct Node { left: Tree, right: Tree }
}

fn sum_leaves(t: Tree) -> U64 (
  match t (
    Leaf { val } => val,
    Node { left, right } => sum_leaves(left) + sum_leaves(right),
  )
)

fn main() -> U64 (
  sum_leaves(Node {
    left: Node { left: Leaf { val: 1 }, right: Leaf { val: 2 } },
    right: Leaf { val: 3 }
  })
)
VX

entry main
expect @u64"6"
