source <<VX,vixen
enum List {
  struct Cons { head: U64, tail: List }
  struct Nil {}
}

fn map_double(list: List) -> List (
  match list (
    Cons { head, tail } => Cons { head: head + head, tail: map_double(tail) },
    Nil {} => Nil {},
  )
)

fn sum(list: List) -> U64 (
  match list (
    Cons { head, tail } => head + sum(tail),
    Nil {} => 0,
  )
)

fn main() -> U64 (
  sum(map_double(Cons { head: 1, tail: Cons { head: 2, tail: Cons { head: 3, tail: Nil {} } } }))
)
VX

entry main
expect @u64"12"
