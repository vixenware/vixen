source <<VX,vixen
enum Option {
  struct Some { val: U64 }
  struct None {}
}

fn main() -> U64 (
  let a = Some { val: 10 };
  let b = None {};
  let x = match a (
    Some { val } => val,
    None {} => 0,
  );
  let y = match b (
    Some { val } => val,
    None {} => 5,
  );
  x + y
)
VX

entry main
expect @u64"15"
