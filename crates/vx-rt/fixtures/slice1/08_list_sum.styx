source <<VX,vixen
enum List {
  struct Cons { head: U64, tail: List }
  struct Nil {}
}

fn sum(list: List) -> U64 (
  match list (
    Cons { head, tail } => head + sum(tail),
    Nil {} => 0,
  )
)

fn main() -> U64 (
  sum(Cons { head: 1, tail: Cons { head: 2, tail: Cons { head: 3, tail: Nil {} } } })
)
VX

entry main
expect @u64"6"
