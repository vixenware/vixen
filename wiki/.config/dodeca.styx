@schema {id crate:dodeca-config@1, cli ddc}

source {
    content content
    impls ()
    page_types {
        Doc @object{
            tags @optional(@seq(@string))
            type @string
            created @optional(@string)
            tiers @optional(@seq(@string))
            updated @optional(@string)
        }
        Task @object{
            blocked_by @optional(@seq(@link(@Task)))
            blocks @optional(@seq(@link(@Task)))
            type @string
            updated @optional(@string)
            tags @optional(@seq(@string))
            tiers @optional(@seq(@string))
            priority @optional(@enum{medium, low, high})
            created @string
            status @enum{todo, in-progress, done, abandoned, blocked, superseded}
            owner @optional(@string)
        }
    }
    skip_domains ()
}

site {output public}
