// cargo.vix — sketch v0: build a Rust workspace member, registry deps and
// all. Written AS IF the primitives existed; every ??-marked construct is a
// decision the sketch is demanding. This file is the forcing function for
// the version-resolution design round (they are one cycle).

use vix::{Tree, Path, Target};
use caps::{Rustc, Registry};

/// A parsed manifest. TOML arrives as a vix VALUE via `toml()` — decision
/// D1: deserialization is a pure fn Tree-path → Value, structural typing
/// against a declared shape, same journal/pin story as everything else.
struct Manifest {
    name: String,
    version: String,
    deps: [Requirement],
    features: Map<String, [String]>,
}

/// What Cargo.toml's `[dependencies]` rows become.
struct Requirement {
    name: String,
    req: VersionReq,        // ?? D2: VersionReq is a language type or a
    features: [String],     //    registry-capability type? (lean: caps)
    optional: Bool,
}

/// One resolved node: an exact package identity. NOTE: no source URL — the
/// checksum IS the identity (fetch doctrine); the registry only HINTS where
/// bytes live.
struct PkgId {
    name: String,
    version: String,
    checksum: String,
}

/// One node of the SOLVED graph — see decisions.md D3/D4/D8. `solve` is a
/// primitive: the search runs runtime-side, every fact it consumes is a
/// pure/pinned vix question (available_versions = pinned observation,
/// manifest_of = checksum-addressed). Feature UNIFICATION happens inside
/// solve (features ⟷ optional deps ⟷ versions are mutually recursive —
/// that's the solver's problem, not the language's). The lockfile is the
/// journal slice covering resolution's pins; the result is recomputed, not
/// pinned.
struct ResolvedPkg {
    id: PkgId,
    features: [String],   // unified: union over dependents, per universe
    deps: [Int],          // indices into the resolved graph
}

fn resolve(reg: Registry, roots: [Requirement]) -> [ResolvedPkg] {
    solve(reg, roots)
}

/// Fetch + unpack one package's source tree, by content.
fn pkg_src(reg: Registry, pkg: PkgId) -> Tree {
    // D5: registry.fetch is fetch-with-checksum; the URL template is the
    // registry capability's business (its fingerprint covers index rules).
    extract(reg.fetch(pkg.checksum)) / p"src-root"  // ?? layout probing
}

/// Compile one crate. D6 — the rmeta move, language-level: downstream
/// crates project `libfoo.rmeta` out of the STILL-RUNNING upstream rustc;
/// only the final binary link demands full rlibs (identity). This is the
/// producing-handles weld carrying the whole crate graph's pipelining.
fn crate_obj(rustc: Rustc, pkg: PkgId, src: Tree, deps: [Tree], features: [String], edition: String) -> Tree {
    let externs = deps.map(|d| ["--extern", d / p"lib.rmeta"]);  // ?? D6 naming
    let cfgs = features.map(|f| ["--cfg", "feature=\"" + f + "\""]);
    rustc! {
        --edition {edition}
        --crate-name {pkg.name}
        {externs} {cfgs}
        -O {src / p"lib.rs"}
        -o {p"lib".with_ext("rlib")}
    }
}

/// The whole dependency closure, demand-driven: nothing about node N is
/// fetched/parsed/compiled unless the graph demands it. D7: recursion +
/// MEMO IS the build graph — a diamond dep is one (id × features × deps)
/// memo key, compiled once, with zero explicit graph bookkeeping. The
/// D8 name-filtering hack is dead: the solved graph's indices are data.
fn build_dep(rustc: Rustc, reg: Registry, resolved: [ResolvedPkg], ix: Int) -> Tree {
    let node = resolved[ix];
    let src = pkg_src(reg, node.id);
    let man = manifest_of(reg, node.id);
    let dep_libs = node.deps.map(|d| build_dep(rustc, reg, resolved, d)).collect();
    // features are identity: they become --cfg argv items, hence part of
    // the normalized plan, hence part of BOTH cache tiers. Unification
    // upstream is what makes this sharing-correct.
    crate_obj(rustc, node.id, src, dep_libs, node.features, man_edition(man))
}

/// The entry: build a workspace member for a target.
pub fn build(target: Target, workspace: Tree, member: String) -> Tree {
    let rustc = Rustc::acquire(target);
    let reg = Registry::acquire("crates-io");   // a capability: index rules,
                                                // URL templates, fingerprint
    let man = toml(workspace / p"Cargo.toml");  // D1 again, root manifest
    let resolved = resolve(reg, man.deps);
    // roots of the solved graph = direct deps of the member
    let deps = root_indices(resolved, man.deps)
        .map(|i| build_dep(rustc, reg, resolved, i)).collect();
    crate_obj(rustc, member_pkg(man, member), workspace / p"src", deps,
              member_features(man, member), "2024")
}
