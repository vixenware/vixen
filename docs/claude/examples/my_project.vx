// my_project.vx — Example user project build file

use std.rust.build     { build_root }
use std.rust.toolchain { acquire_toolchain, Channel }
use std.rust.types     { BuildCtx, Triple }

let host   = Triple { arch = "aarch64", vendor = "apple", os = "darwin", env = "" }
let target = host

let ctx = BuildCtx {
  host          = host,
  target        = target,
  toolchain     = acquire_toolchain(channel = Channel.Stable, target = target),
  registry      = crates_io_registry(),
  lock          = source_tree().get("Cargo.lock").map(parse_lock),
  root_features = set { "default" },
}

let my_crate = build_root(source_tree(), ctx)

// Demand from the CLI:
//   vixen build my_crate.rlib
//   vixen build my_crate.rmeta
//   vixen show my_crate.diagnostics
