// std/rust/monitor.vx — Rustc JSON output parser
//
// This is the parse function passed to exec. It runs on the executor,
// parsing rustc's JSON stdout and yielding typed events as artifacts
// and diagnostics appear.

use std.rust.types {
  RustcEvent, RMeta, RLib, Diagnostic, Finished,
  RustDiagnostic, DiagnosticSpan,
}

// Parse rustc's --json output line by line, yielding events.
// This function is a generator — it yields RustcEvent values.
fn rustc_json(process: Process) -> Stream<RustcEvent> = {
  for line in process.stdout_lines() {
    let msg = json_parse(line)

    match msg["reason"] {
      "compiler-artifact" => {
        let filenames = msg["filenames"]

        for filename in filenames {
          if filename.ends_with(".rmeta") {
            yield RMeta(store.commit(filename))
          }
          if filename.ends_with(".rlib") {
            yield RLib(store.commit(filename))
          }
        }
      }

      "compiler-message" => {
        let inner = msg["message"]
        yield Diagnostic(RustDiagnostic {
          level:    inner["level"],
          message:  inner["message"],
          rendered: inner["rendered"],
          spans:    inner["spans"].map(|s| DiagnosticSpan {
            file_name:    s["file_name"],
            line_start:   s["line_start"],
            line_end:     s["line_end"],
            column_start: s["column_start"],
            column_end:   s["column_end"],
            text:         s["text"].map($.text).join("\n"),
          }),
        })
      }

      "build-finished" => {
        yield Finished(msg["success"])
      }
    }
  }
}

// Parse build script stdout (cargo: directives).
fn parse_build_script_stdout(process: Process) -> Stream<BuildScriptDirective> = {
  for line in process.stdout_lines() {
    if line.starts_with("cargo:") {
      let directive = line.strip_prefix("cargo:")

      if directive.starts_with("rustc-env=") {
        let kv = directive.strip_prefix("rustc-env=").split_once("=")
        yield RustcEnv { key: kv.0, value: kv.1 }
      }
      else if directive.starts_with("rustc-cfg=") {
        yield RustcCfg { cfg: directive.strip_prefix("rustc-cfg=") }
      }
      else if directive.starts_with("rustc-link-search=") {
        yield LinkSearch { path: directive.strip_prefix("rustc-link-search=") }
      }
      else if directive.starts_with("rustc-link-lib=") {
        yield LinkLib { lib: directive.strip_prefix("rustc-link-lib=") }
      }
    }
  }
}

enum BuildScriptDirective {
  RustcEnv    { key: String, value: String }
  RustcCfg    { cfg: String }
  LinkSearch  { path: String }
  LinkLib     { lib: String }
}
