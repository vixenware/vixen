// std/rust/build.vx — Core Rust build logic

use std.rust.types {
  BuildCtx, BuiltCrate, RustcEvent, RMeta, RLib, Diagnostic,
  ResolvedPkg, ResolvedEdge, BuildScriptOut, Role,
}
use std.rust.resolve  { resolve_root }
use std.rust.monitor  { rustc_json }

// Entry point: resolve the root crate and build it.
fn build_root(root_src: Tree, ctx: BuildCtx) -> BuiltCrate =
  build_pkg(resolve_root(root_src, ctx), ctx)

// Build a resolved package.
//
// This is a plain function. Repeated calls with identical (pkg, ctx)
// arguments are automatically shared by the runtime — no explicit
// memoization needed. If two crates depend on the same resolved package,
// build_pkg is called twice but executes once.
//
// The same applies to host vs target builds: pkg.role is part of the
// argument identity, so build_pkg(dep, ctx) with role=Host and
// build_pkg(dep, ctx) with role=Target are different computations with
// different cached results.
fn build_pkg(pkg: ResolvedPkg, ctx: BuildCtx) -> BuiltCrate = {
  // Build host-side dependencies first (build-dependencies).
  // These are needed for build scripts and proc macros.
  let host_deps =
    pkg.deps
      .filter($.role == Host)
      .map(|edge| edge.extern_name => build_pkg(edge.pkg, ctx))
      .into_map()

  // Run the build script, if any. It may produce:
  // - OUT_DIR with generated code
  // - cargo:rustc-env=KEY=VALUE
  // - cargo:rustc-cfg=FEATURE
  // - cargo:rustc-link-search=PATH
  // - cargo:rustc-link-lib=LIB
  let build_out =
    run_build_script_if_any(pkg, host_deps, ctx)

  // Build target-side dependencies (normal dependencies).
  // Only their rmeta is needed for pipelining.
  let target_deps =
    pkg.deps
      .filter($.role == Target)
      .map(|edge| edge.extern_name => build_pkg(edge.pkg, ctx))
      .into_map()

  // The extern tree: each dependency's rmeta, named for --extern.
  // dep.rmeta is lazy — blocks until that dep's rustc emits metadata.
  let externs = tree {
    for (name, dep) in target_deps {
      "lib${name}.rmeta" = dep.rmeta
    }
  }

  let events = rustc_events(@pkg, @externs, @build_out, @ctx)

  // The returned struct's fields are lazy projections over the shared
  // event stream. Nothing computes until demanded.
  {
    rmeta       = events.find($ as RMeta).0,
    rlib        = events.find($ as RLib).0,
    diagnostics = events.filter($ as Diagnostic).map($.0),
  }
}

// Run rustc and return its event stream.
fn rustc_events(
  pkg: ResolvedPkg,
  externs: Tree,
  build_out: BuildScriptOut,
  ctx: BuildCtx,
) -> Stream<RustcEvent> =
  exec(
    cmd: rustc_argv(@pkg, @externs, @build_out, @ctx),

    mount: {
      "/src":  pkg.src,
      "/deps": externs,
      "/out":  empty_tree(),
    },

    parse: rustc_json,
  )

// Build the full rustc command line.
fn rustc_argv(
  pkg: ResolvedPkg,
  externs: Tree,
  build_out: BuildScriptOut,
  ctx: BuildCtx,
) -> List<String> = {
  let lib = pkg.manifest.lib ?? LibTarget { path = "src/lib.rs", crate_type = "lib" }

  [
    ctx.toolchain.rustc,
    "--crate-name", pkg.manifest.package.name,
    "--edition", pkg.manifest.package.edition,
    "--crate-type", lib.crate_type,
    "--emit", "metadata,link",
    "--json", "artifacts,diagnostic-rendered-ansi",
    "--out-dir", "/out",
    "-L", "dependency=/deps",

    // Extern declarations from dependencies
    for entry in externs.entries() {
      "--extern", "${entry.stem}=${entry.path}"
    },

    // Feature cfgs
    for feat in pkg.enabled_features {
      "--cfg", "feature=\"${feat}\""
    },

    // Build script cfgs
    for cfg in build_out.rustc_cfg {
      "--cfg", cfg
    },

    // Build script env
    for (key, value) in build_out.rustc_env {
      "--env", "${key}=${value}"
    },

    // The source file
    "/src/${lib.path}",
  ]
}

// --- Build scripts ---

fn run_build_script_if_any(
  pkg: ResolvedPkg,
  host_deps: Map<String, BuiltCrate>,
  ctx: BuildCtx,
) -> BuildScriptOut =
  match pkg.manifest.build_script {
    None    => empty_build_script_out()
    Some(s) => run_build_script(pkg, s, host_deps, ctx)
  }

fn run_build_script(
  pkg: ResolvedPkg,
  script_path: String,
  host_deps: Map<String, BuiltCrate>,
  ctx: BuildCtx,
) -> BuildScriptOut = {
  // First, compile the build script itself (as a host binary).
  let script_bin = compile_build_script(pkg, script_path, host_deps, ctx)

  // Then run it. Build scripts communicate via stdout lines:
  // cargo:rustc-env=KEY=VALUE
  // cargo:rustc-cfg=FEATURE
  // cargo:rustc-link-search=PATH
  // cargo:rustc-link-lib=LIB
  let events = exec(
    cmd: [script_bin],

    env: {
      "CARGO_MANIFEST_DIR": "/src",
      "OUT_DIR":            "/out",
      "TARGET":             ctx.target.to_string(),
      "HOST":               ctx.host.to_string(),

      for feat in pkg.enabled_features {
        "CARGO_FEATURE_${feat.to_upper()}": "1"
      },
    },

    mount: {
      "/src": pkg.src,
      "/out": empty_tree(),
    },

    parse: parse_build_script_stdout,
  )

  collect_build_script_out(events)
}

fn empty_build_script_out() -> BuildScriptOut =
  {
    out_dir     = empty_tree(),
    rustc_env   = {},
    rustc_cfg   = set {},
    link_search = [],
    link_libs   = [],
  }
