// std/rust/types.vx — Type definitions for Rust builds

// --- Build context ---

struct BuildCtx {
  host: Triple
  target: Triple
  toolchain: Toolchain
  registry: Registry
  lock: Option<CargoLock>
  root_features: Set<String>
}

struct Triple {
  arch: String
  vendor: String
  os: String
  env: String
}

// --- Toolchain ---

struct Toolchain {
  rustc: Blob
  std: Tree
  version: String
  target: Triple
}

// --- Source requirements ---

enum SourceReq {
  Registry {
    crate: String
    req: VersionReq
    registry: String = "crates-io"
  }

  Git {
    url: String
    rev: Option<String>
    subdir: String = "."
  }

  Path {
    path: String
  }
}

// Concrete resolved source (after consulting lockfile / registry)
enum SourceRef {
  Registry { download_url: String, checksum: String }
  Git      { url: String, rev: String, subdir: String }
  Path     { path: String }
}

// --- Dependency model ---

enum DepKind { Normal Build Dev }
enum Role    { Target Host }

struct DepSpec {
  extern_name: String
  package_name: String
  source: SourceReq

  default_features: Bool
  features: Set<String>
  optional: Bool

  kind: DepKind
  target_when: Option<CfgExpr>
}

// --- Manifest ---

struct CargoManifest {
  package: Package
  lib: Option<LibTarget>
  build_script: Option<String>

  dependencies: List<DepSpec>
  features: Map<String, List<FeatureItem>>
}

struct Package {
  name: String
  version: String
  edition: String
}

struct LibTarget {
  path: String
  crate_type: String
}

enum FeatureItem {
  Feature(String)
  Dep(String)
  DepFeature { dep: String, feature: String }
}

// --- Resolution ---

struct ResolveReq {
  source: SourceReq
  role: Role
  default_features: Bool
  requested_features: Set<String>
}

struct ResolvedEdge {
  extern_name: String
  kind: DepKind
  role: Role
  pkg: ResolvedPkg
}

struct ResolvedPkg {
  id: PackageId
  source: SourceRef
  src: Tree

  manifest: CargoManifest
  role: Role
  enabled_features: Set<String>
  deps: List<ResolvedEdge>
}

struct PackageId {
  name: String
  version: String
  source: SourceRef
}

// --- Build script ---

struct BuildScriptOut {
  out_dir: Tree
  rustc_env: Map<String, String>
  rustc_cfg: Set<String>
  link_search: List<String>
  link_libs: List<String>
}

// --- Build output ---

struct BuiltCrate {
  rmeta: Blob
  rlib: Blob
  diagnostics: Stream<RustDiagnostic>
}

enum RustcEvent {
  RMeta(Blob)
  RLib(Blob)
  Diagnostic(RustDiagnostic)
  Finished(ExitStatus)
}

struct RustDiagnostic {
  level: String
  message: String
  rendered: String
  spans: List<DiagnosticSpan>
}

struct DiagnosticSpan {
  file_name: String
  line_start: Int
  line_end: Int
  column_start: Int
  column_end: Int
  text: String
}

// --- Lockfile ---

struct CargoLock {
  packages: List<LockedPackage>
}

struct LockedPackage {
  name: String
  version: String
  source: String
  checksum: String
}
