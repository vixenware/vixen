```styx
id @vixen/grammar-cc
version 0.1.0
```

// The cc/clang grammar, authored in Vixen against @vixen/command-grammar.
//
// Note the five orthogonal axes per flag: spelling (how it's written), policy
// (how repeats collapse), kind (universal cache/IO class — Text/Input/Output/
// InOut), role (open domain tag the engine never interprets), value (value
// space for completion). `kind` stays domain-agnostic; `role` carries the C
// meaning — and doubles as the translation key (cc `-I` and cl `/I` both
// role "include").

let { Grammar, Flag, Spelling, Policy, Kind, ValueDomain, Positional, EnvDecl, Arity } =
  import "vixen:command-grammar"

let ld = Grammar {
  name: "ld",
  flags: [
    Flag { canonical: "--gc-sections", spelling: Spelling.Bare, policy: Policy.Once,
           role: "gc-sections", doc: "remove unused sections" },
    Flag { canonical: "--as-needed", spelling: Spelling.Bare, policy: Policy.Once,
           role: "as-needed", doc: "only link libraries that resolve a symbol" },
    Flag { canonical: "--version-script", spelling: Spelling.Suffixed { sep: "=" },
           policy: Policy.Once, kind: Kind.Input { dir: false },
           role: "version-script", value: ValueDomain.Path { dir: false },
           doc: "restrict exported symbols using a version script" },
  ],
}

let cc = Grammar {
  name: "cc",
  mode_selectors: ["-c"],
  link_only: ["-l", "-shared", "-Wl,"],
  flags: [
    Flag { canonical: "-c", spelling: Spelling.Bare, policy: Policy.Once,
           role: "compile-only", doc: "compile only; do not link" },
    Flag { canonical: "-fPIC", spelling: Spelling.Bare, policy: Policy.Once,
           role: "pic", doc: "emit position-independent code" },
    Flag { canonical: "-shared", spelling: Spelling.Bare, policy: Policy.Once,
           role: "shared", doc: "produce a shared library" },
    Flag { canonical: "-O", spelling: Spelling.Attached, policy: Policy.Group { name: "opt" },
           role: "optimization", value: ValueDomain.OneOf { values: ["0", "1", "2", "3", "s"] },
           doc: "optimization level" },
    Flag { canonical: "-std", spelling: Spelling.Suffixed { sep: "=" }, policy: Policy.Once,
           role: "std", value: ValueDomain.OneOf { values: ["c99", "c11", "c17", "c23"] },
           doc: "C language standard" },
    Flag { canonical: "-W", spelling: Spelling.Attached, policy: Policy.DedupUnordered,
           role: "warning", doc: "enable a warning group, e.g. -Wall" },
    Flag { canonical: "-D", spelling: Spelling.Attached, policy: Policy.DefineProgram,
           role: "define", doc: "define a preprocessor macro (NAME or NAME=VALUE)" },
    Flag { canonical: "-I", spelling: Spelling.Separated, policy: Policy.DedupOrdered,
           kind: Kind.Input { dir: true }, role: "include", value: ValueDomain.Path { dir: true },
           doc: "add a header search directory (search order is significant)" },
    Flag { canonical: "-L", spelling: Spelling.Separated, policy: Policy.DedupOrdered,
           kind: Kind.Input { dir: true }, role: "lib-dir", value: ValueDomain.Path { dir: true },
           doc: "add a library search directory" },
    Flag { canonical: "-l", spelling: Spelling.Attached, policy: Policy.OrderedKeepAll,
           role: "lib", value: ValueDomain.LibName,
           doc: "link against a library (order and repeats are significant)" },
    Flag { canonical: "-Wl,", spelling: Spelling.Passthrough { sep: ",", grammar: "ld" },
           policy: Policy.OrderedKeepAll, role: "linker-args",
           doc: "pass comma-separated options through to the linker" },
    Flag { canonical: "-o", spelling: Spelling.Separated, policy: Policy.Once,
           kind: Kind.Output { dir: false }, role: "output", value: ValueDomain.Path { dir: false },
           doc: "write output to this file" },
  ],
  env: [
    EnvDecl { name: "CPATH", kind: Kind.Input { dir: true }, role: "include",
              doc: "additional header search directories" },
    EnvDecl { name: "LIBRARY_PATH", kind: Kind.Input { dir: true }, role: "lib-dir",
              doc: "additional library search directories" },
    EnvDecl { name: "SOURCE_DATE_EPOCH", kind: Kind.Text, role: "source-date",
              doc: "fixed timestamp for reproducible builds" },
  ],
  positionals: [
    Positional { name: "input", kind: Kind.Input { dir: false }, role: "source",
                 arity: Arity.Variadic, doc: "a source (.c) or object (.o) file to compile or link" },
  ],
}
