```styx
id @vixen/command-grammar
version 0.1.0
```

// Types for describing a CLI tool's argument grammar, authored in Vixen.
//
// The `command-model` engine lowers a `Grammar` value (constructed with these
// types) into its in-memory form, then parses, canonicalizes, lints, completes,
// explains, and translates commands against it. Grammars ship as packages; a
// grammar references a sub-grammar (e.g. the linker behind `-Wl,`) *by name*,
// because Vixen forbids recursive types — and by-name resolution is what we want
// for cross-package references anyway.
//
// Still to add (the computational layer): richer guards (constraint predicates
// over accumulated parse state, beyond the per-flag `modes` cut) and reducers
// (the `-W` set/unset/promote/demote algebra, alias collapse). Those reuse the
// constraint-expression algebra; this file is the declarative core.

// How a flag and its value are written on the command line.
enum Spelling {
  struct Bare,                                          // -c, -fPIC
  struct Attached,                                      // -O2, -DFOO, -lm; MSVC /Foout.obj
  struct Separated,                                     // -o out, -I dir
  struct Suffixed { sep: String },                      // -std=c99, /std:c++20
  struct Passthrough { sep: String, grammar: String },  // -Wl,a,b -> sub-grammar (by name)
}

// How repeated occurrences of a flag collapse during canonicalization.
enum Policy {
  struct Once,                                  // last wins; >1 distinct value lints
  struct Group { name: String },                // mutually-exclusive set; last wins
  struct DedupOrdered,                          // -I: dedup, but order is semantic
  struct DedupUnordered,                        // -W: sort + dedup
  struct OrderedKeepAll,                        // -l: order semantic, repeats kept
  struct KeyedLastWins,                         // key or key=value: dedup by key, last wins (e.g. defines)
  struct Positional,
}

// The verb a flag performs on its conceptual knob. Translation matches on
// (role, operation): role is the noun, operation the verb — so an "add to the
// include path" can never be mapped onto a "remove from the include path".
enum Operation {
  struct Set,        // assign / replace a value: -O2, -o out
  struct Add,        // add to a collection: -I dir, -DFOO, -lfoo
  struct Remove,     // remove from a collection: -UFOO
  struct Enable,     // turn a knob on: -Wfoo, -frtti, -c
  struct Disable,    // turn a knob off: -Wno-foo, -fno-rtti
}

// How the engine treats a value for mounting and caching — the *universal*,
// domain-agnostic classification. Small and stable: it never grows with new
// tools. What the value *means* to the tool (header dir, library, define, …) is
// the open `role` string the grammar supplies, which the engine never
// interprets — that's where domain knowledge lives, not here.
enum Kind {
  struct Text,                                  // literal; hashed as text, never mounted
  struct Input { dir: Bool },                   // input file/dir; mounted read-only + hashed
  struct Output { dir: Bool },                  // the writable output target; not an input hash
  struct InOut,                                 // read and rewritten in place (e.g. an ar archive)
}

// The value space of a flag — for completion and validation.
enum ValueDomain {
  struct Any,
  struct OneOf { values: Array[String] },       // a fixed set, e.g. -std, -O level
  struct Path { dir: Bool },
  struct Named { domain: String },              // an open named value space, e.g. "lib", "triple"
}

enum Arity {
  struct One,
  struct Optional,
  struct Variadic,                              // greedily takes the rest
}

// A positional-argument slot: what a positional at this point *means*.
struct Positional {
  name: String,
  kind: Kind,                                   // universal cache/IO class
  role: String = "",                            // open domain tag, e.g. "source", "archive"
  arity: Arity,
  doc: String = "",
}

// An environment channel the tool reads — explicit, never ambient. It carries a
// (role, operation) semantic just like a flag, so translation can move a meaning
// between flag and env (cc's -L becomes MSVC's LIB).
struct EnvDecl {
  name: String,
  kind: Kind,
  role: String = "",
  operation: Operation = Operation.Set,
  doc: String = "",
}

struct Flag {
  canonical: String,
  aliases: Array[String] = [],
  spelling: Spelling,
  policy: Policy,
  kind: Kind = Kind.Text,                       // cache/IO class of the value (Text if none)
  role: String = "",                            // open domain tag: "include", "lib", "define", …
  operation: Operation = Operation.Set,         // the verb; (role, operation, mode) is the translation key
  modes: Array[String] = [],                    // mode names this flag is legal in; empty = all
  value: ValueDomain = ValueDomain.Any,
  doc: String = "",
}

// A mode a command can be in. The default mode has an empty selector; a
// non-default mode is entered when its selector flag is present. Mode names are
// the grammar's own vocabulary — "link" is just what a C grammar calls its
// default mode; the model knows nothing domain-specific.
struct Mode {
  name: String,
  selector: String = "",                        // empty = the default mode
}

// A cache-compatibility rule: how a flag's value collapses when deriving the
// content-addressed cache identity (the Tier-1, closed-vocabulary equivalence
// layer). Plain canonicalization is unaffected; only the effective-command
// identity normalizes, so commands that differ only in tool-equivalent ways
// share one cache key.
struct Compat {
  flag: String,                                  // canonical lead this applies to
  ignored: Bool = false,                         // never affects the cache identity (e.g. -Ccodegen-units)
  classes: Array[Array[String]] = [],            // value equivalence classes -> the first element
  default_value: String = "",                    // post-class value == this -> dropped (= absent); "" = none
}

// A complete tool grammar.
struct Grammar {
  name: String,
  flags: Array[Flag],
  env: Array[EnvDecl] = [],
  positionals: Array[Positional] = [],
  modes: Array[Mode] = [],                       // empty = a single unnamed mode
  compat: Array[Compat] = [],                    // cache-identity equivalence rules
}
