set shell := ["bash", "-euo", "pipefail", "-c"]

# List targets
list:
    just --list

# Generate the Xcode project from project.yml.
generate:
    cd xcode && xcodegen generate
    plutil -convert xml1 xcode/VixenFS/VixenFS.entitlements
    plutil -convert xml1 xcode/Vixen/Vixen.entitlements
    plutil -lint xcode/VixenFS/VixenFS.entitlements
    plutil -lint xcode/Vixen/Vixen.entitlements

# Build Vixen.app in Release configuration.
build: generate
    cd xcode && xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration Release \
      -sdk macosx \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      -resolvePackageDependencies
    cd xcode && xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration Release \
      -sdk macosx \
      CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION=YES \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      build

# Build the Rust XPC PoC runtime and inject it as the VixenFS extension executable.
inject-rust-vixen-extension:
    cargo build --release -p xpc-poc
    repo_root="$(git rev-parse --show-toplevel)" ; \
    app_bundle_path="$repo_root/apps/mac/xcode/build/DerivedData/Build/Products/Release/Vixen.app" ; \
    extension_bin="$app_bundle_path/Contents/Extensions/VixenFS.appex/Contents/MacOS/VixenFS" ; \
    rust_bin="$repo_root/target/release/xpc-poc" ; \
    extension_entitlements="$repo_root/apps/mac/xcode/VixenFS/VixenFS.entitlements" ; \
    app_entitlements="$repo_root/apps/mac/xcode/Vixen/Vixen.entitlements" ; \
    extension_debug_entitlements="$(mktemp /tmp/vixenfs-extension-entitlements.XXXXXX.plist)" ; \
    app_debug_entitlements="$(mktemp /tmp/vixen-app-entitlements.XXXXXX.plist)" ; \
    cleanup() { rm -f "$extension_debug_entitlements" "$app_debug_entitlements"; } ; \
    trap cleanup EXIT ; \
    if [[ ! -d "$app_bundle_path" ]]; then \
      echo "Expected $app_bundle_path before injection. Run just build first." >&2; \
      exit 1; \
    fi; \
    if [[ ! -x "$rust_bin" ]]; then \
      echo "Expected Rust service binary at $rust_bin" >&2; \
      exit 1; \
    fi; \
    cp "$rust_bin" "$extension_bin"; \
    chmod +x "$extension_bin"; \
    signing_identity="${VXFS_SIGNING_IDENTITY:-$(security find-identity -v -p codesigning | awk -F'\"' '/Apple Development|Developer ID Application/ {print $2; exit}')}" ; \
    if [[ -z "$signing_identity" ]]; then \
      echo "Expected a signing identity for extension re-sign. Set VXFS_SIGNING_IDENTITY or launch with a signed Vixen.app." >&2; \
      exit 1; \
    fi; \
    cp "$extension_entitlements" "$extension_debug_entitlements" ; \
    cp "$app_entitlements" "$app_debug_entitlements" ; \
    /usr/libexec/PlistBuddy -c "Add :com.apple.security.get-task-allow bool true" "$extension_debug_entitlements" ; \
    /usr/libexec/PlistBuddy -c "Add :com.apple.security.get-task-allow bool true" "$app_debug_entitlements" ; \
    codesign --force --options runtime --timestamp --entitlements "$extension_debug_entitlements" --sign "$signing_identity" "$app_bundle_path/Contents/Extensions/VixenFS.appex" ; \
    codesign --force --options runtime --timestamp --entitlements "$app_debug_entitlements" --sign "$signing_identity" "$app_bundle_path" ; \
    codesign --verify --deep --strict "$app_bundle_path" ; \
    echo "Replaced $extension_bin with Rust xpc-poc service binary"

# Install Vixen.app into /Applications and launch once.
install: build
    rm -rf /Applications/Vixen.app
    ditto xcode/build/DerivedData/Build/Products/Release/Vixen.app /Applications/Vixen.app
    open /Applications/Vixen.app
    @echo "Installed /Applications/Vixen.app"
    @echo "Follow the instructions in Vixen.app to finish setup."

# Install with the Rust extension binary (same extension identity, same bundle).
install-rust-fs: build inject-rust-vixen-extension
    rm -rf /Applications/Vixen.app
    ditto xcode/build/DerivedData/Build/Products/Release/Vixen.app /Applications/Vixen.app
    repo_root="$(git rev-parse --show-toplevel)" ; \
    "$repo_root/apps/mac/scripts/verify-fs-extension-signing.sh" /Applications/Vixen.app
    open /Applications/Vixen.app
    @echo "Installed /Applications/Vixen.app with Rust VixenFS runtime"
    @echo "Follow the instructions in Vixen.app to finish setup."

verify-fs-extension-signing app_path='/Applications/Vixen.app':
    repo_root="$(git rev-parse --show-toplevel)" ; \
    "$repo_root/apps/mac/scripts/verify-fs-extension-signing.sh" {{ app_path }}

reload-fs-extension-registration app_path='/Applications/Vixen.app':
    repo_root="$(git rev-parse --show-toplevel)" ; \
    "$repo_root/apps/mac/scripts/reload-vixen-fs-extension.sh" {{ app_path }} ; \
    "$repo_root/apps/mac/scripts/verify-fs-extension-signing.sh" {{ app_path }}

# Build, sign, and package a release DMG for review.

# Optional argument: `just release-build 1.2.3`
release-build version='':
    ./scripts/build.sh {{ version }}

# Notarize, generate appcast, and publish to GitHub.

# Optional argument: `just release-publish 1.2.3`
release-publish version='':
    ./scripts/publish.sh {{ version }}

# Build + publish in one shot (no review step).
release version='':
    ./scripts/build.sh {{ version }}
    ./scripts/publish.sh {{ version }}

# Create GitHub release with DMG and appcast.

# Optional argument: `just github-release 1.2.3`
github-release version='':
    ./scripts/github-release.sh {{ version }}

# Update Homebrew tap with the release DMG SHA256.

# Optional argument: `just update-tap 1.2.3`
update-tap version='':
    ./scripts/update-tap.sh {{ version }}

# Validate release prerequisites without building artifacts.

# Optional argument: `just preflight 1.2.3`
preflight version='':
    ./scripts/preflight.sh {{ version }}
