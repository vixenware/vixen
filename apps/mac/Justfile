set shell := ["bash", "-euo", "pipefail", "-c"]

# List targets
list:
    just --list

# Generate the Xcode project from project.yml.
generate:
    cd xcode && xcodegen generate
    plutil -convert xml1 xcode/VixenFS/VixenFS.entitlements
    plutil -convert xml1 xcode/Vixen/Vixen.entitlements
    plutil -lint xcode/VixenFS/VixenFS.entitlements
    plutil -lint xcode/Vixen/Vixen.entitlements

resolve-packages:
    #!/bin/bash -eux -o pipefail
    cd xcode
    xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration Debug \
      -sdk macosx \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      -resolvePackageDependencies

# Bump the development version in dev-version.txt.
bump-version:
    node scripts/bump-version.js

# Build Vixen.app in Release configuration.

validate-profile profile='Debug':
    #!/bin/bash -eux -o pipefail
    if [[ "{{ profile }}" != "Debug" && "{{ profile }}" != "Release" ]]; then
      echo "Invalid profile: {{ profile }}"
      exit 1
    fi

# Build the Rust static library and cbindgen header for vx-fskit.
build-rust profile='Debug':
    #!/bin/bash -eux -o pipefail
    repo_root="$(cd ../.. && pwd)"
    out_dir="$(pwd)/xcode/build/RustLibs"
    mkdir -p "$out_dir"
    if [[ "{{ profile }}" == "Release" ]]; then
      cargo build --manifest-path "$repo_root/Cargo.toml" --workspace --lib --bin vixen-management --release
      cp "$repo_root/target/release/libvx_fskit.a" "$out_dir/libvx_fskit.a"
      cp "$repo_root/target/release/vixen-management" "$out_dir/vixen-management"
      header_dir="$repo_root/target/release/build"
    else
      cargo build --manifest-path "$repo_root/Cargo.toml" --workspace --lib --bin vixen-management
      cp "$repo_root/target/debug/libvx_fskit.a" "$out_dir/libvx_fskit.a"
      cp "$repo_root/target/debug/vixen-management" "$out_dir/vixen-management"
      header_dir="$repo_root/target/debug/build"
    fi
    generated_header=$(find "$header_dir" -path '*/vx-fskit-*/out/RustFSKitBridge.h' | head -1)
    cp "$generated_header" "$out_dir/RustFSKitBridge.h"

# If version is not specified, reads from dev-version.txt.
build profile='Debug' version='': (build-rust profile) resolve-packages
    #!/bin/bash -eux -o pipefail
    just validate-profile "{{ profile }}"
    if [[ "{{ version }}" == "" ]]; then
      just bump-version
      VERSION=$(cat dev-version.txt)
    else
      VERSION="{{ version }}"
    fi
    echo "Building version ${VERSION}"
    cd xcode
    xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration {{ profile }} \
      -sdk macosx \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      -parallelizeTargets \
      -jobs "$(sysctl -n hw.ncpu)" \
      -onlyUsePackageVersionsFromResolvedFile \
      -skipPackageUpdates \
      CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION=YES \
      MARKETING_VERSION="${VERSION}" \
      CURRENT_PROJECT_VERSION="${VERSION}" \
      build | xcbeautify
    cd ..
    scripts/clean-build-registration.sh "xcode/build/DerivedData/Build/Products/{{ profile }}/Vixen.app" || true

# Build with timing summary (no xcbeautify, raw output).
build-timing profile='Debug' version='': (build-rust profile) resolve-packages
    #!/bin/bash -eux -o pipefail
    just validate-profile "{{ profile }}"
    if [[ "{{ version }}" == "" ]]; then
      just bump-version
      VERSION=$(cat dev-version.txt)
    else
      VERSION="{{ version }}"
    fi
    echo "Building version ${VERSION}"
    cd xcode
    xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration {{ profile }} \
      -sdk macosx \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      -parallelizeTargets \
      -jobs "$(sysctl -n hw.ncpu)" \
      -onlyUsePackageVersionsFromResolvedFile \
      -skipPackageUpdates \
      -showBuildTimingSummary \
      CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION=YES \
      MARKETING_VERSION="${VERSION}" \
      CURRENT_PROJECT_VERSION="${VERSION}" \
      build
    cd ..
    scripts/clean-build-registration.sh "xcode/build/DerivedData/Build/Products/{{ profile }}/Vixen.app" || true

# Install Vixen.app into /Applications and launch once.
install profile='Debug' version='': (build profile version)
    #!/bin/bash -eux -o pipefail
    just validate-profile "{{ profile }}"
    # Quit any running instance first — macOS `open` on an already-running app just
    # re-activates the stale process instead of relaunching the new binary.
    osascript -e 'quit app "Vixen"' 2>/dev/null || true
    killall Vixen 2>/dev/null || true
    # Unmount VixenFS so the freshly-built extension loads on the next mount (FSKit keeps
    # the old extension instances running until the volume is unmounted, then unloads them
    # itself). We own the mountpoint, so this needs no root.
    #
    # NEVER `killall VixenFS`: force-killing a system FSKit extension instance can hang the
    # entire system. `umount` is the only safe way to drop it.
    umount /Volumes/Vixen/vfs 2>/dev/null || true
    # Wait (bounded) for the app to exit before replacing the bundle.
    for _ in $(seq 1 20); do pgrep -x Vixen >/dev/null || break; sleep 0.25; done
    rm -rf /Applications/Vixen.app
    ditto xcode/build/DerivedData/Build/Products/{{ profile }}/Vixen.app /Applications/Vixen.app
    just open {{ profile }}

open profile='Debug':
    #!/bin/bash -eux -o pipefail
    just validate-profile "{{ profile }}"
    open /Applications/Vixen.app/

fix-registration profile='Debug':
    #!/bin/bash
    just validate-profile "{{ profile }}"
    scripts/fix-registration.js /Applications/Vixen.app

# Build, sign, and package a release DMG for review.

# Optional argument: 'just release-build 1.2.3'
release-build version='':
    ./scripts/build.sh {{ version }}

# Notarize, staple, generate appcast. (Vixen ships as a DMG / brew cask — no pkg.)

# Optional argument: 'just release-publish 1.2.3'
release-publish version='':
    ./scripts/publish.sh {{ version }}

# Build + publish in one shot (no review step). DMG-only.
release version='':
    ./scripts/build.sh {{ version }}
    ./scripts/publish.sh {{ version }}

# Generate appcast and upload release artifacts to R2.

# Optional argument: 'just publish-r2 1.2.3'
publish-r2 version='':
    ./scripts/publish-r2.sh {{ version }}

# Validate release prerequisites without building artifacts.

# Optional argument: 'just preflight 1.2.3'
preflight version='':
    ./scripts/preflight.sh {{ version }}
