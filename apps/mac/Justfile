set shell := ["bash", "-euo", "pipefail", "-c"]

# List targets
list:
    just --list

# Generate the Xcode project from project.yml.
generate:
    cd xcode && xcodegen generate
    plutil -convert xml1 xcode/VixenFSExtension/VixenFSExtension.entitlements
    plutil -convert xml1 xcode/Vixen/Vixen.entitlements
    plutil -lint xcode/VixenFSExtension/VixenFSExtension.entitlements
    plutil -lint xcode/Vixen/Vixen.entitlements

# Build Vixen.app in Release configuration.
build: generate
    cd xcode && xcodebuild \
      -project Vixen.xcodeproj \
      -scheme Vixen \
      -configuration Release \
      -sdk macosx \
      -derivedDataPath build/DerivedData \
      -clonedSourcePackagesDirPath build/SourcePackages \
      build

# Install Vixen.app into /Applications and launch once.
install: build
    rm -rf /Applications/Vixen.app
    ditto xcode/build/DerivedData/Build/Products/Release/Vixen.app /Applications/Vixen.app
    open /Applications/Vixen.app
    @echo "Installed /Applications/Vixen.app"
    @echo "Follow the instructions in Vixen.app to finish setup."

# Build, sign, and package a release DMG for review.

# Optional argument: `just release-build 1.2.3`
release-build version='':
    ./scripts/build.sh {{ version }}

# Notarize, generate appcast, and publish to GitHub.

# Optional argument: `just release-publish 1.2.3`
release-publish version='':
    ./scripts/publish.sh {{ version }}

# Build + publish in one shot (no review step).
release version='':
    ./scripts/build.sh {{ version }}
    ./scripts/publish.sh {{ version }}

# Validate release prerequisites without building artifacts.

# Optional argument: `just preflight 1.2.3`
preflight version='':
    ./scripts/preflight.sh {{ version }}
