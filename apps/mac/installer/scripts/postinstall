#!/bin/bash
set -u

label="eu.bearcove.vixen.management"
plist="/Library/LaunchDaemons/${label}.plist"
app_bundle="/Applications/Vixen.app"
app="$app_bundle/Contents/MacOS/Vixen"
helper="$app_bundle/Contents/MacOS/vixen-management"
reopen_marker="/Library/Application Support/Vixen/install/reopen-after-install"
install_log_dir="/Library/Application Support/Vixen/install"
install_log="$install_log_dir/install.log"

timestamp() {
  /bin/date -u "+%Y-%m-%dT%H:%M:%SZ"
}

log() {
  local message="postinstall: $*"
  echo "$message"
  /bin/mkdir -p "$install_log_dir" 2>/dev/null || true
  /bin/printf '%s %s\n' "$(timestamp)" "$message" >>"$install_log" 2>/dev/null || true
}

log_error() {
  local message="postinstall: $*"
  echo "$message" >&2
  /bin/mkdir -p "$install_log_dir" 2>/dev/null || true
  /bin/printf '%s %s\n' "$(timestamp)" "$message" >>"$install_log" 2>/dev/null || true
}

log "started pid=$$ ppid=$PPID app_bundle=$app_bundle label=$label"

if [ ! -x "$app" ]; then
  log_error "missing app executable at $app"
  exit 1
fi

if [ ! -x "$helper" ]; then
  log_error "missing executable helper at $helper"
  exit 1
fi
log "validated installed app executable and helper"

if [ -e "$plist" ]; then
  log "removing old LaunchDaemon plist at $plist"
  /bin/launchctl bootout "system/$label" >/dev/null 2>&1 || true
  /bin/launchctl bootout system "$plist" >/dev/null 2>&1 || true
  /bin/rm -f "$plist" || {
    log_error "failed to remove old $plist"
    exit 1
  }
else
  log "no old LaunchDaemon plist at $plist"
fi

log "ensuring management queues"
"$helper" ensure-queues || {
  log_error "failed to prepare Vixen Management queues"
  exit 1
}
log "management queues ready"

# Boot out any stale launchd job before re-registering. SMAppService.register()
# on an already-enabled service is a no-op to launchd — it won't refresh the
# binary hash. Booting the job out first forces SMAppService to submit a fresh
# job with the current binary, without requiring user re-approval (the BTM
# approval record is separate and survives this).
log "booting out stale launchd job (if any) to force fresh job submission"
/bin/launchctl bootout "system/$label" 2>/dev/null && log "booted out stale job" || log "no stale job to boot out"

log "requesting SMAppService registration through installed app CLI"
"$app" management register || {
  log_error "could not register Vixen Management; the app will prompt for setup"
}

if [ -e "$reopen_marker" ]; then
  log "reopen marker present at $reopen_marker"
  /bin/rm -f "$reopen_marker" || true
  console_uid="$(/usr/bin/stat -f "%u" /dev/console 2>/dev/null || true)"
  console_user="$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)"
  log "console session for reopen uid=${console_uid:-<empty>} user=${console_user:-<empty>}"
  if [ -n "$console_uid" ] && [ -n "$console_user" ] &&
    [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    log "reopening Vixen as console user $console_user"
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" \
      /usr/bin/open "$app_bundle" || {
      log_error "could not reopen Vixen"
    }
  else
    log_error "not reopening Vixen because console session is unavailable"
  fi
else
  log "no reopen marker; leaving Vixen closed"
fi

log "Vixen Management setup requested"
exit 0
