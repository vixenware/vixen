#!/bin/bash
set -u

bundle_id="eu.bearcove.vixen"
app_name="Vixen"
app_path="/Applications/Vixen.app"
reopen_marker="/Library/Application Support/Vixen/install/reopen-after-install"
install_log_dir="/Library/Application Support/Vixen/install"
install_log="$install_log_dir/install.log"

timestamp() {
  /bin/date -u "+%Y-%m-%dT%H:%M:%SZ"
}

log() {
  local message="preinstall: $*"
  echo "$message"
  /bin/mkdir -p "$install_log_dir" 2>/dev/null || true
  /bin/printf '%s %s\n' "$(timestamp)" "$message" >>"$install_log" 2>/dev/null || true
}

log_error() {
  local message="preinstall: $*"
  echo "$message" >&2
  /bin/mkdir -p "$install_log_dir" 2>/dev/null || true
  /bin/printf '%s %s\n' "$(timestamp)" "$message" >>"$install_log" 2>/dev/null || true
}

console_uid="$(/usr/bin/stat -f "%u" /dev/console 2>/dev/null || true)"
console_user="$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)"
log "started pid=$$ ppid=$PPID bundle_id=$bundle_id app_path=$app_path console_uid=${console_uid:-<empty>} console_user=${console_user:-<empty>}"

run_as_console_user() {
  if [ -z "$console_uid" ] || [ -z "$console_user" ]; then
    log_error "cannot run as console user: empty console uid/user"
    return 1
  fi
  if [ "$console_user" = "root" ] || [ "$console_user" = "loginwindow" ]; then
    log_error "cannot run as console user: console_user=$console_user"
    return 1
  fi
  /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" "$@"
}

running_vixen_pids() {
  local output
  if ! output="$(run_as_console_user /usr/bin/env \
    "VIXEN_BUNDLE_ID=$bundle_id" \
    "VIXEN_APP_PATH=$app_path" \
    /usr/bin/osascript -l JavaScript - 2>&1 <<'JXA'
ObjC.import('AppKit');
function env(name) {
  const value = $.NSProcessInfo.processInfo.environment.objectForKey(name);
  return value ? value.js : "";
}
const bundleId = env("VIXEN_BUNDLE_ID");
const appPath = env("VIXEN_APP_PATH");
const seen = new Set();

function stringValue(value) {
  try {
    return value ? ObjC.unwrap(value) : "";
  } catch (_) {
    return "";
  }
}

function emit(app) {
  const pid = Number(app.processIdentifier);
  if (pid > 0 && !seen.has(pid)) {
    seen.add(pid);
    console.log(pid);
  }
}

let apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(bundleId);
for (let i = 0; i < apps.count; i++) {
  emit(apps.objectAtIndex(i));
}

apps = $.NSWorkspace.sharedWorkspace.runningApplications;
for (let i = 0; i < apps.count; i++) {
  const app = apps.objectAtIndex(i);
  const identifier = stringValue(app.bundleIdentifier);
  const url = app.bundleURL;
  const path = url ? stringValue(url.path) : "";
  const name = stringValue(app.localizedName);
  if (identifier === bundleId || path === appPath || name === "Vixen") {
    emit(app);
  }
}
JXA
)"; then
    log_error "running app query failed: $output"
    return 0
  fi
  /usr/bin/awk '/^[0-9]+$/ { print }' <<EOF
$output
EOF
}

is_vixen_running() {
  [ -n "$(running_vixen_pids)" ]
}

wait_for_vixen_to_exit() {
  local attempt
  for attempt in {1..25}; do
    local pids
    pids="$(running_vixen_pids)"
    if [ -z "$pids" ]; then
      log "wait attempt $attempt: Vixen is no longer running"
      return 0
    fi
    log "wait attempt $attempt: Vixen still running pids=$(echo "$pids" | /usr/bin/tr '\n' ' ')"
    /bin/sleep 0.2
  done
  return 1
}

signal_running_vixen() {
  local signal="$1"
  local pid
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    log "sending SIG$signal to pid=$pid"
    /bin/kill "-$signal" "$pid" 2>/dev/null || true
  done <<EOF
$(running_vixen_pids)
EOF
}

request_vixen_quit() {
  log "requesting graceful Vixen termination through NSRunningApplication"
  run_as_console_user /usr/bin/env "VIXEN_BUNDLE_ID=$bundle_id" \
    /usr/bin/osascript -l JavaScript - >/dev/null 2>&1 <<'JXA' || true
ObjC.import('AppKit');
const value = $.NSProcessInfo.processInfo.environment.objectForKey("VIXEN_BUNDLE_ID");
const bundleId = value ? value.js : "";
const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(bundleId);
for (let i = 0; i < apps.count; i++) {
  apps.objectAtIndex(i).terminate();
}
JXA
}

initial_pids="$(running_vixen_pids)"
log "initial running pid query result=$(echo "${initial_pids:-<none>}" | /usr/bin/tr '\n' ' ')"

if [ -z "$initial_pids" ]; then
  log "$app_name is not running"
  /bin/rm -f "$reopen_marker" 2>/dev/null || true
  exit 0
fi

log "asking running $app_name to quit pids=$(echo "$initial_pids" | /usr/bin/tr '\n' ' ')"
/bin/mkdir -p "$(/usr/bin/dirname "$reopen_marker")"
if /usr/bin/touch "$reopen_marker" 2>/dev/null; then
  log "wrote reopen marker $reopen_marker"
else
  log_error "failed to write reopen marker $reopen_marker"
fi
request_vixen_quit
if wait_for_vixen_to_exit; then
  log "$app_name quit"
  exit 0
fi

log_error "$app_name did not quit; sending SIGTERM"
signal_running_vixen TERM
if wait_for_vixen_to_exit; then
  log "$app_name terminated"
  exit 0
fi

log_error "$app_name survived SIGTERM; sending SIGKILL"
signal_running_vixen KILL
if wait_for_vixen_to_exit; then
  log "$app_name killed"
  exit 0
fi

log_error "failed to stop running $app_name"
exit 1
