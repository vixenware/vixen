fn build(workspace: Path, args: Array[String], env: Map[String, String]) {
  let class = executor_class("ssh:toast");
  let findstr =
    discover(class, (host) => host.which("findstr.exe"));

  let output =
    exec([findstr, "/r", "^", @src/lua.c]) where {
      executor: class,
      mounts: %{ @src => Tree(workspace / @zoo/lua-src) },
      observer: (proc, _vfs) => (
        if proc.exit_code != 0 (
          fail `process failed`
        ) else (
          proc.stdout.collect().blob()
        )
      ),
    };

  Tree %{
    @probe.txt => output,
  }
}
