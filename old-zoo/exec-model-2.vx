
// design note: It should be able to skip fields in the keyword arguments that we
// don't actually use, and the CLI should still be able to to evaluate the
// function just without passing things that are not actually being used.
fn build() #discover where { ws: Path, args: Array[String], env: Map[String, String] } -> Tree {
  let src_dir = ws.subtree @src
  let tree = build_c_program src
  tree / @main
}

fn build_c_program(src: Tree) -> Tree {
  let executor = default_executor();

  struct Toolchain {
    cc: String,
    coarse_mounts: Map[Path, Path],
  }

  // toolchain is also a Path
  let toolchain = discover(executor, (os) => {
    // cc is a Path
    let cc = os.which("cc")

    Toolchain {
      cc,
      exemptions: [
        @/etc/ld.so.cache,
        @/lib/x86_64-linux-gnu/libc.so.6,
        @/usr/bin/gcc,
        @/usr/bin/gcc-14,
        @/usr/bin/x86_64-linux-gnu-gcc-14,
        @/usr/lib/gcc/x86_64-linux-gnu/14/crtbeginS.o,
        @/usr/lib/gcc/x86_64-linux-gnu/14/crtendS.o,
        @/usr/lib/locale/en_US.utf8/LC_CTYPE,
        @/usr/lib/locale/en_US.utf8/LC_MESSAGES/SYS_LC_MESSAGES,
        @/usr/lib/x86_64-linux-gnu/Scrt1.o,
        @/usr/lib/x86_64-linux-gnu/crti.o,
        @/usr/lib/x86_64-linux-gnu/crtn.o,
        @/usr/lib/x86_64-linux-gnu/gconv/gconv-modules.cache,
        @/usr/libexec/gcc/x86_64-linux-gnu/14/cc1,
        @/usr/libexec/gcc/x86_64-linux-gnu/14/collect2,
        @/usr/libexec/gcc/x86_64-linux-gnu/14/liblto_plugin.so,
        @/usr/libexec/gcc/x86_64-linux-gnu/14/lto-wrapper,
        @/usr/share/locale/locale.alias,
      ],
    }
  })

  exec [toolchain.cc, @src/main.c, "-o", @out/main] where {
    mounts: %{
      @src => src,
    },
    coarse_mounts: toolchain.coarse_mounts,
  }
}
